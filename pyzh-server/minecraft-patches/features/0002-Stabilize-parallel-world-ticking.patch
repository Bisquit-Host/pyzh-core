-                serverLevel.getChunkSource().fullChunksNonSync.setThread(); // Leaf - thread unsafe chunk map
-                serverLevel.moonrise$getChunkTaskScheduler().chunkHolderManager.chunkHoldersNoSync.setThread(); // Leaf - thread unsafe chunk map
+                final WorldTickTask task = tasks.poll();
+                boolean completed = false;
+                while (!completed) {
+                    try {
+                        task.future().get();
+                        completed = true;
+                    } catch (java.lang.InterruptedException ex) {
+                        interrupted = true;
+                        if (tickFailure == null) {
+                            tickFailure = ex;
+                        } else {
+                            tickFailure.addSuppressed(ex);
+                        }
+                    } catch (java.util.concurrent.ExecutionException ex) {
+                        completed = true;
+                        final Throwable cause = ex.getCause() == null ? ex : ex.getCause();
+                        if (tickFailure == null) {
+                            tickFailure = cause;
+                        } else if (tickFailure != cause) {
+                            tickFailure.addSuppressed(cause);
+                        }
+                    }
+                }
+                task.level().getChunkSource().fullChunksNonSync.setThread(); // Leaf - thread unsafe chunk map
+                task.level().moonrise$getChunkTaskScheduler().chunkHolderManager.chunkHoldersNoSync.setThread(); // Leaf - thread unsafe chunk map
+            }
+            this.isIteratingOverLevels = false; // Paper - Throw exception on world create while being ticked
