From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:43:16 +0300
Subject: [PATCH] Restore vanilla position hashes

Use Paper's coordinate hash unconditionally so redstone neighbor updates and seeded tree decoration retain their original HashSet iteration order. Keep the unused Leaf hasher utility.

diff --git a/net/minecraft/core/Vec3i.java b/net/minecraft/core/Vec3i.java
index cf001d7c4bd85a6c36c3be420ca5a845b366610c..b81a61a7b05e11cbd9fdfa704937abd18d32070e 100644
--- a/net/minecraft/core/Vec3i.java
+++ b/net/minecraft/core/Vec3i.java
@@ -47,7 +47,7 @@ public class Vec3i implements Comparable<Vec3i> {
 
     @Override
     public final int hashCode() { // Paper - Perf: Final for inline
-        return org.dreeam.leaf.util.Vec3iHasher.hash(this.x, this.y, this.z); // Leaf - Optimize Vec3i hashing
+        return (this.getY() + this.getZ() * 31) * 31 + this.getX();
     }
 
     @Override
