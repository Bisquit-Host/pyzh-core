From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:40:49 +0300
Subject: [PATCH] Preserve Paper behavior unless vanilla bug fixes are enabled

Gate five Leaf fixes independently. Use runtime copper sounds so configuration reloads apply, and only copy crafted results when their statistics fix is enabled.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 881ded967d1c470ec21a8db79888df533bfe382f..ed84da80fb85d6b9634ab4d35bb1e398f42df9d7 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -951,7 +951,12 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
             this.getAttribute(Attributes.MAX_HEALTH).setBaseValue(maxHealth);
         });
         // CraftBukkit end
-        this.setHealth(input.getFloatOr("Health", this.getMaxHealth()), true); // Leaf - Fix MC-17876
+        float health = input.getFloatOr("Health", this.getMaxHealth());
+        if (org.dreeam.leaf.config.modules.fixes.MCBugFix.mc17876) {
+            this.setHealth(health, true); // Leaf - Fix MC-17876
+        } else {
+            this.setHealth(health);
+        }
         this.hurtTime = input.getShortOr("HurtTime", (short)0);
         this.deathTime = input.getShortOr("DeathTime", (short)0);
         this.setSharedFlag(Entity.FLAG_FALL_FLYING, input.getBooleanOr("FallFlying", false));
diff --git a/net/minecraft/world/entity/animal/turtle/Turtle.java b/net/minecraft/world/entity/animal/turtle/Turtle.java
index 64d268d84d91579efb61b288bc520385a90009a9..9d9481a60d21525aa85fdce663b6049ee56bc738 100644
--- a/net/minecraft/world/entity/animal/turtle/Turtle.java
+++ b/net/minecraft/world/entity/animal/turtle/Turtle.java
@@ -575,10 +575,10 @@ public class Turtle extends Animal {
                     this.mob.setYRot(this.rotlerp(this.mob.getYRot(), yRotD, 90.0F));
                     this.mob.yBodyRot = this.mob.getYRot();
                     // Leaf start - Fix MC-299642
-                    if (!this.mob.isNoGravity() || this.mob.isInWater()) {
-                    float targetSpeed = (float)(this.getSpeedModifier() * this.mob.getAttributeValue(Attributes.MOVEMENT_SPEED)); // Purpur - Ridables
-                    this.mob.setSpeed(Mth.lerp(0.125F, this.mob.getSpeed(), targetSpeed));
-                    this.mob.setDeltaMovement(this.mob.getDeltaMovement().add(0.0, this.mob.getSpeed() * yd * 0.1, 0.0));
+                    if (!org.dreeam.leaf.config.modules.fixes.MCBugFix.mc299642 || !this.mob.isNoGravity() || this.mob.isInWater()) {
+                        float targetSpeed = (float)(this.getSpeedModifier() * this.mob.getAttributeValue(Attributes.MOVEMENT_SPEED)); // Purpur - Ridables
+                        this.mob.setSpeed(Mth.lerp(0.125F, this.mob.getSpeed(), targetSpeed));
+                        this.mob.setDeltaMovement(this.mob.getDeltaMovement().add(0.0, this.mob.getSpeed() * yd * 0.1, 0.0));
                     } else {
                         this.mob.setSpeed(0.0F);
                     }
diff --git a/net/minecraft/world/entity/monster/zombie/ZombieVillager.java b/net/minecraft/world/entity/monster/zombie/ZombieVillager.java
index 1357d5e06b77d53d7dc79b4cb775e24eae7346b0..ed6de940ecdf8bb6cf0d58f0043eece14bf685ad 100644
--- a/net/minecraft/world/entity/monster/zombie/ZombieVillager.java
+++ b/net/minecraft/world/entity/monster/zombie/ZombieVillager.java
@@ -346,7 +346,7 @@ public class ZombieVillager extends Zombie implements VillagerDataHolder {
                     level.levelEvent(null, LevelEvent.SOUND_ZOMBIE_CONVERTED, this.blockPosition(), 0);
                 }
                 // Leaf start - Fix MC-200418
-                if (villager.isPassenger() && villager.getVehicle() instanceof net.minecraft.world.entity.animal.chicken.Chicken && villager.isBaby()) {
+                if (org.dreeam.leaf.config.modules.fixes.MCBugFix.mc200418 && villager.isPassenger() && villager.getVehicle() instanceof net.minecraft.world.entity.animal.chicken.Chicken && villager.isBaby()) {
                     villager.removeVehicle();
                 }
                 // Leaf end - Fix MC-200418
diff --git a/net/minecraft/world/inventory/ItemCombinerMenu.java b/net/minecraft/world/inventory/ItemCombinerMenu.java
index 8fb0cc1c914ba03730b113acc176305c46a9b29c..bee472a130eb3774c22abc6fb33e91eca6491e1a 100644
--- a/net/minecraft/world/inventory/ItemCombinerMenu.java
+++ b/net/minecraft/world/inventory/ItemCombinerMenu.java
@@ -124,7 +124,7 @@ public abstract class ItemCombinerMenu extends AbstractContainerMenu {
         if (slot != null && slot.hasItem()) {
             ItemStack stack = slot.getItem();
             clicked = stack.copy();
-            ItemStack clickedCopy = clicked.copy(); // Leaf - Fix MC-65198
+            ItemStack crafted = org.dreeam.leaf.config.modules.fixes.MCBugFix.mc65198 ? clicked.copy() : stack; // Leaf - Fix MC-65198
             int inventorySlotStart = this.getInventorySlotStart();
             int useRowSlotEnd = this.getUseRowEnd();
             if (slotIndex == this.getResultSlot()) {
@@ -162,7 +162,7 @@ public abstract class ItemCombinerMenu extends AbstractContainerMenu {
             }
 
             this.activeQuickItem = clicked; // Purpur - Anvil API
-            slot.onTake(player, clickedCopy); // Leaf - Fix MC-65198
+            slot.onTake(player, crafted); // Leaf - Fix MC-65198
             this.activeQuickItem = null; // Purpur - Anvil API
         }
 
diff --git a/net/minecraft/world/inventory/ResultSlot.java b/net/minecraft/world/inventory/ResultSlot.java
index fc0561f9b655759cffa041cf33886d82073d224a..a81541ae3de8fe9fd0dcf4fe1275943405c13fba 100644
--- a/net/minecraft/world/inventory/ResultSlot.java
+++ b/net/minecraft/world/inventory/ResultSlot.java
@@ -62,7 +62,7 @@ public class ResultSlot extends Slot {
     @Override
     protected void checkTakeAchievements(final ItemStack carried) {
         if (this.removeCount > 0) {
-            carried.onCraftedBy(this.player, carried.getCount()); // Leaf - Fix MC-65198
+            carried.onCraftedBy(this.player, org.dreeam.leaf.config.modules.fixes.MCBugFix.mc65198 ? carried.getCount() : this.removeCount); // Leaf - Fix MC-65198
         }
 
         if (this.container instanceof RecipeCraftingHolder recipeCraftingHolder) {
diff --git a/net/minecraft/world/inventory/StonecutterMenu.java b/net/minecraft/world/inventory/StonecutterMenu.java
index 649d31cfa043e81e9fe113aeb19a8e2b2906c13d..dea2c941c5430b280c8a1ec34c34a72280dc65fa 100644
--- a/net/minecraft/world/inventory/StonecutterMenu.java
+++ b/net/minecraft/world/inventory/StonecutterMenu.java
@@ -239,7 +239,7 @@ public class StonecutterMenu extends AbstractContainerMenu {
             ItemStack stack = slot.getItem();
             Item item = stack.getItem();
             clicked = stack.copy();
-            ItemStack clickedCopy = clicked.copy(); // Leaf - Fix MC-65198
+            ItemStack crafted = org.dreeam.leaf.config.modules.fixes.MCBugFix.mc65198 ? clicked.copy() : stack; // Leaf - Fix MC-65198
             if (slotIndex == 1) {
                 item.onCraftedBy(stack, player);
                 if (!this.moveItemStackTo(stack, 2, 38, true)) {
@@ -272,7 +272,7 @@ public class StonecutterMenu extends AbstractContainerMenu {
                 return ItemStack.EMPTY;
             }
 
-            slot.onTake(player, clickedCopy); // Leaf - Fix MC-65198
+            slot.onTake(player, crafted); // Leaf - Fix MC-65198
             if (slotIndex == 1) {
                 player.drop(stack, false, Prediction.PREDICTED);
             }
diff --git a/net/minecraft/world/level/block/Blocks.java b/net/minecraft/world/level/block/Blocks.java
index 61b57b7a9e86905422f7555762320f06057dfa54..e0061f1ed064c742adde5b9054f54918ac4c5a1b 100644
