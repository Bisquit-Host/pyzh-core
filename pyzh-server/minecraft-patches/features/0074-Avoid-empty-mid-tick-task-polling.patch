From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Tue, 17 Nov 2026 09:34:19 +0300
Subject: [PATCH] Avoid empty mid-tick task polling

Cache levels in the map's insertion order on world addition and removal.
Check ticket propagation, both full-status queues, the legacy event loop
and prioritized chunk tasks before polling. Keep the existing world
short circuit, backoffs, time-budget checks and actual polling order.
The concurrent queue presence accessor removes no work; a racing enqueue
can only wait for the next check.

Measured with the inactive-profiler change: six idle pairs improve from
7.654 to 7.427 mspt, -2.98% with a 95% half-width of 1.70 percentage
points. Hopper JFR puts mid-tick processing at 6.7% before and 5.7% after;
the iterator-constructor site previously took 4.66% self time. Focused
tests cover world changes, every work source and concurrent FIFO polling.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
index cba3b800d2b5dd80164c2b5d742b28af112cf109..696609ceca6cd7ac43b867b38b5f0df49aace044 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkHolderManager.java
@@ -1423,6 +1423,12 @@ public final class ChunkHolderManager {
         BLOCK_TICKET_UPDATES.set(before);
     }
 
+    public boolean hasPendingTicketUpdates() {
+        return this.ticketLevelPropagator.hasPendingUpdates()
+            || !this.pendingFullLoadUpdate.isEmpty()
+            || !this.offThreadPendingFullLoadUpdate.isEmpty();
+    }
+
     public boolean processTicketUpdates() {
         if (BLOCK_TICKET_UPDATES.get() == Boolean.TRUE) {
             throw new IllegalStateException("Cannot update ticket level while unloading chunks or updating entity manager");
diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
index 640548d78b87653871dd1f7b0f84574c5e205fe8..f7f0d47915a4fbc4057b8d9d102b9ff20c1c3328 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/scheduling/ChunkTaskScheduler.java
@@ -333,6 +333,12 @@ public final class ChunkTaskScheduler {
         ((ChunkSystemMinecraftServer)this.world.getServer()).moonrise$setChunkSystemCrash(new RuntimeException("Chunk system crash propagated from unrecoverableChunkSystemFailure", reportedException));
     }
 
+    public boolean hasMidTickTasks() {
+        return this.chunkHolderManager.hasPendingTicketUpdates()
+            || this.world.getChunkSource().mainThreadProcessor.hasPendingTasks()
+            || !this.mainThreadExecutor.hasNoScheduledTasks();
+    }
+
     public boolean executeMainThreadTask() {
         TickThread.ensureTickThread("Cannot execute main thread task off-main");
         return this.mainThreadExecutor.executeTask();
