From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:56:57 +0300
Subject: [PATCH] Save stored user lists synchronously

Restore Paper write completion and IOException propagation. This prevents overlapping whitelist, operator and ban file writes or reloads from observing partially written JSON.

diff --git a/net/minecraft/server/players/StoredUserList.java b/net/minecraft/server/players/StoredUserList.java
index c589608f28cb00a35cce7fe48450cd5e38d77e4e..174febed3e10ed50c7ec8b1eb8771a533ce882fb 100644
--- a/net/minecraft/server/players/StoredUserList.java
+++ b/net/minecraft/server/players/StoredUserList.java
@@ -125,23 +125,13 @@ public abstract class StoredUserList<K, V extends StoredUserEntry<K>> {
     }
 
     public void save() throws IOException {
-        Runnable saveTask = () -> {// Leaf - Akarin - Save Json list asynchronously
         this.removeExpired(); // Paper - remove expired values before saving
         JsonArray result = new JsonArray();
         this.map.values().stream().map(entry -> Util.make(new JsonObject(), entry::serialize)).forEach(result::add);
 
-        try { // Leaf - Akarin - Save Json list asynchronously
         try (BufferedWriter writer = Files.newWriter(this.file, StandardCharsets.UTF_8)) {
             GSON.toJson(result, GSON.newJsonWriter(writer));
         }
-
-        // Leaf start - Akarin - Save Json list asynchronously
-        } catch (Exception e) {
-            StoredUserList.LOGGER.warn("Failed to save {} asynchronously", this.file, e);
-        }
-        };
-        io.papermc.paper.util.MCUtil.scheduleAsyncTask(saveTask);
-        // Leaf end - Akarin - Save Json list asynchronously
     }
 
     public void load() throws IOException {
