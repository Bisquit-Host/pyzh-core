Subject: [PATCH] Select nearest entities during spatial traversal


diff --git a/net/minecraft/server/level/NearestEntityQuery.java b/net/minecraft/server/level/NearestEntityQuery.java
new file mode 100644
index 0000000000000000000000000000000000000000..c60334b3c82acc6209d244e1f249d1ff9728a9ce
--- /dev/null
+++ b/net/minecraft/server/level/NearestEntityQuery.java
@@ -0,0 +1,59 @@
+package net.minecraft.server.level;
+
+import java.util.Collections;
+import java.util.function.Predicate;
+import net.minecraft.tags.TagKey;
+import net.minecraft.util.profiling.Profiler;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.ai.targeting.TargetingConditions;
+import net.minecraft.world.phys.AABB;
+import org.jspecify.annotations.Nullable;
+
+// Pyzh - Collect only the nearest result, using the existing spatial traversal and targeting checks.
+final class NearestEntityQuery<T extends LivingEntity> implements Predicate<T> {
+    private final ServerLevel level;
+    private final TargetingConditions conditions;
+    private final @Nullable LivingEntity source;
+    private final double x;
+    private final double y;
+    private final double z;
+    private final @Nullable TagKey<EntityType<?>> tag;
+    private double bestDistance;
+    private @Nullable T nearest;
+
+    private NearestEntityQuery(final ServerLevel level, final TargetingConditions conditions, final @Nullable LivingEntity source,
+                       final double x, final double y, final double z, final @Nullable TagKey<EntityType<?>> tag) {
+        this.level = level;
+        this.conditions = conditions;
+        this.source = source;
+        this.x = x;
+        this.y = y;
+        this.z = z;
+        this.tag = tag;
+        this.bestDistance = tag == null ? -1.0 : Double.MAX_VALUE;
+    }
+
+    static <T extends LivingEntity> @Nullable T find(final ServerLevel level, final Class<? extends T> type,
+                                                    final TargetingConditions conditions, final @Nullable LivingEntity source,
+                                                    final double x, final double y, final double z, final AABB box,
+                                                    final @Nullable TagKey<EntityType<?>> tag) {
+        final NearestEntityQuery<T> query = new NearestEntityQuery<>(level, conditions, source, x, y, z, tag);
+        Profiler.get().incrementCounter("getEntities");
+        level.moonrise$getEntityLookup().getEntities(type, null, box, Collections.emptyList(), query);
+        return query.nearest;
+    }
+
+    @Override
+    public boolean test(final T entity) {
+        // Keep every targeting test in traversal order, including line-of-sight and selector calls.
+        if ((this.tag == null || entity.is(this.tag)) && this.conditions.test(this.level, this.source, entity)) {
+            final double distance = entity.distanceToSqr(this.x, this.y, this.z);
+            if (this.bestDistance == -1.0 || distance < this.bestDistance) {
+                this.bestDistance = distance;
+                this.nearest = entity;
+            }
+        }
+        return false; // The scan never appends to its empty result list.
+    }
+}
