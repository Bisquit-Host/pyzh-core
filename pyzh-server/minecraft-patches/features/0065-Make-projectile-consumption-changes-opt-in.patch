From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:36 +0300
Subject: [PATCH] Make projectile consumption changes opt-in

Restore Paper's default cancellation, crossbow charge and sound ordering.
Keep opt-in consumption state local and preserve charges replaced by callbacks.

diff --git a/net/minecraft/world/item/BowItem.java b/net/minecraft/world/item/BowItem.java
index 2976d01105ae1d68eef98af68b212f801b8b3d7e..6cfe02830d157809991fe2ab823cee9ad25723f9 100644
--- a/net/minecraft/world/item/BowItem.java
+++ b/net/minecraft/world/item/BowItem.java
@@ -41,9 +41,11 @@ public class BowItem extends ProjectileWeaponItem {
                 return false;
             }
 
-            List<ItemStack> firedProjectiles = draw(itemStack, projectile, player, ProjectileDrawingItemConsumption.MAYBE_LATER); // Paper PR - prevent item consumption for cancelled events
+            final boolean fixConsumption = org.dreeam.leaf.config.modules.fixes.ProjectileConsumption.enabled;
+            List<ItemStack> firedProjectiles = draw(itemStack, projectile, player, fixConsumption ? ProjectileDrawingItemConsumption.MAYBE_LATER : ProjectileDrawingItemConsumption.IMMEDIATELY);
             if (level instanceof ServerLevel serverLevel && !firedProjectiles.isEmpty()) {
-                if (!this.shoot(serverLevel, player, player.getUsedItemHand(), itemStack, new UnrealizedDrawResult(firedProjectiles, projectile), pow * 3.0F, (float) serverLevel.purpurConfig.bowProjectileOffset, pow == 1.0F, null, pow)) return false; // Paper - Pass draw strength // Purpur - Projectile offset config // Paper PR - prevent item consumption for cancelled events
+                boolean shot = this.shoot(serverLevel, player, player.getUsedItemHand(), itemStack, new UnrealizedDrawResult(firedProjectiles, projectile), pow * 3.0F, (float) serverLevel.purpurConfig.bowProjectileOffset, pow == 1.0F, null, pow, fixConsumption); // Paper - Pass draw strength // Purpur - Projectile offset config
+                if (fixConsumption && !shot) return false;
             }
 
             level.playSound(
@@ -71,7 +73,8 @@ public class BowItem extends ProjectileWeaponItem {
         final float power,
         final float uncertainty,
         final float angle,
-        final @Nullable LivingEntity targetOverrride
+        final @Nullable LivingEntity targetOverrride,
+        final boolean fixConsumption
     ) {
         projectileEntity.shootFromRotation(shooter, shooter.getXRot(), shooter.getYRot() + angle, 0.0F, power, uncertainty);
     }
diff --git a/net/minecraft/world/item/CrossbowItem.java b/net/minecraft/world/item/CrossbowItem.java
index 08e47e362930407cdef2602a81f252d8319084e4..4463004dfc4554c3e721ba55db61390e73c0d098 100644
--- a/net/minecraft/world/item/CrossbowItem.java
+++ b/net/minecraft/world/item/CrossbowItem.java
@@ -95,7 +95,7 @@ public class CrossbowItem extends ProjectileWeaponItem {
     }
 
     private static boolean tryLoadProjectiles(final LivingEntity shooter, final ItemStack heldItem, final boolean consume) {
-        List<ItemStack> drawn = draw(heldItem, shooter.getProjectile(heldItem), shooter, consume ? ProjectileDrawingItemConsumption.IMMEDIATELY : ProjectileDrawingItemConsumption.NEVER); // Paper PR - prevent item consumption for cancelled events
+        List<ItemStack> drawn = draw(heldItem, shooter.getProjectile(heldItem), shooter, consume);
         // Paper end - Add EntityLoadCrossbowEvent
         if (!drawn.isEmpty()) {
             heldItem.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.ofNonEmpty(drawn));
@@ -118,7 +118,8 @@ public class CrossbowItem extends ProjectileWeaponItem {
         final float power,
         final float uncertainty,
         final float angle,
-        final @Nullable LivingEntity targetOverride
+        final @Nullable LivingEntity targetOverride,
+        final boolean fixConsumption
     ) {
         Vector3f shotVector;
         if (targetOverride != null) {
@@ -135,22 +136,20 @@ public class CrossbowItem extends ProjectileWeaponItem {
         }
 
         projectileEntity.shoot(shotVector.x(), shotVector.y(), shotVector.z(), power, uncertainty);
-        // Paper PR start - moved up to ensure events weren't cancelled
-        /*
-        float soundPitch = getShotPitch(livingEntity.getRandom(), index);
-        livingEntity.level()
-            .playSound(
-                null,
-                livingEntity.getX(),
-                livingEntity.getY(),
-                livingEntity.getZ(),
-                SoundEvents.CROSSBOW_SHOOT,
-                livingEntity.getSoundSource(),
-                1.0F,
-                soundPitch
-            );
-         */
-        // Paper PR end - moved up to ensure events weren't cancelled
+        if (!fixConsumption) {
+            float soundPitch = getShotPitch(livingEntity.getRandom(), index);
+            livingEntity.level()
+                .playSound(
+                    null,
+                    livingEntity.getX(),
+                    livingEntity.getY(),
+                    livingEntity.getZ(),
+                    SoundEvents.CROSSBOW_SHOOT,
+                    livingEntity.getSoundSource(),
+                    1.0F,
+                    soundPitch
+                );
+        }
     }
 
     private static Vector3f getProjectileShotVector(final LivingEntity body, final Vec3 originalVector, final float angle) {
@@ -200,10 +199,11 @@ public class CrossbowItem extends ProjectileWeaponItem {
         final @Nullable LivingEntity targetOverride
     ) {
         if (level instanceof ServerLevel serverLevel) {
-            ChargedProjectiles charged = weapon.get(DataComponents.CHARGED_PROJECTILES); // Paper PR - prevent item consumption for cancelled events
+            final boolean fixConsumption = org.dreeam.leaf.config.modules.fixes.ProjectileConsumption.enabled;
+            ChargedProjectiles charged = fixConsumption ? weapon.get(DataComponents.CHARGED_PROJECTILES) : weapon.set(DataComponents.CHARGED_PROJECTILES, ChargedProjectiles.EMPTY);
             if (charged != null && !charged.isEmpty()) {
-                List<ItemStack> projectiles = charged.itemCopies().toList();
-                if (!this.shoot(serverLevel, shooter, hand, weapon, projectiles, power, uncertainty, shooter instanceof Player, targetOverride, 1.0F)) return; // Paper - Pass draw strength // Paper PR - prevent item consumption for cancelled events
+                boolean shot = this.shoot(serverLevel, shooter, hand, weapon, charged.itemCopies().toList(), power, uncertainty, shooter instanceof Player, targetOverride, 1.0F, fixConsumption); // Paper - Pass draw strength
+                if (fixConsumption && !shot) return;
                 if (shooter instanceof ServerPlayer player) {
                     CriteriaTriggers.SHOT_CROSSBOW.trigger(player, weapon);
                     player.awardStat(Stats.ITEM_USED.get(weapon.getItem()));
diff --git a/net/minecraft/world/item/ProjectileWeaponItem.java b/net/minecraft/world/item/ProjectileWeaponItem.java
index 8619679be2e983c92129e8121d9628c89b3aa03d..eac1d6ff0115e29c8be4968faa234975c8f6e934 100644
--- a/net/minecraft/world/item/ProjectileWeaponItem.java
+++ b/net/minecraft/world/item/ProjectileWeaponItem.java
@@ -12,6 +12,7 @@ import net.minecraft.world.entity.LivingEntity;
 import net.minecraft.world.entity.player.Player;
 import net.minecraft.world.entity.projectile.Projectile;
 import net.minecraft.world.entity.projectile.arrow.AbstractArrow;
+import net.minecraft.world.item.component.ChargedProjectiles;
 import net.minecraft.world.item.enchantment.EnchantmentHelper;
 import net.minecraft.world.level.Level;
 import org.jspecify.annotations.Nullable;
@@ -46,6 +47,10 @@ public abstract class ProjectileWeaponItem extends Item {
         @Nullable ItemStack originalInPlayerInventory
         // Null in case the unrealised draw result is a noop (case of Crossbow)
     ) {
+        public boolean shouldConsumeAmmo() {
+            return !projectiles.isEmpty() && !projectiles.getFirst().has(DataComponents.INTANGIBLE_PROJECTILE);
+        }
+
         public void consumeProjectilesFromPlayerInventory(final int projectStackIndex) {
             if (projectStackIndex != 0 || originalInPlayerInventory == null) return;
             if (projectiles.isEmpty()) return; // Whatever happened here, nothing
@@ -64,24 +69,27 @@ public abstract class ProjectileWeaponItem extends Item {
         final float uncertainty,
         final boolean isCrit,
         final @Nullable LivingEntity targetOverride
-        , final float drawStrength // Paper - Pass draw strength
+        , final float drawStrength, final boolean fixConsumption // Paper - Pass draw strength
     ) {
         // Paper PR start - prevent item consumption for cancelled events
-        return shoot(level, shooter, hand, weapon, new UnrealizedDrawResult(projectiles, null), power, uncertainty, isCrit, targetOverride, drawStrength);
+        return shoot(level, shooter, hand, weapon, new UnrealizedDrawResult(projectiles, null), power, uncertainty, isCrit, targetOverride, drawStrength, fixConsumption);
     }
     protected boolean shoot(
         final ServerLevel level,
         final LivingEntity shooter,
         final InteractionHand hand,
-        ItemStack weapon, // Remove final
+        final ItemStack weapon,
         final UnrealizedDrawResult unrealizedDrawResult,
         final float power,
         final float uncertainty,
         final boolean isCrit,
         final @Nullable LivingEntity targetOverride
-        , final float drawStrength // Paper - Pass draw strength
+        , final float drawStrength, final boolean fixConsumption // Paper - Pass draw strength
     ) {
         List<ItemStack> projectiles = unrealizedDrawResult.projectiles();
+        final boolean consumeAmmo = fixConsumption && unrealizedDrawResult.shouldConsumeAmmo();
+        ChargedProjectiles remainingCharge = fixConsumption ? weapon.get(DataComponents.CHARGED_PROJECTILES) : null;
+        int consumedCharges = 0;
         boolean atLeastOneShootBowEventUncancelled = false;
         // Paper PR end - prevent item consumption for cancelled events
         float maxAngle = EnchantmentHelper.processProjectileSpread(level, weapon, shooter, 0.0F);
@@ -97,15 +105,16 @@ public abstract class ProjectileWeaponItem extends Item {
                 int index = i;
                 // CraftBukkit start
                 Projectile projectileEntity = this.createProjectile(level, shooter, weapon, projectile, isCrit);
-                this.shootProjectile(shooter, projectileEntity, index, power, uncertainty, angle, targetOverride);
+                this.shootProjectile(shooter, projectileEntity, index, power, uncertainty, angle, targetOverride, fixConsumption);
 
                 // Paper PR start - prevent item consumption for cancelled events; call for each shot projectile
-                boolean preConsumption = weapon.is(Items.CROSSBOW) || shooter.level().shouldConsumeArrow;
+                boolean preConsumption = !fixConsumption || weapon.is(Items.CROSSBOW) || consumeAmmo;
                 org.bukkit.event.entity.EntityShootBowEvent event = org.bukkit.craftbukkit.event.CraftEventFactory.callEntityShootBowEvent(shooter, weapon, projectile, projectileEntity, hand, drawStrength, preConsumption);
                 // Paper PR end - prevent item consumption for cancelled events; call for each shot projectile
                 if (event.isCancelled()) {
                     event.getProjectile().remove();
-                    continue; // Paper PR - prevent item consumption for cancelled events; call for each shot projectile
+                    if (fixConsumption) continue;
+                    return false;
                 }
                 atLeastOneShootBowEventUncancelled = true; // Paper PR - prevent item consumption for cancelled events
 
@@ -116,24 +125,26 @@ public abstract class ProjectileWeaponItem extends Item {
                         projectile
                     ).isRemoved()) {
                         // Paper PR start - prevent item consumption for cancelled events
-                        continue; // call for each shot projectile
+                        if (fixConsumption) continue;
+                        return false;
                     }
                 }
-                if (this instanceof CrossbowItem crossbow) {
+                if (fixConsumption && this instanceof CrossbowItem) {
                     // moved up to ensure events uncancelled
-                    float shotPitch = crossbow.getShotPitch(shooter.getRandom(), index);
+                    float shotPitch = CrossbowItem.getShotPitch(shooter.getRandom(), index);
                     shooter.level().playSound(null, shooter.getX(), shooter.getY(), shooter.getZ(), net.minecraft.sounds.SoundEvents.CROSSBOW_SHOOT, shooter.getSoundSource(), 1.0F, shotPitch);
                 }
-                if (!event.shouldConsumeItem() && projectileEntity instanceof final AbstractArrow abstractArrow)
+                if (fixConsumption && !event.shouldConsumeItem() && projectileEntity instanceof final AbstractArrow abstractArrow)
                     abstractArrow.pickup = AbstractArrow.Pickup.CREATIVE_ONLY;
-                if (event.shouldConsumeItem()) {
-                    // Update item reference to explicitly use crossbow on hand, since plugin can change item in inventory during this stage
-                    weapon = shooter.getItemInHand(hand);
+                if (fixConsumption && event.shouldConsumeItem()) {
                     if (weapon.is(Items.CROSSBOW)) {
-                        List<ItemStack> newProjectiles = weapon.get(DataComponents.CHARGED_PROJECTILES).itemCopies().collect(java.util.stream.Collectors.toCollection(ArrayList::new));
-                        newProjectiles.remove(i - (projectiles.size() - newProjectiles.size()));
-                        weapon.set(DataComponents.CHARGED_PROJECTILES, net.minecraft.world.item.component.ChargedProjectiles.ofNonEmpty(newProjectiles));
-                    } else if (level.shouldConsumeArrow) {
+                        if (remainingCharge != null && weapon.get(DataComponents.CHARGED_PROJECTILES) == remainingCharge) {
+                            List<ItemStack> newProjectiles = remainingCharge.itemCopies().collect(java.util.stream.Collectors.toCollection(ArrayList::new));
+                            newProjectiles.remove(i - consumedCharges++);
+                            remainingCharge = ChargedProjectiles.ofNonEmpty(newProjectiles);
+                            weapon.set(DataComponents.CHARGED_PROJECTILES, remainingCharge);
+                        }
+                    } else if (consumeAmmo) {
                         unrealizedDrawResult.consumeProjectilesFromPlayerInventory(i);
                         // Paper PR end - prevent item consumption for cancelled events
                     }
@@ -159,7 +170,8 @@ public abstract class ProjectileWeaponItem extends Item {
         final float power,
         final float uncertainty,
         final float angle,
-        final @Nullable LivingEntity targetOverrride
+        final @Nullable LivingEntity targetOverrride,
+        final boolean fixConsumption
     );
 
     protected Projectile createProjectile(
@@ -180,6 +192,9 @@ public abstract class ProjectileWeaponItem extends Item {
         // Paper PR start - prevent item consumption for cancelled events
         return draw(weapon, projectile, shooter, ProjectileDrawingItemConsumption.IMMEDIATELY);
     }
+    protected static List<ItemStack> draw(final ItemStack weapon, final ItemStack projectile, final LivingEntity shooter, final boolean consume) {
+        return draw(weapon, projectile, shooter, consume ? ProjectileDrawingItemConsumption.IMMEDIATELY : ProjectileDrawingItemConsumption.NEVER);
+    }
     protected enum ProjectileDrawingItemConsumption {
         // Will immediately consume from the passed projectile stack, like vanilla would
         IMMEDIATELY,
@@ -200,7 +215,6 @@ public abstract class ProjectileWeaponItem extends Item {
         List<ItemStack> drawn = new ArrayList<>(numProjectiles);
         ItemStack projectileCopy = projectile.copy();
 
-        shooter.level().shouldConsumeArrow = true; // Paper PR - prevent item consumption for cancelled events
         for (int i = 0; i < numProjectiles; i++) {
             ItemStack drawnStack = useAmmo(weapon, i == 0 ? projectile : projectileCopy, shooter, i > 0, consume); // Paper // Paper PR - prevent item consumption for cancelled events
             if (!drawnStack.isEmpty()) {
@@ -225,13 +239,12 @@ public abstract class ProjectileWeaponItem extends Item {
         }
 
         if (ammoToUse == 0) {
-            if (!forceInfinite) holder.level().shouldConsumeArrow = false; // Paper PR - prevent item consumption for cancelled events
             ItemStack copy = projectile.copyWithCount(1);
             copy.set(DataComponents.INTANGIBLE_PROJECTILE, Unit.INSTANCE);
             return copy;
         }
 
-        ItemStack used =consumption == ProjectileDrawingItemConsumption.MAYBE_LATER ? projectile.copyWithCount(ammoToUse) : projectile.split(ammoToUse); // Paper PR - prevent item consumption for cancelled events
+        ItemStack used = consumption == ProjectileDrawingItemConsumption.MAYBE_LATER ? projectile.copyWithCount(ammoToUse) : projectile.split(ammoToUse); // Paper PR - prevent item consumption for cancelled events
         if (projectile.isEmpty() && holder instanceof Player player) {
             player.getInventory().removeItem(projectile);
         }
