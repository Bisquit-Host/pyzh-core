From: TurboVadim <yolkin.vadim@gmail.com>
Date: Wed, 23 Sep 2026 21:16:06 +0300
Subject: [PATCH] Cache advancement progress for player predicates

Tick-triggered advancements that test other advancements resolved each
one through the advancement manager and the player's progress map, then
recomputed completion from the requirements, on every check.

AdvancementProgress now caches isDone() against its own change count,
bumped by every grant and revoke of its criteria (criteria know their
owning progress) and by requirements updates. The count is per progress
so that grants to other players, which datapacks issue constantly, do
not invalidate every cache. Player predicates look up progress by the
identity of their own Identifier, cached per player until the next
advancement reload, which is the only time a holder's progress object
is replaced. Results are unchanged.

diff --git a/net/minecraft/advancements/AdvancementProgress.java b/net/minecraft/advancements/AdvancementProgress.java
index b6ca9b6303a8201bdbbc7c224998fdad9dff8a4f..c8f6fb16240c3b9c8fdfe6df2cc30885d100ee31 100644
--- a/net/minecraft/advancements/AdvancementProgress.java
+++ b/net/minecraft/advancements/AdvancementProgress.java
@@ -48,9 +48,16 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
     );
     private final Map<String, CriterionProgress> criteria;
     private AdvancementRequirements requirements = AdvancementRequirements.EMPTY;
+    // Pyzh start - Cache advancement completion
+    // Bumped by every grant/revoke of this progress' criteria and by requirements updates, so a cached isDone() is valid
+    // while it is unchanged. Per progress, so other players' grants do not invalidate it.
+    volatile long pyzh$changes;
+    private volatile long doneAtChange = -1L; // change count << 1 | done
+    // Pyzh end - Cache advancement completion
 
     private AdvancementProgress(final Map<String, CriterionProgress> criteria) {
         this.criteria = criteria;
+        this.pyzh$adoptCriteria(); // Pyzh - Cache advancement completion
     }
 
     public AdvancementProgress() {
@@ -66,10 +73,32 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
         }
 
         this.requirements = requirements;
+        // Pyzh start - Cache advancement completion
+        this.pyzh$adoptCriteria();
+        this.pyzh$changes++;
+        // Pyzh end - Cache advancement completion
     }
 
+    // Pyzh start - Cache advancement completion
+    // Criteria report their grants and revokes here, including direct CriterionProgress calls.
+    private void pyzh$adoptCriteria() {
+        for (CriterionProgress progress : this.criteria.values()) {
+            progress.pyzh$owner = this;
+        }
+    }
+    // Pyzh end - Cache advancement completion
+
     public boolean isDone() {
-        return this.requirements.test(this::isCriterionDone);
+        // Pyzh start - Cache advancement completion
+        final long changes = this.pyzh$changes;
+        final long cached = this.doneAtChange;
+        if (cached >>> 1 == changes) {
+            return (cached & 1L) != 0L;
+        }
+        final boolean done = this.requirements.test(this::isCriterionDone);
+        this.doneAtChange = changes << 1 | (done ? 1L : 0L);
+        return done;
+        // Pyzh end - Cache advancement completion
     }
 
     public boolean hasProgress() {
diff --git a/net/minecraft/advancements/CriterionProgress.java b/net/minecraft/advancements/CriterionProgress.java
index a968c8c84bd6b0618d3c5a43e3451a07401658f1..b301871276b72b9761803828598ce091464476f5 100644
--- a/net/minecraft/advancements/CriterionProgress.java
+++ b/net/minecraft/advancements/CriterionProgress.java
@@ -12,6 +12,7 @@ public class CriterionProgress {
         .apply(ByteBufCodecs::optional)
         .map(obtained -> new CriterionProgress((Instant)obtained.orElse(null)), progress -> Optional.ofNullable(progress.obtained));
     private @Nullable Instant obtained;
+    @Nullable AdvancementProgress pyzh$owner; // Pyzh - Cache advancement completion
 
     public CriterionProgress() {
     }
@@ -26,10 +27,22 @@ public class CriterionProgress {
 
     public void grant() {
         this.obtained = Instant.now();
+        // Pyzh start - Cache advancement completion
+        final AdvancementProgress owner = this.pyzh$owner;
+        if (owner != null) {
+            owner.pyzh$changes++;
+        }
+        // Pyzh end - Cache advancement completion
     }
 
     public void revoke() {
         this.obtained = null;
+        // Pyzh start - Cache advancement completion
+        final AdvancementProgress owner = this.pyzh$owner;
+        if (owner != null) {
+            owner.pyzh$changes++;
+        }
+        // Pyzh end - Cache advancement completion
     }
 
     public @Nullable Instant getObtained() {
diff --git a/net/minecraft/advancements/predicates/entity/PlayerPredicate.java b/net/minecraft/advancements/predicates/entity/PlayerPredicate.java
index 670ed3b4d82243da61636a0a6c06b84cc6d990e3..146330284c6fa83f18574d2127b4e6f17342c01a 100644
--- a/net/minecraft/advancements/predicates/entity/PlayerPredicate.java
