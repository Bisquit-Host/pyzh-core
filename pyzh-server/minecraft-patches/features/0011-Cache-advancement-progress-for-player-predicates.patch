From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Wed, 23 Sep 2026 21:16:06 +0300
Subject: [PATCH] Cache advancement progress for player predicates

Tick-triggered advancements that test other advancements resolved each
one through the advancement manager and the player's progress map, then
recomputed completion from the requirements, on every check.

AdvancementProgress now caches isDone() against a global change count
bumped by every criterion grant, revoke and requirements update. Player
predicates look up progress by the identity of their own Identifier,
cached per player until the next advancement reload, which is the only
time a holder's progress object is replaced. Results are unchanged.

diff --git a/net/minecraft/advancements/AdvancementProgress.java b/net/minecraft/advancements/AdvancementProgress.java
index 7defccef093ddfb239107e6fe8fc9693ed2ed016..e1121f04ffb6b7f3a3e07ec6bc3e1f9e2a749348 100644
--- a/net/minecraft/advancements/AdvancementProgress.java
+++ b/net/minecraft/advancements/AdvancementProgress.java
@@ -43,6 +43,11 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
     );
     private final Map<String, CriterionProgress> criteria;
     private AdvancementRequirements requirements = AdvancementRequirements.EMPTY;
+    // Pyzh start - Cache advancement completion
+    // Bumped by every criterion grant/revoke and requirements update, so a cached isDone() is valid while it is unchanged.
+    static final java.util.concurrent.atomic.AtomicLong CHANGES = new java.util.concurrent.atomic.AtomicLong();
+    private volatile long doneAtChange = -1L; // change count << 1 | done
+    // Pyzh end - Cache advancement completion
 
     private AdvancementProgress(final Map<String, CriterionProgress> criteria) {
         this.criteria = criteria;
@@ -61,10 +66,20 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
         }
 
         this.requirements = requirements;
+        CHANGES.incrementAndGet(); // Pyzh - Cache advancement completion
     }
 
     public boolean isDone() {
-        return this.requirements.test(this::isCriterionDone);
+        // Pyzh start - Cache advancement completion
+        final long changes = CHANGES.get();
+        final long cached = this.doneAtChange;
+        if (cached >>> 1 == changes) {
+            return (cached & 1L) != 0L;
+        }
+        final boolean done = this.requirements.test(this::isCriterionDone);
+        this.doneAtChange = changes << 1 | (done ? 1L : 0L);
+        return done;
+        // Pyzh end - Cache advancement completion
     }
 
     public boolean hasProgress() {
diff --git a/net/minecraft/advancements/CriterionProgress.java b/net/minecraft/advancements/CriterionProgress.java
index d49e9dc60c3cea402c606a7523b6de6106d7baba..578f6f8bcf8d0a147f3679212ee0aaf94d2aa48c 100644
--- a/net/minecraft/advancements/CriterionProgress.java
+++ b/net/minecraft/advancements/CriterionProgress.java
@@ -20,10 +20,12 @@ public class CriterionProgress {
 
     public void grant() {
         this.obtained = Instant.now();
+        AdvancementProgress.CHANGES.incrementAndGet(); // Pyzh - Cache advancement completion
     }
 
     public void revoke() {
         this.obtained = null;
+        AdvancementProgress.CHANGES.incrementAndGet(); // Pyzh - Cache advancement completion
     }
 
     public @Nullable Instant getObtained() {
diff --git a/net/minecraft/advancements/predicates/entity/PlayerPredicate.java b/net/minecraft/advancements/predicates/entity/PlayerPredicate.java
