                     }
                 }
diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index 90125eac5a8f659794bbd38b22584f68a27424e1..37ddfc2ee19b15f2a54c859bf630249868b6e62c 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -62,6 +62,8 @@ public class PlayerAdvancements {
     private @Nullable AdvancementHolder lastSelectedTab;
     private boolean isFirstPacket = true;
     private final Codec<PlayerAdvancements.Data> codec;
+    // Pyzh - Keyed by the Identifier instances held by player predicates. Cleared on reload, the only time a holder's progress is replaced.
+    private final it.unimi.dsi.fastutil.objects.Reference2ObjectOpenHashMap<Identifier, AdvancementProgress> progressByPredicateId = new it.unimi.dsi.fastutil.objects.Reference2ObjectOpenHashMap<>();
     private final Map<CriterionTrigger<?>, Map<PlayerAdvancements.TriggerInstanceKey, ? extends CriterionTriggerInstance>> activeTriggers = new it.unimi.dsi.fastutil.objects.Reference2ReferenceOpenHashMap<>(); // Leaf - Replace criterion map with optimized collection
 
     public PlayerAdvancements(
@@ -87,6 +89,7 @@ public class PlayerAdvancements {
     public void reload(final ServerAdvancementManager manager) {
         this.clearTriggers();
         this.progress.clear();
+        this.progressByPredicateId.clear(); // Pyzh - Cache player predicate progress
         this.visible.clear();
         this.rootsToUpdate.clear();
         this.progressChanged.clear();
@@ -321,6 +324,22 @@ public class PlayerAdvancements {
         return progress;
     }
 
+    // Pyzh start - Cache player predicate progress
+    // Same result as getOrStartProgress(manager.get(id)), or null when the advancement does not exist.
+    public @Nullable AdvancementProgress getOrStartProgress(final Identifier id, final ServerAdvancementManager manager) {
+        AdvancementProgress progress = this.progressByPredicateId.get(id);
+        if (progress == null) {
+            final AdvancementHolder advancement = manager.get(id);
+            if (advancement == null) {
+                return null;
+            }
+            progress = this.getOrStartProgress(advancement);
+            this.progressByPredicateId.put(id, progress);
+        }
+        return progress;
+    }
+    // Pyzh end - Cache player predicate progress
+
     private void startProgress(final AdvancementHolder holder, final AdvancementProgress progress) {
         progress.update(holder.value().requirements());
         this.progress.put(holder, progress);
