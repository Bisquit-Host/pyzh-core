-                            localMobCapCalculator.addMob(chunk.getPos(), category);
+                    if (chunks != null) {
+                        final LevelChunk chunk = chunks.fullChunks.get(ChunkPos.pack(pos));
+                        if (chunk != null) {
+                            counter.count(entity, pos, category, chunk);
                         }
-
-                        mobCounts.addTo(category, 1);
