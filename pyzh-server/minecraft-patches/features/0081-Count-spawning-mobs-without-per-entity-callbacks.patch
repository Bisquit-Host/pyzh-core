                 this.updatePerPlayerMobCount();
-                spawnCookie = NaturalSpawner.createState(chunkCount, this.level, this::getFullChunk, null, true);
+                spawnCookie = NaturalSpawner.createStateForChunkSource(chunkCount, this.level, this, null, true);
             }
         } else {
-            spawnCookie = NaturalSpawner.createState(chunkCount, this.level, this::getFullChunk, !this.level.paperConfig().entities.spawning.perPlayerMobSpawns ? new LocalMobCapCalculator(this.chunkMap) : null, false);
+            spawnCookie = NaturalSpawner.createStateForChunkSource(chunkCount, this.level, this, !this.level.paperConfig().entities.spawning.perPlayerMobSpawns ? new LocalMobCapCalculator(this.chunkMap) : null, false);
         }
         // Paper end - Optional per player mob spawns
         return spawnCookie;
@@ -727,16 +727,6 @@ public class ServerChunkCache extends ChunkSource implements ca.spottedleaf.moon
         }
     }
 
