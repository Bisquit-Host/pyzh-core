-        return new NaturalSpawner.SpawnState(spawnableChunkCount, mobCounts, spawnPotential, localMobCapCalculator);
+        return new NaturalSpawner.SpawnState(spawnableChunkCount, counter.mobCounts, counter.spawnPotential, localMobCapCalculator);
+    }
+
+    private static final class SpawnCounter {
+        private final PotentialCalculator spawnPotential = new PotentialCalculator();
+        private final Object2IntOpenHashMap<MobCategory> mobCounts = new Object2IntOpenHashMap<>();
+        private final ServerLevel level;
+        private final LocalMobCapCalculator localMobCapCalculator;
+        private final boolean countMobs;
+
+        private SpawnCounter(final ServerLevel level, final LocalMobCapCalculator localMobCapCalculator, final boolean countMobs) {
+            this.level = level;
+            this.localMobCapCalculator = localMobCapCalculator;
+            this.countMobs = countMobs;
+        }
+
+        private void count(final Entity entity, final BlockPos pos, final MobCategory category, final LevelChunk chunk) {
+            final MobSpawnSettings naturalMobSpawns = this.level.environmentAttributes().getValue(EnvironmentAttributes.NATURAL_MOB_SPAWNS, pos);
+            final MobSpawnSettings.MobSpawnCost cost = naturalMobSpawns.getMobSpawnCost(entity.getType());
+            if (cost != null) {
+                this.spawnPotential.addCharge(entity.blockPosition(), cost.charge());
+            }
+            if (this.localMobCapCalculator != null && entity instanceof Mob) {
+                this.localMobCapCalculator.addMob(chunk.getPos(), category);
+            }
+            this.mobCounts.addTo(category, 1);
+            if (this.countMobs) {
+                ((ServerLevel)chunk.getLevel()).getChunkSource().chunkMap.updatePlayerMobTypeMap(entity);
+            }
+        }
     }
 
