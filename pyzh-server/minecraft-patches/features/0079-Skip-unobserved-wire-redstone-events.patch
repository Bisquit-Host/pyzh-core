From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Tue, 17 Nov 2026 03:46:10 +0300
Subject: [PATCH] Skip unobserved wire redstone events

Check the current BlockRedstoneEvent handler list at the existing default,
experimental and Eigencraft wire event call sites. With no listener, skip
the event and CraftBlock allocations. With listeners, keep the existing
factory call, old and proposed current, returned current and state checks.
Do not cache listener presence or change the signal suppression flags.

Together with position reuse, six interleaved redstone runs measure 2.733 to
2.650 mspt, -3.05% with a 2.95 percentage-point 95% half-width, and 4465.372 to
2335.146 KB allocated per tick, -47.71% with a 0.21-point half-width. The event
guard's gain is not isolated. Exact digests match, including the state CRC.
Focused tests cover absent listeners, modified current, block replacement
in an event and listener removal.

diff --git a/net/minecraft/world/level/block/RedStoneWireBlock.java b/net/minecraft/world/level/block/RedStoneWireBlock.java
index b21a1888778eda80b93790717c1987d7b6160399..7e8f821aa0c5847c7213a7d2cbc9c0b1c638fac6 100644
--- a/net/minecraft/world/level/block/RedStoneWireBlock.java
+++ b/net/minecraft/world/level/block/RedStoneWireBlock.java
@@ -313,7 +313,9 @@ public class RedStoneWireBlock extends Block {
         int newPower = ((DefaultRedstoneWireEvaluator) evaluator).calculateTargetStrength(level, pos);
         if (oldPower != newPower) {
             if (level.getBlockState(pos) == state) {
-                newPower = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, oldPower, newPower).getNewCurrent();
+                if (org.bukkit.event.block.BlockRedstoneEvent.getHandlerList().getRegisteredListeners().length != 0) {
+                    newPower = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, oldPower, newPower).getNewCurrent();
+                }
                 state = state.setValue(POWER, newPower);
                 // [Space Walker] suppress shape updates and emit those manually to
                 // bypass the new neighbor update stack.
diff --git a/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
index 40fedccaf191b583c0653b4c103adbe7fea65516..0845733a9c61ffc46bbd0e95d778022e2228f536 100644
--- a/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/DefaultRedstoneWireEvaluator.java
@@ -22,7 +22,7 @@ public class DefaultRedstoneWireEvaluator extends RedstoneWireEvaluator {
         int targetStrength = this.calculateTargetStrength(level, pos);
         // Paper start - Call BlockRedstoneEvent
         int previousStrength = state.getValue(RedStoneWireBlock.POWER);
-        if (previousStrength != targetStrength && level.getBlockState(pos) == state) {
+        if (previousStrength != targetStrength && level.getBlockState(pos) == state && org.bukkit.event.block.BlockRedstoneEvent.getHandlerList().getRegisteredListeners().length != 0) {
             targetStrength = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, previousStrength, targetStrength).getNewCurrent();
         }
         if (previousStrength != targetStrength) {
diff --git a/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
index 42ea646c4f80a21900202fe029794fa8e972ed74..9f6d743509147917ba13034435a1a1fcb8001c96 100644
--- a/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/ExperimentalRedstoneWireEvaluator.java
@@ -46,7 +46,7 @@ public class ExperimentalRedstoneWireEvaluator extends RedstoneWireEvaluator {
             int newLevel = unpackPower(packed);
             BlockState state = level.getBlockState(pos);
             // Paper start - Call BlockRedstoneEvent
-            if (state.is(this.wireBlock) && !state.getValue(RedStoneWireBlock.POWER).equals(newLevel)) {
+            if (state.is(this.wireBlock) && !state.getValue(RedStoneWireBlock.POWER).equals(newLevel) && org.bukkit.event.block.BlockRedstoneEvent.getHandlerList().getRegisteredListeners().length != 0) {
                 newLevel = org.bukkit.craftbukkit.event.CraftEventFactory.callRedstoneChange(level, pos, state.getValue(RedStoneWireBlock.POWER), newLevel).getNewCurrent();
             }
             // Paper end - Call BlockRedstoneEvent
