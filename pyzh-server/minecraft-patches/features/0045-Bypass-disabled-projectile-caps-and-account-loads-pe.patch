From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:45:06 +0300
Subject: [PATCH] Bypass disabled projectile caps and account loads per world

Delegate unrestricted movement before any chunk lookup. Enforce exact enabled limits and keep tick budgets on the owning world instead of sharing static counters across worlds.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index cf44448179d070df5149fe21718fd6b7bd697c6a..1430205cc2893d4f4cc631da281418086aa05ddc 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1755,6 +1755,22 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
 
     }
 
+    private int projectileChunkLoadsInTick;
+    private int projectileChunkLoadsThisTick;
+
+    public boolean tryReserveProjectileChunkLoad(final int limit) {
+        final int currentTick = MinecraftServer.currentTick;
+        if (this.projectileChunkLoadsInTick != currentTick) {
+            this.projectileChunkLoadsInTick = currentTick;
+            this.projectileChunkLoadsThisTick = 0;
+        }
+        if (this.projectileChunkLoadsThisTick >= limit) {
+            return false;
+        }
+        ++this.projectileChunkLoadsThisTick;
+        return true;
+    }
+
     public void tickNonPassenger(final Entity entity) {
         ca.spottedleaf.moonrise.common.util.TickThread.ensureTickThread("Cannot tick an entity off-main");
         ProfilerFiller profiler = Profiler.get();
diff --git a/net/minecraft/world/entity/projectile/Projectile.java b/net/minecraft/world/entity/projectile/Projectile.java
index 5c02264cac1ebc9fabc7d249a3e0034846910940..aef3306d76df5664f45f8dbf69fd9337ab33309b 100644
--- a/net/minecraft/world/entity/projectile/Projectile.java
+++ b/net/minecraft/world/entity/projectile/Projectile.java
@@ -79,35 +79,29 @@ public abstract class Projectile extends Entity implements TraceableEntity {
     }
 
     // Gale start - Airplane - reduce projectile chunk loading
-    private static int chunksLoadedThisTick = 0;
-    private static int chunksLoadedInTick;
     private int chunksLoadedByProjectile = 0;
 
     @Override
     public void setPos(double x, double y, double z) {
-        int currentTick = net.minecraft.server.MinecraftServer.currentTick;
-
-        if (chunksLoadedInTick != currentTick) {
-            chunksLoadedInTick = currentTick;
-            chunksLoadedThisTick = 0;
+        if (!(this.level() instanceof ServerLevel serverLevel)) {
+            super.setPos(x, y, z);
+            return;
+        }
+        var maxProjectileChunkLoadsConfig = serverLevel.galeConfig().smallOptimizations.maxProjectileChunkLoads;
+        int maxChunkLoadsPerTick = maxProjectileChunkLoadsConfig.perTick;
+        int maxChunkLoadsPerProjectile = maxProjectileChunkLoadsConfig.perProjectile.max;
+        if (maxChunkLoadsPerTick < 0 && maxChunkLoadsPerProjectile < 0) {
+            super.setPos(x, y, z);
+            return;
         }
 
         int previousX = Mth.floor(this.getX()) >> 4, previousZ = Mth.floor(this.getZ()) >> 4;
         int newX = Mth.floor(x) >> 4, newZ = Mth.floor(z) >> 4;
 
         if (previousX != newX || previousZ != newZ) {
-            boolean isLoaded = ((net.minecraft.server.level.ServerChunkCache) this.level().getChunkSource()).getChunkAtIfLoadedImmediately(newX, newZ) != null;
+            boolean isLoaded = serverLevel.getChunkSource().getChunkAtIfLoadedImmediately(newX, newZ) != null;
 
             if (!isLoaded) {
-                var maxProjectileChunkLoadsConfig = this.level().galeConfig().smallOptimizations.maxProjectileChunkLoads;
-                int maxChunkLoadsPerTick = maxProjectileChunkLoadsConfig.perTick;
-
-                if (maxChunkLoadsPerTick >= 0 && chunksLoadedThisTick > maxChunkLoadsPerTick) {
-                    return;
-                }
-
-                int maxChunkLoadsPerProjectile = maxProjectileChunkLoadsConfig.perProjectile.max;
-
                 if (maxChunkLoadsPerProjectile >= 0 && this.chunksLoadedByProjectile >= maxChunkLoadsPerProjectile) {
                     if (maxProjectileChunkLoadsConfig.perProjectile.removeFromWorldAfterReachLimit) {
                         this.discard(org.bukkit.event.entity.EntityRemoveEvent.Cause.DISCARD); // Leaf - Fix Pufferfish and Purpur patches - Purpur
@@ -118,7 +112,10 @@ public abstract class Projectile extends Entity implements TraceableEntity {
                     return;
                 }
 
-                chunksLoadedThisTick++;
+                if (maxChunkLoadsPerTick >= 0 && !serverLevel.tryReserveProjectileChunkLoad(maxChunkLoadsPerTick)) {
+                    return;
+                }
+
                 this.chunksLoadedByProjectile++;
             }
         }
