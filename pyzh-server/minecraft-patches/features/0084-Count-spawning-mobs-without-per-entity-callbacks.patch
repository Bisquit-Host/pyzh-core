+        private SpawnCounter(final LocalMobCapCalculator localMobCapCalculator, final boolean countMobs) {
+            this.localMobCapCalculator = localMobCapCalculator;
+            this.countMobs = countMobs;
+        }
+
+        private void count(final Entity entity, final BlockPos pos, final MobCategory category, final LevelChunk chunk) {
+            final MobSpawnSettings.MobSpawnCost cost = getRoughBiome(pos, chunk).getMobSettings().getMobSpawnCost(entity.getType());
+            if (cost != null) {
+                this.spawnPotential.addCharge(entity.blockPosition(), cost.charge());
+            }
+            if (this.localMobCapCalculator != null && entity instanceof Mob) {
+                this.localMobCapCalculator.addMob(chunk.getPos(), category);
+            }
+            this.mobCounts.addTo(category, 1);
+            if (this.countMobs) {
+                ((ServerLevel)chunk.getLevel()).getChunkSource().chunkMap.updatePlayerMobTypeMap(entity);
+            }
+        }
     }
 
