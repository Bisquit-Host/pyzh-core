From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:44:22 +0300
Subject: [PATCH] Complete structure future sequencing inline

Collect completed structure futures with thenApply instead of dispatching a common-pool task. Preserve input order and failure propagation while retaining the opt-in upstream helper.

diff --git a/net/minecraft/util/Util.java b/net/minecraft/util/Util.java
index 685ba7f2030e080f109a2b3d2351ae23a72faa26..323f3cb04a2b438f2e4ff8991a6ded50a3ca5b3f 100644
--- a/net/minecraft/util/Util.java
+++ b/net/minecraft/util/Util.java
@@ -705,17 +705,13 @@ public class Util {
 
     // Leaf start - Faster sequencing of futures for chunk structure gen
     private static <V> CompletableFuture<List<V>> sequenceFaster(final List<? extends CompletableFuture<V>> futures, final CompletableFuture<Void> all) {
-        return all.thenCompose($ ->
-                CompletableFuture.supplyAsync(() -> {
-                            List<V> list = new java.util.ArrayList<>();
-
-                            for (CompletableFuture<V> future : futures) {
-                                list.add(future.join());
-                            }
-
-                            return list;
-                        }
-                ));
+        return all.thenApply(ignored -> {
+            List<V> list = new java.util.ArrayList<>(futures.size());
+            for (CompletableFuture<V> future : futures) {
+                list.add(future.join());
+            }
+            return list;
+        });
     }
     // Leaf end - Faster sequencing of futures for chunk structure gen
 
