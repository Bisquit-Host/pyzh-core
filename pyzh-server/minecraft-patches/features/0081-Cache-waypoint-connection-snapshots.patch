-    // Paper start - optimize ServerWaypointManager with locator bar disabled
-    // Avoid a gamerule lookup for each player
-    private boolean isLocatorBarEnabledFor(final ServerPlayer player) {
-        return locatorBarEnabled;
-    // Paper end - optimize ServerWaypointManager with locator bar disabled
+    // Pyzh start - Cache waypoint connection snapshots
+    private Connections<WaypointTransmitter> playerConnections(final ServerPlayer player) {
+        Connections<WaypointTransmitter> row = this.rows.get(player);
+        if (row == null) {
+            row = new Connections<>(this.connections.row(player));
+            this.rows.put(player, row);
+        }
+        return row;
+    }
+
+    private void invalidateSnapshots(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        Connections<WaypointTransmitter> row = this.rows.get(player);
+        if (row != null) row.snapshot = null;
+        Connections<ServerPlayer> column = this.columns.get(waypoint);
+        if (column != null) column.snapshot = null;
+    }
+
+    private void putConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
+        if (this.connections.put(player, waypoint, connection) == null) this.invalidateSnapshots(player, waypoint);
+    }
+
+    private WaypointTransmitter.@Nullable Connection removeConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
+        WaypointTransmitter.Connection removed = this.connections.remove(player, waypoint);
+        if (removed != null) {
+            this.invalidateSnapshots(player, waypoint);
+            if (!this.connections.containsRow(player)) this.rows.remove(player);
+        }
+        return removed;
     }
 
     private void createConnection(final ServerPlayer player, final WaypointTransmitter waypoint) {
-        if (player != waypoint) {
-            if (isLocatorBarEnabledFor(player)) {
-                waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(connection -> {
-                    this.connections.put(player, waypoint, connection);
-                    connection.connect();
-                }, () -> {
-                    WaypointTransmitter.Connection connection = this.connections.remove(player, waypoint);
-                    if (connection != null) {
-                        connection.disconnect();
-                    }
-                });
+        if (player != waypoint && this.locatorBarEnabled) {
+            var made = waypoint.makeWaypointConnectionWith(player);
+            if (made.isPresent()) {
+                this.putConnection(player, waypoint, made.get());
+                made.get().connect();
+            } else {
+                WaypointTransmitter.Connection old = this.removeConnection(player, waypoint);
+                if (old != null) old.disconnect();
             }
         }
     }
 
     private void updateConnection(final ServerPlayer player, final WaypointTransmitter waypoint, final WaypointTransmitter.Connection connection) {
-        if (player != waypoint) {
-            if (isLocatorBarEnabledFor(player)) {
-                if (!connection.isBroken()) {
-                    connection.update();
+        if (player != waypoint && this.locatorBarEnabled) {
+            if (!connection.isBroken()) {
+                connection.update();
+            } else {
+                var made = waypoint.makeWaypointConnectionWith(player);
+                if (made.isPresent()) {
+                    made.get().connect();
+                    this.putConnection(player, waypoint, made.get());
                 } else {
-                    waypoint.makeWaypointConnectionWith(player).ifPresentOrElse(newConnection -> {
-                        newConnection.connect();
-                        this.connections.put(player, waypoint, newConnection);
-                    }, () -> {
-                        connection.disconnect();
-                        this.connections.remove(player, waypoint);
-                    });
+                    connection.disconnect();
+                    this.removeConnection(player, waypoint);
                 }
             }
         }
     }
+    // Pyzh end - Cache waypoint connection snapshots
 }
