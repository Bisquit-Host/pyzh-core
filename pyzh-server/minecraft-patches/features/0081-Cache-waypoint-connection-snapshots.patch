     private final Table<ServerPlayer, WaypointTransmitter, WaypointTransmitter.Connection> connections = HashBasedTable.create();
+    // Pyzh start - Cache waypoint connection snapshots
+    private static final class Connections<K> {
+        final Map<K, WaypointTransmitter.Connection> view;
+        private @Nullable ImmutableSet<Entry<K, WaypointTransmitter.Connection>> snapshot;
+
+        Connections(final Map<K, WaypointTransmitter.Connection> view) {
+            this.view = view;
+        }
+
+        // Guava entries keep their live values. Reuse their membership and order until a pair is
+        // added or removed; replacing a connection updates the value seen by existing snapshots.
+        ImmutableSet<Entry<K, WaypointTransmitter.Connection>> entries() {
+            if (this.snapshot == null) this.snapshot = ImmutableSet.copyOf(this.view.entrySet());
+            return this.snapshot;
+        }
+    }
+
+    private final Map<ServerPlayer, Connections<WaypointTransmitter>> rows = new HashMap<>();
+    private final Map<WaypointTransmitter, Connections<ServerPlayer>> columns = new HashMap<>();
+    // Pyzh end - Cache waypoint connection snapshots
