From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:45:06 +0300
Subject: [PATCH] Isolate activation state per world and skip disabled DAB work

Use invocation-local activation boxes so parallel worlds need no global monitor. Allocate and reuse the priority reset set per world only while DAB is enabled, preserving the minimum priority across players.

diff --git a/io/papermc/paper/entity/activation/ActivationRange.java b/io/papermc/paper/entity/activation/ActivationRange.java
index 51259bdac24822e56755647f83c1c00112a3a8ab..1bb7d1297e44728b493d2303cf695aacc0027e82 100644
--- a/io/papermc/paper/entity/activation/ActivationRange.java
+++ b/io/papermc/paper/entity/activation/ActivationRange.java
@@ -93,8 +93,7 @@ public final class ActivationRange {
     }
     // Gale end - variable entity wake-up duration
 
-    @Deprecated // Leaf - optimize entity activation
-    static AABB maxBB = new AABB(0, 0, 0, 0, 0, 0);
+    private static final int ACTIVATION_TYPE_COUNT = ActivationType.values().length;
 
     /**
      * These entities are excluded from Activation range checks.
@@ -134,7 +133,7 @@ public final class ActivationRange {
      *
      * @param world
      */
-    public synchronized static void activateEntities(final Level world) { // Leaf - SparklyPaper - parallel world ticking
+    public static void activateEntities(final Level world) {
         final int miscActivationRange = world.spigotConfig.miscActivationRange;
         final int raiderActivationRange = world.spigotConfig.raiderActivationRange;
         final int animalActivationRange = world.spigotConfig.animalActivationRange;
@@ -165,7 +164,8 @@ public final class ActivationRange {
         final boolean idleTimeoutTickNearbyEntities = world.purpurConfig.idleTimeoutTickNearbyEntities;
         final boolean ignoreSpectatorActivation = world.spigotConfig.ignoreSpectatorActivation;
         final long currentTick = MinecraftServer.currentTick;
-        it.unimi.dsi.fastutil.ints.IntOpenHashSet reset = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
+        final it.unimi.dsi.fastutil.ints.IntOpenHashSet reset = dab ? ((net.minecraft.server.level.ServerLevel) world).resetActivationPrioritySet() : null;
+        final AABB[] activationBoxes = new AABB[ACTIVATION_TYPE_COUNT];
         // Leaf end - optimize entity activation
         for (final Player player : world.players()) {
             player.activatedTick = currentTick; // Leaf - optimize entity activation
@@ -176,23 +176,23 @@ public final class ActivationRange {
             if (!idleTimeoutTickNearbyEntities && player.isAfk()) continue; // Purpur - AFK API // Leaf - optimize entity activation
 
             final int worldHeight = world.getHeight();
-            ActivationRange.maxBB = player.getBoundingBox().inflate(maxRange, worldHeight, maxRange);
-            ActivationType.MISC.boundingBox = player.getBoundingBox().inflate(miscActivationRange, worldHeight, miscActivationRange);
-            ActivationType.RAIDER.boundingBox = player.getBoundingBox().inflate(raiderActivationRange, worldHeight, raiderActivationRange);
-            ActivationType.ANIMAL.boundingBox = player.getBoundingBox().inflate(animalActivationRange, worldHeight, animalActivationRange);
-            ActivationType.MONSTER.boundingBox = player.getBoundingBox().inflate(monsterActivationRange, worldHeight, monsterActivationRange);
-            ActivationType.WATER.boundingBox = player.getBoundingBox().inflate(waterActivationRange, worldHeight, waterActivationRange);
-            ActivationType.FLYING_MONSTER.boundingBox = player.getBoundingBox().inflate(flyingActivationRange, worldHeight, flyingActivationRange);
-            ActivationType.VILLAGER.boundingBox = player.getBoundingBox().inflate(villagerActivationRange, worldHeight, villagerActivationRange);
+            final AABB maxBB = player.getBoundingBox().inflate(maxRange, worldHeight, maxRange);
+            activationBoxes[ActivationType.MISC.ordinal()] = player.getBoundingBox().inflate(miscActivationRange, worldHeight, miscActivationRange);
+            activationBoxes[ActivationType.RAIDER.ordinal()] = player.getBoundingBox().inflate(raiderActivationRange, worldHeight, raiderActivationRange);
+            activationBoxes[ActivationType.ANIMAL.ordinal()] = player.getBoundingBox().inflate(animalActivationRange, worldHeight, animalActivationRange);
+            activationBoxes[ActivationType.MONSTER.ordinal()] = player.getBoundingBox().inflate(monsterActivationRange, worldHeight, monsterActivationRange);
+            activationBoxes[ActivationType.WATER.ordinal()] = player.getBoundingBox().inflate(waterActivationRange, worldHeight, waterActivationRange);
+            activationBoxes[ActivationType.FLYING_MONSTER.ordinal()] = player.getBoundingBox().inflate(flyingActivationRange, worldHeight, flyingActivationRange);
+            activationBoxes[ActivationType.VILLAGER.ordinal()] = player.getBoundingBox().inflate(villagerActivationRange, worldHeight, villagerActivationRange);
 
-            final List<Entity> entities = world.getEntities((Entity) null, ActivationRange.maxBB, e -> true);
-            reset.ensureCapacity(entities.size()); // Leaf - optimize entity activation
+            final List<Entity> entities = world.getEntities((Entity) null, maxBB, e -> true);
+            if (dab) reset.ensureCapacity(entities.size());
             for (final Entity entity : entities) {
                 if (!tickMarkers && entity instanceof Marker) {
                     continue;
                 }
 
-                ActivationRange.activateEntity(entity);
+                ActivationRange.activateEntity(entity, activationBoxes[entity.activationType.ordinal()]);
 
                 // Leaf start - optimize entity activation
                 // Pufferfish start
@@ -209,7 +209,9 @@ public final class ActivationRange {
                     entity.activatedPriority = 1;
                     priority = 1;
                 }
-                entity.activatedPriority = reset.add(entity.getId()) ? priority : Math.min(priority, entity.activatedPriority);
+                if (dab) {
+                    entity.activatedPriority = reset.add(entity.getId()) ? priority : Math.min(priority, entity.activatedPriority);
+                }
                 // Pufferfish end
                 // Leaf end - optimize entity activation
             }
@@ -221,13 +223,13 @@ public final class ActivationRange {
      *
      * @param entity
      */
-    private static void activateEntity(final Entity entity) {
+    private static void activateEntity(final Entity entity, final AABB activationBox) {
         if (MinecraftServer.currentTick > entity.activatedTick) {
             if (entity.defaultActivationState) { // Pufferfish - diff on change
                 entity.activatedTick = MinecraftServer.currentTick;
                 return;
             }
-            if (entity.activationType.boundingBox.intersects(entity.getBoundingBox())) { // Pufferfish - diff on change
+            if (activationBox.intersects(entity.getBoundingBox())) { // Pufferfish - diff on change
                 entity.activatedTick = MinecraftServer.currentTick;
             }
         }
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 8e4a6452780b0339e660ab5858c14014c3268210..1cc9adb1553cb7bb44767ca5e859f3b0f9a653eb 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1305,6 +1305,16 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public final org.dreeam.leaf.world.EntityCollisionCache entityCollisionCache = new org.dreeam.leaf.world.EntityCollisionCache(); // Leaf - cache collision list
     public final org.dreeam.leaf.util.FastBitRadixSort fastBitRadixSort = new org.dreeam.leaf.util.FastBitRadixSort(); // Leaf - fast bit radix sort
     public final org.dreeam.leaf.world.EntityActivation entityActivation = new org.dreeam.leaf.world.EntityActivation(); // Leaf - optimize entity activation
+    private it.unimi.dsi.fastutil.ints.IntOpenHashSet activationPriorityReset;
+
+    public it.unimi.dsi.fastutil.ints.IntOpenHashSet resetActivationPrioritySet() {
+        if (this.activationPriorityReset == null) {
+            this.activationPriorityReset = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
+        }
+        this.activationPriorityReset.clear();
+        return this.activationPriorityReset;
+    }
+
     public void tickChunk(final LevelChunk chunk, final int tickSpeed) {
         final net.minecraft.world.level.levelgen.BitRandomSource simpleRandom = this.simpleRandom; // Paper - optimise random ticking // Leaf - Faster random generator - upcasting
         ChunkPos chunkPos = chunk.getPos();
