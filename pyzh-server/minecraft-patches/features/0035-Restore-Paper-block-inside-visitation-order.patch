From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:43:16 +0300
Subject: [PATCH] Restore Paper block inside visitation order

Use Paper's stationary and directional box iterators. Retain the single-axis sweep fast path and its separate start and sweep bounds.

diff --git a/net/minecraft/world/entity/monster/Ghast.java b/net/minecraft/world/entity/monster/Ghast.java
index ecf39a23514b0fb18a4920aeffc81fb4e84a4ed4..8e431dd037780e66c40bf315e5da58a967443f5a 100644
--- a/net/minecraft/world/entity/monster/Ghast.java
+++ b/net/minecraft/world/entity/monster/Ghast.java
@@ -330,7 +330,7 @@ public class Ghast extends Mob implements Enemy {
             AABB aabb = this.mob.getBoundingBox();
             AABB aabbAtDestination = aabb.move(travel);
             if (this.careful) {
-                for (BlockPos pos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtDestination.inflate(1.0))) { // Leaf - Sakura - optimise check inside blocks
+                for (BlockPos pos : BlockPos.betweenClosed(aabbAtDestination.inflate(1.0))) {
                     if (!this.blockTraversalPossible(this.mob.level(), null, null, pos, false, false)) {
                         return false;
                     }
diff --git a/net/minecraft/world/level/BlockGetter.java b/net/minecraft/world/level/BlockGetter.java
index 4fb03447398608d48618a1b52e1ad1800c51029e..69d24f7423e8a5411503487a98de8692401e25b6 100644
--- a/net/minecraft/world/level/BlockGetter.java
+++ b/net/minecraft/world/level/BlockGetter.java
@@ -209,7 +209,7 @@ public interface BlockGetter extends LevelHeightAccessor {
     static boolean forEachBlockIntersectedBetween(final Vec3 from, final Vec3 to, final AABB aabbAtTarget, final BlockGetter.BlockStepVisitor visitor) {
         Vec3 travel = to.subtract(from);
         if (travel.lengthSqr() < Mth.square(1.0E-5F)) {
-            for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtTarget)) {
+            for (BlockPos blockPos : BlockPos.betweenClosed(aabbAtTarget)) {
                 if (!visitor.visit(blockPos, 0)) {
                     return false;
                 }
@@ -230,7 +230,7 @@ public interface BlockGetter extends LevelHeightAccessor {
             // Leaf end - Sakura - optimise check inside blocks
             LongSet visitedBlocks = new LongOpenHashSet();
 
-            for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtTarget.move(travel.scale(-1.0)))) { // Leaf - Sakura - optimise check inside blocks
+            for (BlockPos blockPos : BlockPos.betweenCornersInDirection(aabbAtTarget.move(travel.scale(-1.0)), travel)) {
                 if (!visitor.visit(blockPos, 0)) {
                     return false;
                 }
@@ -243,7 +243,7 @@ public interface BlockGetter extends LevelHeightAccessor {
                 return false;
             }
 
-            for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtTarget)) { // Leaf - Sakura - optimise check inside blocks
+            for (BlockPos blockPos : BlockPos.betweenCornersInDirection(aabbAtTarget, travel)) {
                 if (visitedBlocks.add(blockPos.asLong()) && !visitor.visit(blockPos, iterations + 1)) {
                     return false;
                 }
@@ -272,7 +272,7 @@ public interface BlockGetter extends LevelHeightAccessor {
         int sweepMaxY = 0;
         int sweepMaxZ = 0;
 
-        for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtStart)) {
+        for (BlockPos blockPos : BlockPos.betweenCornersInDirection(aabbAtStart, deltaMove)) {
             if (!visitor.visit(blockPos, 0)) {
                 return false;
             }
@@ -388,7 +388,7 @@ public interface BlockGetter extends LevelHeightAccessor {
         }
 
         final int finalIteration = iterations + 1;
-        for (BlockPos blockPos : org.dreeam.leaf.util.list.SimpleBlockPosIterator.iterable(aabbAtTarget)) {
+        for (BlockPos blockPos : BlockPos.betweenCornersInDirection(aabbAtTarget, deltaMove)) {
             final boolean inStartBounds = blockPos.getX() >= startMinX
                 && blockPos.getX() <= startMaxX
                 && blockPos.getY() >= startMinY
