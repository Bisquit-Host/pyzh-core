From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:18 +0300
Subject: [PATCH] Preserve Paper distance rounding without FMA

Use float deltas and float products unless FMA is explicitly enabled.
This restores Paper's results at exact distance thresholds.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 2e73f541102d58aa5f501cd8f92b24bf1d3a2321..43168560361b2975ca229f20dd3566b1a59ed57a 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -5872,14 +5872,17 @@ public abstract class Entity
     // Leaf end - Lithium - equipment tracking
 
     // Leaf start - Optimize Entity distanceTo
-    // Inlining and avoid casting
-    // Use Math#sqrt instead of Mojang's Mth#sqrt - only cast once
-    // Added option to enable FMA acceleration
     public final float distanceTo(final Entity entity) {
+        if (!org.dreeam.leaf.util.LeafConstants.ENABLE_FMA) {
+            final float dx = (float)(this.getX() - entity.getX());
+            final float dy = (float)(this.getY() - entity.getY());
+            final float dz = (float)(this.getZ() - entity.getZ());
+            return Mth.sqrt(dx * dx + dy * dy + dz * dz);
+        }
         final double dx = this.getX() - entity.getX();
         final double dy = this.getY() - entity.getY();
         final double dz = this.getZ() - entity.getZ();
-        return (float) Math.sqrt(org.dreeam.leaf.util.LeafConstants.ENABLE_FMA ? Math.fma(dx, dx, Math.fma(dy, dy, dz * dz)) : dx * dx + dy * dy + dz * dz);
+        return (float)Math.sqrt(Math.fma(dx, dx, Math.fma(dy, dy, dz * dz)));
     }
 
     public final double distanceToSqr(final double x, final double y, final double z) {
