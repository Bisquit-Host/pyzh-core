+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java
@@ -594,6 +594,7 @@ public final class ChunkEntitySlices {
             final double boxMaxX = box.maxX;
             final double boxMaxY = box.maxY;
             final double boxMaxZ = box.maxZ;
+            final boolean mirrored = ca.spottedleaf.moonrise.common.util.TickThread.isTickThread(); // Pyzh - Mirror bounding box coordinates for entity scans
 
             for (int section = min; section <= max; ++section) {
                 final BasicEntityList<Entity> list = entitiesBySection[section - minSection];
@@ -613,8 +614,7 @@ public final class ChunkEntitySlices {
                     }
 
                     // Inline AABB#intersects to avoid a method call and use the cached AABB fields.
-                    final AABB entityBB = entity.getBoundingBox();
-                    if (entityBB.maxX <= boxMinX || entityBB.minX >= boxMaxX || entityBB.maxY <= boxMinY || entityBB.minY >= boxMaxY || entityBB.maxZ <= boxMinZ || entityBB.minZ >= boxMaxZ) {
+                    if (entity.pyzh$isOutside(boxMinX, boxMinY, boxMinZ, boxMaxX, boxMaxY, boxMaxZ, mirrored)) { // Pyzh - Mirror bounding box coordinates for entity scans
                         // Leaf end - Optimise getEntities
                         continue;
                     }
@@ -651,6 +651,7 @@ public final class ChunkEntitySlices {
             final double boxMaxX = box.maxX;
             final double boxMaxY = box.maxY;
             final double boxMaxZ = box.maxZ;
+            final boolean mirrored = ca.spottedleaf.moonrise.common.util.TickThread.isTickThread(); // Pyzh - Mirror bounding box coordinates for entity scans
 
             for (int section = min; section <= max; ++section) {
                 final BasicEntityList<Entity> list = entitiesBySection[section - minSection];
@@ -669,8 +670,7 @@ public final class ChunkEntitySlices {
                     }
 
                     // Inline AABB#intersects to avoid a method call and use the cached AABB fields.
-                    final AABB entityBB = entity.getBoundingBox();
-                    if (entityBB.maxX <= boxMinX || entityBB.minX >= boxMaxX || entityBB.maxY <= boxMinY || entityBB.minY >= boxMaxY || entityBB.maxZ <= boxMinZ || entityBB.minZ >= boxMaxZ) {
+                    if (entity.pyzh$isOutside(boxMinX, boxMinY, boxMinZ, boxMaxX, boxMaxY, boxMaxZ, mirrored)) { // Pyzh - Mirror bounding box coordinates for entity scans
                         // Leaf end - Optimise getEntities
                         continue;
                     }
@@ -708,6 +708,7 @@ public final class ChunkEntitySlices {
             final double boxMaxX = box.maxX;
             final double boxMaxY = box.maxY;
             final double boxMaxZ = box.maxZ;
+            final boolean mirrored = ca.spottedleaf.moonrise.common.util.TickThread.isTickThread(); // Pyzh - Mirror bounding box coordinates for entity scans
 
             for (int section = min; section <= max; ++section) {
                 final BasicEntityList<Entity> list = entitiesBySection[section - minSection];
@@ -724,8 +725,7 @@ public final class ChunkEntitySlices {
                         continue;
                     }
 
-                    final AABB entityBB = entity.getBoundingBox();
-                    if (entityBB.maxX <= boxMinX || entityBB.minX >= boxMaxX || entityBB.maxY <= boxMinY || entityBB.minY >= boxMaxY || entityBB.maxZ <= boxMinZ || entityBB.minZ >= boxMaxZ) {
