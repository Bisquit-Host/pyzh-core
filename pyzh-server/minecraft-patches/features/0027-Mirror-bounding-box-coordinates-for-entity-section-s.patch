diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 96fe7d0ee0e4f9189b8fdd922ee6c03e2c6d4008..f7d6ddfa7dae6aa6c06b60d5c394a9916a3daa92 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -286,6 +286,8 @@ public abstract class Entity
     public float yRotO;
     public float xRotO;
     private AABB bb = INITIAL_AABB;
+    // Pyzh - Mirror bounding box coordinates for entity scans; always equal to bb's, see pyzh$isOutside
+    private double pyzh$bbMinX, pyzh$bbMinY, pyzh$bbMinZ, pyzh$bbMaxX, pyzh$bbMaxY, pyzh$bbMaxZ;
     private boolean boundingBoxChanged = false; // Gale - VMP - skip entity move if movement is zero
     public boolean onGround;
     public boolean horizontalCollision;
@@ -5060,10 +5062,32 @@ public abstract class Entity
         len = bb.maxZ - bb.minZ;
         if (len < 0) maxZ = minZ;
         if (len > 64) maxZ = minZ + 64.0;
-        this.bb = new AABB(minX, minY, minZ, maxX, maxY, maxZ);
+        // Pyzh start - Mirror bounding box coordinates for entity scans
+        final AABB box = new AABB(minX, minY, minZ, maxX, maxY, maxZ);
+        this.bb = box;
+        this.pyzh$bbMinX = box.minX;
+        this.pyzh$bbMinY = box.minY;
+        this.pyzh$bbMinZ = box.minZ;
+        this.pyzh$bbMaxX = box.maxX;
+        this.pyzh$bbMaxY = box.maxY;
+        this.pyzh$bbMaxZ = box.maxZ;
+        // Pyzh end - Mirror bounding box coordinates for entity scans
         // CraftBukkit end
     }
 
+    // Pyzh start - Mirror bounding box coordinates for entity scans
+    // Box test for entity section scans: true when this entity's box does not intersect the given one.
+    // Entity scans test every nearby entity; the mirrored coordinates skip loading the separate AABB object.
+    // They are written field by field, so they are only read on tick threads (mirrored = true), where entities move.
+    public final boolean pyzh$isOutside(final double minX, final double minY, final double minZ, final double maxX, final double maxY, final double maxZ, final boolean mirrored) {
+        if (mirrored) {
+            return this.pyzh$bbMaxX <= minX || this.pyzh$bbMinX >= maxX || this.pyzh$bbMaxY <= minY || this.pyzh$bbMinY >= maxY || this.pyzh$bbMaxZ <= minZ || this.pyzh$bbMinZ >= maxZ;
+        }
+        final AABB box = this.bb;
+        return box.maxX <= minX || box.minX >= maxX || box.maxY <= minY || box.minY >= maxY || box.maxZ <= minZ || box.minZ >= maxZ;
+    }
+    // Pyzh end - Mirror bounding box coordinates for entity scans
+
     public final float getEyeHeight(final Pose pose) {
         return this.getDimensions(pose).eyeHeight();
     }
