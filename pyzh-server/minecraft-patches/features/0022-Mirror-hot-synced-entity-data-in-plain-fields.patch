+    // Pyzh start - Mirror hot synced entity data
+    // Plain copies of synced values read every tick, where each synced read is several dependent loads.
+    // Filled once the data is built, then kept equal by SynchedEntityData, which reports every value write.
+    // Subclasses mirror their own accessors and must call super for the rest; their mirror fields must have no initializer.
+    private byte pyzh$sharedFlags;
+    private int pyzh$airSupply;
+    private int pyzh$ticksFrozen;
+    private boolean pyzh$noGravity;
+    private Pose pyzh$pose;
+
+    protected void pyzh$loadSyncedMirrors() {
+        this.pyzh$sharedFlags = this.entityData.get(DATA_SHARED_FLAGS_ID);
+        this.pyzh$airSupply = this.entityData.get(DATA_AIR_SUPPLY_ID);
+        this.pyzh$ticksFrozen = this.entityData.get(DATA_TICKS_FROZEN);
+        this.pyzh$noGravity = this.entityData.get(DATA_NO_GRAVITY);
+        this.pyzh$pose = this.entityData.get(DATA_POSE);
+    }
+
+    @Override
+    public void pyzh$onSyncedValueWritten(final EntityDataAccessor<?> accessor, final Object value) {
+        if (accessor == DATA_SHARED_FLAGS_ID) {
+            this.pyzh$sharedFlags = (Byte) value;
+        } else if (accessor == DATA_AIR_SUPPLY_ID) {
+            this.pyzh$airSupply = (Integer) value;
+        } else if (accessor == DATA_TICKS_FROZEN) {
+            this.pyzh$ticksFrozen = (Integer) value;
+        } else if (accessor == DATA_NO_GRAVITY) {
+            this.pyzh$noGravity = (Boolean) value;
+        } else if (accessor == DATA_POSE) {
+            this.pyzh$pose = (Pose) value;
+        }
+    }
+    // Pyzh end - Mirror hot synced entity data
+
     public void setTicksFrozen(final int ticks) {
         this.entityData.set(DATA_TICKS_FROZEN, ticks);
     }
