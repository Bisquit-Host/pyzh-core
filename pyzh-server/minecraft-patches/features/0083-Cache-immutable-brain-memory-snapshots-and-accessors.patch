diff --git a/net/minecraft/world/entity/ai/memory/MemorySlot.java b/net/minecraft/world/entity/ai/memory/MemorySlot.java
index 0745ef1bf981830909ce2e740f9f183903c36121..713e6179171d571637b4732f4a7a7a739e083570 100644
--- a/net/minecraft/world/entity/ai/memory/MemorySlot.java
+++ b/net/minecraft/world/entity/ai/memory/MemorySlot.java
@@ -1,11 +1,19 @@
 package net.minecraft.world.entity.ai.memory;
 
+import com.mojang.datafixers.kinds.K1;
+import java.util.Optional;
 import net.minecraft.world.entity.ai.Brain;
+import net.minecraft.world.entity.ai.behavior.declarative.MemoryAccessor;
+import net.minecraft.world.entity.ai.behavior.declarative.MemoryCondition;
 import org.jspecify.annotations.Nullable;
 
 public class MemorySlot<T> {
     private static final long NEVER_EXPIRE = Long.MAX_VALUE;
     private @Nullable T value;
+    private @Nullable Optional<T> optionalValue;
+    private @Nullable MemoryAccessor<?, T> presentAccessor;
+    private @Nullable MemoryAccessor<?, T> registeredAccessor;
+    private @Nullable MemoryAccessor<?, T> absentAccessor;
     private long timeToLive;
 
     private MemorySlot(final @Nullable T value, final long timeToLive) {
@@ -28,6 +36,10 @@ public class MemorySlot<T> {
     }
 
     public void set(final T value, final long timeToLive) {
+        if (this.value != value) {
+            this.optionalValue = null;
+            this.clearAccessors();
+        }
         this.value = value;
         this.timeToLive = timeToLive;
         // Leaf start - Lithium - Reduce Brain memories lookup
@@ -43,6 +55,8 @@ public class MemorySlot<T> {
 
     public void clear() {
         this.value = null;
+        this.optionalValue = Optional.empty();
+        this.clearAccessors();
         this.timeToLive = Long.MAX_VALUE;
     }
 
@@ -54,6 +68,35 @@ public class MemorySlot<T> {
         return this.value;
     }
 
+    public Optional<T> optionalValue() {
+        if (this.optionalValue == null) this.optionalValue = Optional.ofNullable(this.value);
+        return this.optionalValue;
+    }
+
+    @SuppressWarnings("unchecked") // Each built-in condition kind fixes F; this slot fixes the brain, memory type and snapshot.
+    public <F extends K1> @Nullable MemoryAccessor<F, T> accessor(final Brain<?> brain, final MemoryCondition<F, T> condition) {
+        return (MemoryAccessor<F, T>) switch (condition.condition()) {
+            case VALUE_PRESENT -> {
+                if (this.presentAccessor == null) this.presentAccessor = condition.createAccessor(brain, this.optionalValue());
+                yield this.presentAccessor;
+            }
+            case REGISTERED -> {
+                if (this.registeredAccessor == null) this.registeredAccessor = condition.createAccessor(brain, this.optionalValue());
+                yield this.registeredAccessor;
+            }
+            case VALUE_ABSENT -> {
+                if (this.absentAccessor == null) this.absentAccessor = condition.createAccessor(brain, this.optionalValue());
+                yield this.absentAccessor;
+            }
+        };
+    }
+
+    private void clearAccessors() {
+        this.presentAccessor = null;
+        this.registeredAccessor = null;
+        this.absentAccessor = null;
+    }
+
     public boolean canExpire() {
         return this.timeToLive != Long.MAX_VALUE;
     }
