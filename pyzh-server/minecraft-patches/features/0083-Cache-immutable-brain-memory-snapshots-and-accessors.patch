+
+    public <F extends K1, U> @Nullable MemoryAccessor<F, U> getMemoryAccessor(final MemoryCondition<F, U> condition) {
+        MemorySlot<U> slot = this.getMemorySlotIfPresent(condition.memory());
+        return slot == null ? null : slot.accessor(this, condition);
     }
 
     public <U> long getTimeUntilExpiry(final MemoryModuleType<U> type) {
