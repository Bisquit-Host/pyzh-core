From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Sun, 27 Sep 2026 16:21:27 +0300
Subject: [PATCH] Skip unchanged shared flag writes

setSwimming and setSharedFlagOnFire run for every entity every tick and
almost never change the flag, yet setSharedFlag always called
SynchedEntityData.set, which loads the data item only to find the value
equal and do nothing (0.9% of the main thread). It now compares against
the mirrored flags and returns when the byte is unchanged; changed
values still go through set() as before.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index f7d6ddfa7dae6aa6c06b60d5c394a9916a3daa92..79a9cbc5d043e3351ad578647dada7d0983140e4 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -4136,11 +4136,13 @@ public abstract class Entity
 
     public void setSharedFlag(final @Entity.Flags int flag, final boolean value) {
         byte currentValue = this.pyzh$sharedFlags; // Pyzh - Mirror hot synced entity data
-        if (value) {
-            this.entityData.set(DATA_SHARED_FLAGS_ID, (byte)(currentValue | 1 << flag));
-        } else {
-            this.entityData.set(DATA_SHARED_FLAGS_ID, (byte)(currentValue & ~(1 << flag)));
+        // Pyzh start - Skip unchanged shared flag writes; set() would find the value equal and do nothing
+        final byte newValue = value ? (byte)(currentValue | 1 << flag) : (byte)(currentValue & ~(1 << flag));
+        if (newValue == currentValue) {
+            return;
         }
+        this.entityData.set(DATA_SHARED_FLAGS_ID, newValue);
+        // Pyzh end - Skip unchanged shared flag writes
     }
 
     public int getMaxAirSupply() {
