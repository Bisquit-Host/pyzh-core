From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Thu, 24 Sep 2026 16:22:59 +0300
Subject: [PATCH] Encode only compared keys for NBT predicates

Selector nbt options and entity nbt predicates saved the whole entity,
players included with inventory and ender chest, only to compare a few
top-level keys. NbtUtils.compareNbt only reads the expected tag's
top-level keys, so the save now goes through a view that encodes just
those keys. Every save method still runs; skipped keys are tracked so
isEmpty and discard behave as before. Trigger matching keeps its shared
full player tag.

diff --git a/net/minecraft/advancements/predicates/NbtPredicate.java b/net/minecraft/advancements/predicates/NbtPredicate.java
index be241db0cb697b19c433821149a30e2ef24eea9c..4ef862db4e521599fb06b1dc4305b7d4ce3839a0 100644
--- a/net/minecraft/advancements/predicates/NbtPredicate.java
+++ b/net/minecraft/advancements/predicates/NbtPredicate.java
@@ -32,12 +32,13 @@ public record NbtPredicate(CompoundTag tag) {
     }
 
     public boolean matches(final Entity entity) {
-        return this.matches(pyzh$predicateTag(entity)); // Pyzh - Share the player NBT across one trigger's predicate checks
+        return this.matches(this.pyzh$predicateTag(entity)); // Pyzh - Share the player NBT across one trigger's predicate checks
     }
 
     // Pyzh start - Share the player NBT across one trigger's predicate checks
-    // Read-only tag for predicates. Inside a trigger's matching loop the player's tag is built once.
-    public static CompoundTag pyzh$predicateTag(final Entity entity) {
+    // Read-only tag for this predicate. Inside a trigger's matching loop the player's full tag is built once;
+    // otherwise only the keys this predicate compares are encoded.
+    public CompoundTag pyzh$predicateTag(final Entity entity) {
         if (entity instanceof net.minecraft.server.level.ServerPlayer player && player.pyzh$criterionTagScope) {
             CompoundTag tag = player.pyzh$criterionTag;
             if (tag == null) {
@@ -45,7 +46,7 @@ public record NbtPredicate(CompoundTag tag) {
             }
             return tag;
         }
-        return getEntityTagToCompare(entity);
+        return pyzh$getEntityTagToCompare(entity, this.tag.keySet()); // Pyzh - Encode only compared keys for NBT predicates
     }
     // Pyzh end - Share the player NBT across one trigger's predicate checks
 
@@ -54,17 +55,25 @@ public record NbtPredicate(CompoundTag tag) {
     }
 
     public static CompoundTag getEntityTagToCompare(final Entity entity) {
+        return pyzh$getEntityTagToCompare(entity, null); // Pyzh - Encode only compared keys for NBT predicates
+    }
+
+    // Pyzh start - Encode only compared keys for NBT predicates
+    // With onlyKeys set, the tag holds just those top-level keys; only use it for NbtUtils.compareNbt against a tag with the same keys.
+    public static CompoundTag pyzh$getEntityTagToCompare(final Entity entity, final java.util.@Nullable Set<String> onlyKeys) {
         try (ProblemReporter.ScopedCollector reporter = new ProblemReporter.ScopedCollector(entity.problemPath(), LOGGER)) {
             TagValueOutput output = TagValueOutput.createWithContext(reporter, entity.registryAccess());
-            entity.saveWithoutId(output);
+            final net.minecraft.world.level.storage.ValueOutput target = onlyKeys == null ? output : output.pyzh$onlyKeys(onlyKeys);
+            entity.saveWithoutId(target);
             if (entity instanceof Player player) {
                 ItemStack selected = player.getInventory().getSelectedItem();
                 if (!selected.isEmpty()) {
-                    output.store("SelectedItem", ItemStack.CODEC, selected);
+                    target.store("SelectedItem", ItemStack.CODEC, selected);
                 }
             }
 
             return output.buildResult();
         }
     }
+    // Pyzh end - Encode only compared keys for NBT predicates
 }
diff --git a/net/minecraft/advancements/predicates/entity/EntityNbtPredicate.java b/net/minecraft/advancements/predicates/entity/EntityNbtPredicate.java
index 44c077e68376dc0b636fe77d2656505907f3801e..91b469d0a943757fa93156d7d2d31d33a6ac224c 100644
--- a/net/minecraft/advancements/predicates/entity/EntityNbtPredicate.java
+++ b/net/minecraft/advancements/predicates/entity/EntityNbtPredicate.java
@@ -12,6 +12,6 @@ public record EntityNbtPredicate(NbtPredicate nbt) implements EntitySubPredicate
 
     @Override
     public boolean matches(final Entity entity, final ServerLevel level, final @Nullable Vec3 position) {
-        return this.nbt.matches(NbtPredicate.pyzh$predicateTag(entity)); // Pyzh - Share the player NBT across one trigger's predicate checks
+        return this.nbt.matches(this.nbt.pyzh$predicateTag(entity)); // Pyzh - Share the player NBT across one trigger's predicate checks
     }
 }
diff --git a/net/minecraft/commands/arguments/selector/options/EntitySelectorOptions.java b/net/minecraft/commands/arguments/selector/options/EntitySelectorOptions.java
index f4ca9a19d2f223311accd96e9215cba263d3d405..aac457453e3a081083e95947c7a40efbdf0160fa 100644
--- a/net/minecraft/commands/arguments/selector/options/EntitySelectorOptions.java
