                         }
 
diff --git a/net/minecraft/world/level/storage/TagValueOutput.java b/net/minecraft/world/level/storage/TagValueOutput.java
index 007bd7addfe854f28fcf53cb638f51b7601b1c92..9bd854a6ffc9c57a8a2435be5e685690d3d7adeb 100644
--- a/net/minecraft/world/level/storage/TagValueOutput.java
+++ b/net/minecraft/world/level/storage/TagValueOutput.java
@@ -170,6 +170,135 @@ public class TagValueOutput implements ValueOutput {
         return this.output;
     }
 
+    // Pyzh start - Encode only compared keys for NBT predicates
+    // A view that writes only top-level keys in onlyKeys into this output and skips encoding everything else.
+    // Used where the result is only read by NbtUtils.compareNbt, which looks up the expected tag's top-level keys.
+    // isEmpty() and discard() still account for skipped keys; nested outputs of skipped keys are real but detached.
+    public ValueOutput pyzh$onlyKeys(final java.util.Set<String> onlyKeys) {
+        return new KeyFiltered(this, onlyKeys);
+    }
+
+    private static final class KeyFiltered implements ValueOutput {
+        private final TagValueOutput delegate;
+        private final java.util.Set<String> onlyKeys;
+        private final java.util.Set<String> skippedKeys = new java.util.HashSet<>();
+
+        private KeyFiltered(final TagValueOutput delegate, final java.util.Set<String> onlyKeys) {
+            this.delegate = delegate;
+            this.onlyKeys = onlyKeys;
+        }
+
+        private boolean skip(final String name) {
+            if (this.onlyKeys.contains(name)) {
+                return false;
+            }
+            this.skippedKeys.add(name);
+            return true;
+        }
+
+        @Override
+        public <T> void store(final String name, final Codec<T> codec, final T value) {
+            if (!this.skip(name)) this.delegate.store(name, codec, value);
+        }
+
+        @Override
+        public <T> void storeNullable(final String name, final Codec<T> codec, final @Nullable T value) {
+            if (value != null) this.store(name, codec, value);
+        }
+
+        @Override
+        public <T> void store(final MapCodec<T> codec, final T value) {
+            this.delegate.store(codec, value);
+        }
+
+        @Override
+        public void putBoolean(final String name, final boolean value) {
+            if (!this.skip(name)) this.delegate.putBoolean(name, value);
+        }
+
+        @Override
+        public void putByte(final String name, final byte value) {
+            if (!this.skip(name)) this.delegate.putByte(name, value);
+        }
+
+        @Override
+        public void putShort(final String name, final short value) {
+            if (!this.skip(name)) this.delegate.putShort(name, value);
+        }
+
+        @Override
+        public void putInt(final String name, final int value) {
+            if (!this.skip(name)) this.delegate.putInt(name, value);
+        }
+
+        @Override
+        public void putLong(final String name, final long value) {
+            if (!this.skip(name)) this.delegate.putLong(name, value);
+        }
+
+        @Override
+        public void putFloat(final String name, final float value) {
+            if (!this.skip(name)) this.delegate.putFloat(name, value);
+        }
+
+        @Override
+        public void putDouble(final String name, final double value) {
+            if (!this.skip(name)) this.delegate.putDouble(name, value);
+        }
+
+        @Override
+        public void putString(final String name, final String value) {
+            if (!this.skip(name)) this.delegate.putString(name, value);
+        }
+
+        @Override
+        public void putIntArray(final String name, final int[] value) {
+            if (!this.skip(name)) this.delegate.putIntArray(name, value);
+        }
+
+        @Override
+        public ValueOutput child(final String name) {
+            if (!this.skip(name)) return this.delegate.child(name);
+            return new TagValueOutput(this.delegate.reporterForChild(name), this.delegate.ops, new CompoundTag());
+        }
+
+        @Override
+        public ValueOutput.ValueOutputList childrenList(final String name) {
+            if (!this.skip(name)) return this.delegate.childrenList(name);
+            return new TagValueOutput.ListWrapper(name, this.delegate.problemReporter, this.delegate.ops, new ListTag());
+        }
+
+        @Override
+        public <T> ValueOutput.TypedOutputList<T> list(final String name, final Codec<T> codec) {
+            if (!this.skip(name)) return this.delegate.list(name, codec);
+            return new ValueOutput.TypedOutputList<>() {
+                private boolean empty = true;
+
+                @Override
+                public void add(final T value) {
+                    this.empty = false;
+                }
+
+                @Override
+                public boolean isEmpty() {
+                    return this.empty;
+                }
+            };
+        }
+
+        @Override
+        public void discard(final String name) {
+            this.skippedKeys.remove(name);
+            this.delegate.discard(name);
+        }
+
+        @Override
+        public boolean isEmpty() {
+            return this.delegate.isEmpty() && this.skippedKeys.isEmpty();
+        }
+    }
+    // Pyzh end - Encode only compared keys for NBT predicates
+
     public record EncodeToFieldFailedProblem(String name, Object value, Error<?> error) implements ProblemReporter.Problem {
         @Override
         public String description() {
