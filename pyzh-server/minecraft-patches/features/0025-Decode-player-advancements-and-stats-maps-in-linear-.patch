From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Sun, 27 Sep 2026 12:11:35 +0300
Subject: [PATCH] Decode player advancements and stats maps in linear time

Loading a player's advancements on login decoded the advancement map
with Codec.unboundedMap, which is quadratic in the number of entries;
with a large datapack this took about 28 ms on the main thread per
login. Player advancements, criterion progress and per-type stats maps
now use HashedUnboundedMapCodec, which decodes to the same results.

diff --git a/net/minecraft/advancements/AdvancementProgress.java b/net/minecraft/advancements/AdvancementProgress.java
index c8f6fb16240c3b9c8fdfe6df2cc30885d100ee31..70bc7d94150bcb4aa73f524f498b60f5a1aaea08 100644
--- a/net/minecraft/advancements/AdvancementProgress.java
+++ b/net/minecraft/advancements/AdvancementProgress.java
@@ -28,7 +28,7 @@ public class AdvancementProgress implements Comparable<AdvancementProgress> {
     private static final DateTimeFormatter OBTAINED_TIME_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss Z", Locale.ROOT);
     private static final Codec<Instant> OBTAINED_TIME_CODEC = ExtraCodecs.temporalCodec(OBTAINED_TIME_FORMAT)
         .xmap(Instant::from, instant -> instant.atZone(ZoneId.systemDefault()));
-    private static final Codec<Map<String, CriterionProgress>> CRITERIA_CODEC = Codec.unboundedMap(Codec.STRING, OBTAINED_TIME_CODEC)
+    private static final Codec<Map<String, CriterionProgress>> CRITERIA_CODEC = ru.turbovadim.pyzh.codec.HashedUnboundedMapCodec.of(Codec.STRING, OBTAINED_TIME_CODEC) // Pyzh - Decode large player maps in linear time
         .xmap(
             map -> Util.mapValues((Map<String, Instant>)map, CriterionProgress::new),
             map -> map.entrySet()
diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index f9e30e68f557056a7dccac98a5f986a0c20c87be..9001a668f18f9b0213b19a4686e7165a4bc9e560 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -401,7 +401,7 @@ public class PlayerAdvancements {
     }
 
     private record Data(Map<Identifier, AdvancementProgress> map) {
-        public static final Codec<PlayerAdvancements.Data> CODEC = Codec.unboundedMap(Identifier.CODEC, AdvancementProgress.CODEC)
+        public static final Codec<PlayerAdvancements.Data> CODEC = ru.turbovadim.pyzh.codec.HashedUnboundedMapCodec.of(Identifier.CODEC, AdvancementProgress.CODEC) // Pyzh - Decode large player maps in linear time
             .xmap(PlayerAdvancements.Data::new, PlayerAdvancements.Data::map);
 
         public void forEach(final BiConsumer<Identifier, AdvancementProgress> consumer) {
diff --git a/net/minecraft/stats/ServerStatsCounter.java b/net/minecraft/stats/ServerStatsCounter.java
index c2baf1ac8b4f3960588c1fdf25540c52f5808c44..d423fd2dcd0326f1361b9c3ae3a8adab25434b49 100644
--- a/net/minecraft/stats/ServerStatsCounter.java
+++ b/net/minecraft/stats/ServerStatsCounter.java
@@ -60,7 +60,7 @@ public class ServerStatsCounter extends StatsCounter {
                 ? DataResult.success((T)stat.getValue())
                 : DataResult.error(() -> "Expected type " + type + ", but got " + stat.getType())
         );
-        return Codec.unboundedMap(statCodec, Codec.INT);
+        return ru.turbovadim.pyzh.codec.HashedUnboundedMapCodec.of(statCodec, Codec.INT); // Pyzh - Decode large player maps in linear time
     }
 
     public ServerStatsCounter(final MinecraftServer server, final Path file) {
