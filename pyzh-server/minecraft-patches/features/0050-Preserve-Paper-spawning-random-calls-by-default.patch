-            long rand = level.random.nextLong();
+            final boolean optimizeRandom = org.dreeam.leaf.config.modules.opt.OptimizeMobSpawning.enabled;
+            long rand = optimizeRandom ? level.random.nextLong() : 0L;
             int bits = 0;
             for (int groupCount = 0; groupCount < 3; groupCount++) {
                 int x = posX;
