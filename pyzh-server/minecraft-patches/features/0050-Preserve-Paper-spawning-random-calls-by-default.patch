-                    while (valuesNeeded > 0) {
-                        // [0, 61] 3 remains
-                        int threeBits = (int) ((rand >>> bits) & 0x7L);
-                        bits += 3;
-                        if (threeBits != 7 && threeBits != 6) {
-                            switch (valuesNeeded) {
-                                case 1 -> rand4 = threeBits;
