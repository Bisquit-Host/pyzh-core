From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:18 +0300
Subject: [PATCH] Initialize entity brain activation priority to one

Keep newly created entities on Paper's brain cadence while DAB is disabled.
Enabled DAB can assign a lower frequency when evaluating the entity.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 79a9cbc5d043e3351ad578647dada7d0983140e4..396bdc0a685499f7e55b1c2153df49954e91dff4 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -395,7 +395,7 @@ public abstract class Entity
     public int totalEntityAge; // Paper - age-like counter for all entities
     private int lastTickTime; // Leaf - Rewrite entity despawn time
     // public boolean activatedPriorityReset = false; // Pufferfish - DAB // Leaf - optimize entity activation
-    public int activatedPriority = org.dreeam.leaf.config.modules.opt.DynamicActivationofBrain.maximumActivationPrio; // Pufferfish - DAB (golf score)
+    public int activatedPriority = 1; // Pufferfish - DAB (golf score)
     public final io.papermc.paper.entity.activation.ActivationType activationType = io.papermc.paper.entity.activation.ActivationType.activationTypeFor(this); // Paper - EAR 2/tracking ranges
     public @Nullable Boolean immuneToFire = null; // Purpur - Fire immune API
     public boolean leaf$isWeakLoaded = false; // Leaf - Rewrite entity despawn time
