From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Tue, 17 Nov 2026 20:27:22 +0300
Subject: [PATCH] Index gate behavior traversal with mutation checks

Index gate lifecycle and trigger traversal. Retain iterator-equivalent
checks for mutable GateBehavior lists. TriggerGate discards shuffle's copy
and keeps its private list in insertion order, so its indexed loop needs
no modification check. Preserve RNG calls, short-circuiting and both
running-status passes.

With slot-owned memory snapshots and accessors, eight interleaved villagers
pairs change allocation from 671.389 to 559.389 KB/t,
-16.68% +/-2.79 points at 95% confidence. Tick time is
1.147 to 1.115 mspt, -2.82% +/-7.80 points.
No digest drift. All 11 selected tests pass, including every trigger gate
policy, ordered lifecycle and RNG checks, and reentrant fail-fast behavior.

diff --git a/net/minecraft/world/entity/ai/behavior/GateBehavior.java b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
index 9975c19eb1bdafc8bbfb304ad244aa1fecc8ce3c..7ce6997de599e16b1d7ec0f99f23e3c85331df91 100644
--- a/net/minecraft/world/entity/ai/behavior/GateBehavior.java
+++ b/net/minecraft/world/entity/ai/behavior/GateBehavior.java
@@ -79,7 +79,8 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
     @Override
     public final void tickOrStop(final ServerLevel level, final E body, final long timestamp) {
         // Paper start - Perf: Remove streams from hot code
-        for (final BehaviorControl<? super E> behavior : this.behaviors) {
+        for (int index = 0, version = this.behaviors.modificationCount(); index < this.behaviors.size(); index++) {
+            final BehaviorControl<? super E> behavior = this.behaviors.get(index, version);
             if (behavior.getStatus() == Behavior.Status.RUNNING) {
                 behavior.tickOrStop(level, body, timestamp);
             }
@@ -87,7 +88,8 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
         // Paper end - Perf: Remove streams from hot code
         // Leaf start - Remove more streams in GateBehavior
         boolean hasRunningTask = false;
-        for (final BehaviorControl<? super E> behavior : this.behaviors) {
+        for (int index = 0, version = this.behaviors.modificationCount(); index < this.behaviors.size(); index++) {
+            final BehaviorControl<? super E> behavior = this.behaviors.get(index, version);
             if (behavior.getStatus() == Behavior.Status.RUNNING) {
                 hasRunningTask = true;
                 break;
@@ -103,7 +105,8 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
     public final void doStop(final ServerLevel level, final E body, final long timestamp) {
         this.status = Behavior.Status.STOPPED;
         // Paper start - Perf: Remove streams from hot code
-        for (final BehaviorControl<? super E> behavior : this.behaviors) {
+        for (int index = 0, version = this.behaviors.modificationCount(); index < this.behaviors.size(); index++) {
+            final BehaviorControl<? super E> behavior = this.behaviors.get(index, version);
             if (behavior.getStatus() == Behavior.Status.RUNNING) {
                 behavior.doStop(level, body, timestamp);
             }
@@ -146,7 +149,8 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
             public <E extends LivingEntity> void apply(
                 final ShufflingList<BehaviorControl<? super E>> behaviors, final ServerLevel level, final E body, final long timestamp
             ) {
-                for (final BehaviorControl<? super E> behavior : behaviors) {
+                for (int index = 0, version = behaviors.modificationCount(); index < behaviors.size(); index++) {
+                    final BehaviorControl<? super E> behavior = behaviors.get(index, version);
                     if (behavior.getStatus() == Behavior.Status.STOPPED && behavior.tryStart(level, body, timestamp)) {
                         break;
                     }
@@ -160,7 +164,8 @@ public class GateBehavior<E extends LivingEntity> implements BehaviorControl<E>
             public <E extends LivingEntity> void apply(
                 final ShufflingList<BehaviorControl<? super E>> behaviors, final ServerLevel level, final E body, final long timestamp
             ) {
-                for (final BehaviorControl<? super E> behavior : behaviors) {
+                for (int index = 0, version = behaviors.modificationCount(); index < behaviors.size(); index++) {
+                    final BehaviorControl<? super E> behavior = behaviors.get(index, version);
                     if (behavior.getStatus() == Behavior.Status.STOPPED) {
                         behavior.tryStart(level, body, timestamp);
                     }
diff --git a/net/minecraft/world/entity/ai/behavior/ShufflingList.java b/net/minecraft/world/entity/ai/behavior/ShufflingList.java
index 909a44b7897bfcb250f82e0a703606d79ee22f29..ccfabcc543f70086fa6ec11c2426a5220ad93d59 100644
--- a/net/minecraft/world/entity/ai/behavior/ShufflingList.java
+++ b/net/minecraft/world/entity/ai/behavior/ShufflingList.java
@@ -8,6 +8,7 @@ import com.mojang.serialization.DataResult;
 import com.mojang.serialization.Dynamic;
 import com.mojang.serialization.DynamicOps;
 import java.util.Comparator;
+import java.util.ConcurrentModificationException;
 import java.util.Iterator;
 import java.util.List;
 import java.util.stream.Stream;
@@ -17,6 +18,7 @@ public class ShufflingList<U> implements Iterable<U> {
     protected final List<ShufflingList.WeightedEntry<U>> entries;
     private final RandomSource random = RandomSource.create();
     private final boolean isUnsafe; // Paper - Fix Concurrency issue in ShufflingList during worldgen
+    private int modificationCount;
 
     public ShufflingList() {
         // Paper start - Fix Concurrency issue in ShufflingList during worldgen
@@ -44,6 +46,7 @@ public class ShufflingList<U> implements Iterable<U> {
 
     public ShufflingList<U> add(final U data, final int weight) {
         this.entries.add(new ShufflingList.WeightedEntry<>(data, weight));
+        this.modificationCount++;
         return this;
     }
 
@@ -52,6 +55,7 @@ public class ShufflingList<U> implements Iterable<U> {
         List<ShufflingList.WeightedEntry<U>> list = this.isUnsafe ? Lists.newArrayList(this.entries) : this.entries;
         list.forEach(k -> k.setRandom(this.random.nextFloat()));
         list.sort(Comparator.comparingDouble(ShufflingList.WeightedEntry::getRandWeight));
+        if (!this.isUnsafe) this.modificationCount++;
         return this.isUnsafe ? new ShufflingList<>(list, this.isUnsafe) : this;
         // Paper end - Fix Concurrency issue in ShufflingList during worldgen
     }
@@ -60,6 +64,23 @@ public class ShufflingList<U> implements Iterable<U> {
         return this.entries.stream().map(ShufflingList.WeightedEntry::getData);
     }
 
+    int size() {
+        return this.entries.size();
+    }
+
+    int modificationCount() {
+        return this.modificationCount;
+    }
+
+    U get(final int index) {
+        return this.entries.get(index).getData();
+    }
+
+    U get(final int index, final int expectedModificationCount) {
+        if (this.modificationCount != expectedModificationCount) throw new ConcurrentModificationException();
+        return this.get(index);
+    }
+
     @Override
     public Iterator<U> iterator() {
         return Iterators.transform(this.entries.iterator(), ShufflingList.WeightedEntry::getData);
diff --git a/net/minecraft/world/entity/ai/behavior/TriggerGate.java b/net/minecraft/world/entity/ai/behavior/TriggerGate.java
index 3ed67b4e1b082262e0bb35790c2ba4ac9d4d7fe0..3188851f54268fda6b4be10b25383bb31d86378f 100644
--- a/net/minecraft/world/entity/ai/behavior/TriggerGate.java
+++ b/net/minecraft/world/entity/ai/behavior/TriggerGate.java
@@ -23,7 +23,8 @@ public class TriggerGate {
                 behaviors.shuffle();
             }
 
-            for (Trigger<? super E> behavior : behaviors) {
+            for (int index = 0; index < behaviors.size(); index++) {
+                Trigger<? super E> behavior = behaviors.get(index);
                 if (behavior.trigger(level, body, timestamp) && runningPolicy == GateBehavior.RunningPolicy.RUN_ONE) {
                     break;
                 }
