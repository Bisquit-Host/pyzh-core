+    public void shutdownTickExecutor() {
+        if (this.tickExecutor == null) {
+            return;
+        }
+        if (Thread.currentThread() instanceof ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread tickThread && tickThread.currentTickingServerLevel == this) {
+            throw new IllegalStateException("Cannot unload world " + this.getWorld().getName() + " from its own tick thread");
+        }
+
+        this.prepareShutdown();
+        this.tickExecutor.shutdown();
+        boolean interrupted = false;
+        while (!this.tickExecutor.isTerminated()) {
+            try {
+                if (!this.tickExecutor.awaitTermination(30L, java.util.concurrent.TimeUnit.SECONDS)) {
+                    MinecraftServer.LOGGER.warn("Still waiting for the tick executor of world {} to terminate", this.getWorld().getName());
+                }
+            } catch (final InterruptedException ex) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+    }
