+    static boolean findSpawnBelowCeiling(final LevelReader level, final BlockPos.MutableBlockPos spawnPos) {
+        final int minY = level.getMinY();
+
+        // Move from the heightmap position onto the roof, through it into the
+        // interior, and then down to the first floor. Every scan is bounded.
+        while (spawnPos.getY() > minY && level.getBlockState(spawnPos).isAir()) {
+            spawnPos.move(net.minecraft.core.Direction.DOWN);
+        }
+        if (level.getBlockState(spawnPos).isAir()) {
+            return false;
+        }
+
+        while (spawnPos.getY() > minY && !level.getBlockState(spawnPos).isAir()) {
+            spawnPos.move(net.minecraft.core.Direction.DOWN);
+        }
+        if (!level.getBlockState(spawnPos).isAir()) {
+            return false;
+        }
+
+        while (spawnPos.getY() > minY && level.getBlockState(spawnPos).isAir()) {
+            spawnPos.move(net.minecraft.core.Direction.DOWN);
+        }
+        if (level.getBlockState(spawnPos).isAir()) {
+            return false;
+        }
+
+        spawnPos.move(net.minecraft.core.Direction.UP);
+        return spawnPos.getY() <= level.getMaxY();
+    }
