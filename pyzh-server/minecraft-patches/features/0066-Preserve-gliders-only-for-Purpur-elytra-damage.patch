From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:35 +0300
Subject: [PATCH] Preserve gliders only for Purpur elytra damage

Restore Paper's normal glider break events and callbacks. Cap Purpur's
gliding and boost damage at the last durability point so existing elytra
settings remain safe without a new configuration option.

diff --git a/net/minecraft/world/entity/LivingEntity.java b/net/minecraft/world/entity/LivingEntity.java
index 59118a587bf7c632d309ebaba909d39afc9329f9..5df5a521f4a5bde6d53b5fd799770a160be987a8 100644
--- a/net/minecraft/world/entity/LivingEntity.java
+++ b/net/minecraft/world/entity/LivingEntity.java
@@ -4099,7 +4099,9 @@ public abstract class LivingEntity extends Entity implements Attackable, Waypoin
                             damage *= (int) speed;
                         }
                     }
-                    this.getItemBySlot(slotToDamage).hurtAndBreak(damage, this, slotToDamage);
+                    ItemStack glideItem = this.getItemBySlot(slotToDamage);
+                    damage = Math.min(damage, Math.max(0, glideItem.getMaxDamage() - 1 - glideItem.getDamageValue()));
+                    glideItem.hurtAndBreak(damage, this, slotToDamage);
                     // Purpur end - Implement elytra settings
                 }
 
diff --git a/net/minecraft/world/item/FireworkRocketItem.java b/net/minecraft/world/item/FireworkRocketItem.java
index f7d5cba0801b87229fac9d7820aaffadd4ef388c..56d1ef1b4fa1c13ce883b3d355dc877fa11f08e3 100644
--- a/net/minecraft/world/item/FireworkRocketItem.java
+++ b/net/minecraft/world/item/FireworkRocketItem.java
@@ -80,7 +80,8 @@ public class FireworkRocketItem extends Item implements ProjectileItem {
 
                         ItemStack glideItem = player.getItemBySlot(enumitemslot);
                         if (player.canGlide()) {
-                            glideItem.hurtAndBreak(level.purpurConfig.elytraDamagePerFireworkBoost, player, enumitemslot);
+                            int damage = Math.min(level.purpurConfig.elytraDamagePerFireworkBoost, Math.max(0, glideItem.getMaxDamage() - 1 - glideItem.getDamageValue()));
+                            glideItem.hurtAndBreak(damage, player, enumitemslot);
                         }
                     }
                     // Purpur end - Implement elytra settings
diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index 8d5bca0c09bca280161caafc9e9d6a9255da6b6d..c30d9eb629fc542b7df35b666e4c941626e4baac 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -701,13 +701,6 @@ public final class ItemStack implements DataComponentHolder, ItemInstance, net.c
             }
             // CraftBukkit end
 
-            // Purpur start - Implement elytra settings
-            if (this.has(DataComponents.GLIDER)) {
-                setDamageValue(this.getMaxDamage() - 1);
-                return;
-            }
-            // Purpur end - Implement elytra settings
-
             this.shrink(1);
             ScopedValue.where(CURRENT_BROKEN_ITEM, brokenItemStack).run(() -> onBreak.accept(item)); // Leaf - Fix MC-311022
         }
diff --git a/net/minecraft/world/item/TridentItem.java b/net/minecraft/world/item/TridentItem.java
index 4542e4cee86158874e034f376da3921635f0f587..ec323a1267a78746221467cdb3c9373f224a3592 100644
--- a/net/minecraft/world/item/TridentItem.java
+++ b/net/minecraft/world/item/TridentItem.java
@@ -133,7 +133,8 @@ public class TridentItem extends Item implements ProjectileItem {
                                 net.minecraft.world.entity.EquipmentSlot enumitemslot = net.minecraft.util.Util.getRandom(list, entity.getRandom()); // Leaf - fix build
                                 ItemStack glideItem = entity.getItemBySlot(enumitemslot);
                                 if (glideItem.has(net.minecraft.core.component.DataComponents.GLIDER) && level.purpurConfig.elytraDamagePerTridentBoost > 0) {
-                                    glideItem.hurtAndBreak(level.purpurConfig.elytraDamagePerTridentBoost, entity, enumitemslot);
+                                    int damage = Math.min(level.purpurConfig.elytraDamagePerTridentBoost, Math.max(0, glideItem.getMaxDamage() - 1 - glideItem.getDamageValue()));
+                                    glideItem.hurtAndBreak(damage, entity, enumitemslot);
                                 }
                             }
                             // Purpur end - Implement elytra settings
