Subject: [PATCH] Remove the unused entity position lock

Paw removed all position-lock consumers. Avoid allocating an unused
monitor for every entity.

diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index 1627fa339923874b721e87f6d4885f2dddf3cef5..e0cbac43180defa20b823810b99c2728faafb21c 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -1273,9 +1273,6 @@ public abstract class Entity
         return this.onGround;
     }
 
-    // Paper start - detailed watchdog information
-    public final Object posLock = new Object(); // Paper - log detailed entity tick information
-
     public void move(final MoverType moverType, Vec3 delta) {
         if (SharedConstants.IS_RUNNING_IN_IDE && !moverType.isServerAndClientSimulated() && !this.canSimulateMovement()) {
             throw (IllegalStateException)Util.pauseInIde(
