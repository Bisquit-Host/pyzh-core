From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Tue, 17 Nov 2026 07:48:28 +0300
Subject: [PATCH] Reuse block states within redstone wire evaluations

Carry the above and horizontal states from block-signal scans into incoming
wire scans using invocation-local references. Evaluate each incoming
conductor once. Share the path with experimental and Eigencraft evaluation
without allocating a cache or changing wire-suppression scope. The block
scan suppresses wire signals through the same flag getBlockSignal uses
(world tick thread field, ThreadLocal fallback or serial field) and
restores its previous value afterwards, also on exceptions.

Require the own chunk and every reachable neighbor chunk to be FULL through
the non-loading immediate accessor used by subsequent world reads. Direct
signals reach Manhattan distance two; only local 0/15 corners reach a
diagonal chunk. Signal getters and conductor predicates cannot write states
or call plugins without loading a chunk. If any required chunk is missing,
retain every original read and predicate, including synchronous load order.
Keep the original two-argument incoming scan and remove the unused
dispatcher. Leave neighbor-update iteration and position hashing intact.

Eight interleaved redstone pairs vs the previous third-patch followup.jar:
2.654 to 2.549 ms/tick, -3.97% +/-3.96 percentage points at 95%, not resolved
at 99%. Allocation +0.07% +/-0.27 points. Exact state CRC remains 4217535585.
JFR Level.getBlockState inclusive share falls from 32.3% to 30.6%.
Focused differential/event tests in RedstoneReadTest cover the
suppression flag on every thread kind and all 256 local positions with
every required chunk loaded and each required chunk absent in turn, with
simulated load-callback writes.

diff --git a/net/minecraft/world/level/block/RedStoneWireBlock.java b/net/minecraft/world/level/block/RedStoneWireBlock.java
index 7e8f821aa0c5847c7213a7d2cbc9c0b1c638fac6..0be7524ee8936942cb9265e7040ffcb5706f1f34 100644
--- a/net/minecraft/world/level/block/RedStoneWireBlock.java
+++ b/net/minecraft/world/level/block/RedStoneWireBlock.java
@@ -389,6 +389,62 @@ public class RedStoneWireBlock extends Block {
         return this.shouldSignalTL.get();
     }
 
+    private boolean setShouldSignal(final boolean signal) {
+        final boolean previous;
+        if (!org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled) {
+            previous = this.shouldSignal;
+            this.shouldSignal = signal;
+        } else if (Thread.currentThread() instanceof ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread tickThread) {
+            previous = tickThread.redstoneWireShouldSignal;
+            tickThread.redstoneWireShouldSignal = signal;
+        } else {
+            previous = this.shouldSignalTL.get();
+            this.shouldSignalTL.set(signal);
+        }
+        return previous;
+    }
+
+    // All chunks in the scan must already be FULL. Keep this scan in sync with SignalGetter.getBestNeighborSignal/getSignal.
+    public int getBlockAndWireSignal(
+        final Level level, final BlockPos pos, final RedstoneWireEvaluator evaluator, final boolean skipWireAtMax
+    ) {
+        BlockState above = null;
+        BlockState north = null;
+        BlockState south = null;
+        BlockState west = null;
+        BlockState east = null;
+        int blockSignal = 0;
+        final boolean previousSignal = this.setShouldSignal(false);
+        try {
+            BlockPos.MutableBlockPos neighborPos = new BlockPos.MutableBlockPos();
+            for (Direction direction : net.minecraft.world.level.SignalGetter.DIRECTIONS) {
+                neighborPos.setWithOffset(pos, direction);
+                BlockState neighborState = level.getBlockState(neighborPos);
+                switch (direction) {
+                    case UP -> above = neighborState;
+                    case NORTH -> north = neighborState;
+                    case SOUTH -> south = neighborState;
+                    case WEST -> west = neighborState;
+                    case EAST -> east = neighborState;
+                }
+                int signal = neighborState.getSignal(level, neighborPos, direction);
+                if (neighborState.isRedstoneConductor(level, neighborPos)) {
+                    signal = Math.max(signal, level.getDirectSignalTo(neighborPos));
+                }
+                blockSignal = Math.max(blockSignal, signal);
+                if (blockSignal >= Redstone.SIGNAL_MAX) {
+                    blockSignal = Redstone.SIGNAL_MAX;
+                    break;
+                }
+            }
+        } finally {
+            this.setShouldSignal(previousSignal);
+        }
+        int wireSignal = skipWireAtMax && blockSignal == Redstone.SIGNAL_MAX ? 0
+            : evaluator.getIncomingWireSignal(level, pos, above, north, south, west, east);
+        return blockSignal << 4 | wireSignal;
+    }
+
