diff --git a/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java b/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
index 826fb530c4eb486ebc509c4ece7e35ca2636a568..df005a2eb1e06739b1cff8fbd1f19dd9816cf6de 100644
--- a/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
+++ b/net/minecraft/world/level/redstone/RedstoneWireEvaluator.java
@@ -2,6 +2,7 @@ package net.minecraft.world.level.redstone;
 
 import net.minecraft.core.BlockPos;
 import net.minecraft.core.Direction;
+import net.minecraft.server.level.ServerChunkCache;
 import net.minecraft.world.level.Level;
 import net.minecraft.world.level.block.RedStoneWireBlock;
 import net.minecraft.world.level.block.state.BlockState;
@@ -22,10 +23,87 @@ public abstract class RedstoneWireEvaluator {
         return this.wireBlock.getBlockSignal(level, pos);
     }
 
+    // Experimental turn-off logic needs both powers. Low nibble: wire power; high nibble: block power.
+    protected int getBlockAndWireSignal(final Level level, final BlockPos pos, final boolean skipWireAtMax) {
+        if (areSignalChunksLoaded(level, pos)) {
+            return this.wireBlock.getBlockAndWireSignal(level, pos, this, skipWireAtMax);
+        }
+        int blockSignal = this.getBlockSignal(level, pos);
+        int wireSignal = skipWireAtMax && blockSignal == Redstone.SIGNAL_MAX ? 0 : this.getIncomingWireSignal(level, pos);
+        return blockSignal << 4 | wireSignal;
+    }
+
+    // Direct signals reach Manhattan distance two. Only a chunk load can run plugin writes during these reads.
+    private static boolean areSignalChunksLoaded(final Level level, final BlockPos pos) {
+        if (!(level.getChunkSource() instanceof ServerChunkCache chunks)) {
+            return false;
+        }
+        int chunkX = pos.getX() >> 4;
+        int chunkZ = pos.getZ() >> 4;
+        if (chunks.getChunkAtIfLoadedImmediately(chunkX, chunkZ) == null) {
+            return false;
+        }
+        int x = pos.getX() & 15;
+        int z = pos.getZ() & 15;
+        int neighborX = (pos.getX() + (x < 2 ? -2 : 2)) >> 4;
+        int neighborZ = (pos.getZ() + (z < 2 ? -2 : 2)) >> 4;
+        if (neighborX != chunkX && chunks.getChunkAtIfLoadedImmediately(neighborX, chunkZ) == null) {
+            return false;
+        }
+        if (neighborZ != chunkZ && chunks.getChunkAtIfLoadedImmediately(chunkX, neighborZ) == null) {
+            return false;
+        }
+        return !((x == 0 || x == 15) && (z == 0 || z == 15))
+            || chunks.getChunkAtIfLoadedImmediately(neighborX, neighborZ) != null;
+    }
+
     protected int getWireSignal(final BlockPos pos, final BlockState state) {
         return state.is(this.wireBlock) ? state.getValue(RedStoneWireBlock.POWER) : 0;
     }
 
+    public int getIncomingWireSignal(
+        final Level level, final BlockPos pos, @Nullable BlockState aboveState,
+        final @Nullable BlockState northState, final @Nullable BlockState southState,
+        final @Nullable BlockState westState, final @Nullable BlockState eastState
+    ) {
+        int wireSignal = 0;
+        BlockPos.MutableBlockPos neighborPos = new BlockPos.MutableBlockPos();
+        BlockPos.MutableBlockPos verticalNeighborPos = new BlockPos.MutableBlockPos();
+        BlockPos abovePos = pos.above();
+        int aboveConductor = -1;
+        for (Direction direction : Direction.Plane.HORIZONTAL.faces) {
+            neighborPos.setWithOffset(pos, direction);
+            BlockState neighborState = switch (direction) {
+                case NORTH -> northState;
+                case SOUTH -> southState;
+                case WEST -> westState;
+                case EAST -> eastState;
+                default -> throw new IllegalStateException();
+            };
+            if (neighborState == null) {
+                neighborState = level.getBlockState(neighborPos);
+            }
+            wireSignal = Math.max(wireSignal, this.getWireSignal(neighborPos, neighborState));
+            boolean conductor = neighborState.isRedstoneConductor(level, neighborPos);
+            if (conductor) {
+                if (aboveState == null) {
+                    aboveState = level.getBlockState(abovePos);
+                }
+                if (aboveConductor == -1) {
+                    aboveConductor = aboveState.isRedstoneConductor(level, abovePos) ? 1 : 0;
+                }
+                if (aboveConductor == 0) {
+                    verticalNeighborPos.setWithOffset(neighborPos, Direction.UP);
+                    wireSignal = Math.max(wireSignal, this.getWireSignal(verticalNeighborPos, level.getBlockState(verticalNeighborPos)));
+                }
+            } else {
+                verticalNeighborPos.setWithOffset(neighborPos, Direction.DOWN);
+                wireSignal = Math.max(wireSignal, this.getWireSignal(verticalNeighborPos, level.getBlockState(verticalNeighborPos)));
+            }
+        }
+        return Math.max(0, wireSignal - 1);
+    }
+
     protected int getIncomingWireSignal(final Level level, final BlockPos pos) {
         int wireSignal = 0;
         BlockPos.MutableBlockPos neighborPos = new BlockPos.MutableBlockPos();
