From: TurboVadim <yolkin.vadim@gmail.com>
Date: Thu, 24 Sep 2026 16:22:59 +0300
Subject: [PATCH] Look up the precipitation biome only when it can matter

tickPrecipitation looked up the biome at every random precipitation
position. Without rain the biome only feeds shouldFreeze, which can
only be true when the fluid at the position below is water. The lookup
now happens under that check, or when it is raining, in the same order
relative to the ice form event.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 6e94d4cc22e04c1f3b28e941c6c502c962ffbf83..fb00b6c85e05be5e6183102ec311909020d52bce 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1378,12 +1378,20 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public void tickPrecipitation(final BlockPos pos) {
         BlockPos topPos = this.getHeightmapPos(Heightmap.Types.MOTION_BLOCKING, pos);
         BlockPos belowPos = topPos.below();
-        Biome biome = this.getBiome(topPos).value();
-        if (biome.shouldFreeze(this, belowPos)) {
-            org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, belowPos, Blocks.ICE.defaultBlockState(), Block.UPDATE_ALL, null); // CraftBukkit
+        // Pyzh start - Look up the biome only when it can matter; shouldFreeze requires water at belowPos
+        Biome biome = null;
+        if (this.getFluidState(belowPos).is(net.minecraft.world.level.material.Fluids.WATER)) {
+            biome = this.getBiome(topPos).value();
+            if (biome.shouldFreeze(this, belowPos)) {
+                org.bukkit.craftbukkit.event.CraftEventFactory.handleBlockFormEvent(this, belowPos, Blocks.ICE.defaultBlockState(), Block.UPDATE_ALL, null); // CraftBukkit
+            }
         }
 
         if (this.isRaining()) {
+            if (biome == null) {
+                biome = this.getBiome(topPos).value();
+            }
+        // Pyzh end - Look up the biome only when it can matter
             int maxHeight = this.getGameRules().get(GameRules.MAX_SNOW_ACCUMULATION_HEIGHT);
             if (maxHeight > 0 && biome.shouldSnow(this, topPos)) {
                 BlockState state = this.getBlockState(topPos);
