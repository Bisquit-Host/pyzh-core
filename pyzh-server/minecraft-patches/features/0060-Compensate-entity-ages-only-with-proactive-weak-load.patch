From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:18 +0300
Subject: [PATCH] Compensate entity ages only with proactive weak loading

Gate missed ticks, saved age compensation and the save-time despawn veto
on the existing opt-in weak-loading feature. Keep last-tick tracking current.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java
index 80f4da7bc3b045e1638ab1794a4d9d257245de3d..a25b2efccb0fc05f3fe3cba04f4c10e9277f91e2 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/ChunkEntitySlices.java
@@ -183,7 +183,7 @@ public final class ChunkEntitySlices {
                 // removed by us below
                 continue;
             }
-            if (entity.detectDespawnTime(true)) continue; // Leaf - Rewrite entity despawn time
+            if (org.dreeam.leaf.config.modules.opt.DespawnTime.proactiveWeakLoading && entity.detectDespawnTime(true)) continue; // Leaf - Rewrite entity despawn time
             if (entity.shouldBeSaved()) {
                 PlatformHooks.get().unloadEntity(entity);
                 if (entity.isVehicle()) {
diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
index c1e32a28604d3f54ae12a9badd8ac30be9f03861..1627fa339923874b721e87f6d4885f2dddf3cef5 100644
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -980,6 +980,9 @@ public abstract class Entity
     }
 
     private int getCompensatedEntityAge() {
+        if (!org.dreeam.leaf.config.modules.opt.DespawnTime.proactiveWeakLoading) {
+            return this.totalEntityAge;
+        }
         int missedTicks = this.calculateMissedTicks();
         if (missedTicks > 0) {
             return this.totalEntityAge + missedTicks;
@@ -988,9 +991,11 @@ public abstract class Entity
     }
 
     public void updateEntityAge() {
-        int missedTicks = this.calculateMissedTicks();
-        if (missedTicks > 1) {
-            this.totalEntityAge += missedTicks - 1;
+        if (org.dreeam.leaf.config.modules.opt.DespawnTime.proactiveWeakLoading) {
+            int missedTicks = this.calculateMissedTicks();
+            if (missedTicks > 1) {
+                this.totalEntityAge += missedTicks - 1;
+            }
         }
         this.totalEntityAge++;
         this.updateLastTick();
@@ -5760,7 +5765,7 @@ public abstract class Entity
         return (this.removalReason == null || this.removalReason.shouldSave())
             && !this.isPassenger()
             && (!this.isVehicle() || !((ca.spottedleaf.moonrise.patches.chunk_system.entity.ChunkSystemEntity)this).moonrise$hasAnyPlayerPassengers())
-            && !this.isExceedingDespawnTime(true); // Paper - rewrite chunk system // Leaf - Rewrite entity despawn time
+            && (!org.dreeam.leaf.config.modules.opt.DespawnTime.proactiveWeakLoading || !this.isExceedingDespawnTime(true)); // Paper - rewrite chunk system // Leaf - Rewrite entity despawn time
     }
 
     @Override
