diff --git a/net/minecraft/world/level/pathfinder/PathSearchScratch.java b/net/minecraft/world/level/pathfinder/PathSearchScratch.java
new file mode 100644
index 0000000000000000000000000000000000000000..439e2c0839102da790856ee750484e3458fb3a35
--- /dev/null
+++ b/net/minecraft/world/level/pathfinder/PathSearchScratch.java
@@ -0,0 +1,137 @@
+package net.minecraft.world.level.pathfinder;
+
+import it.unimi.dsi.fastutil.ints.Int2ObjectOpenHashMap;
+import java.util.ArrayDeque;
+import java.util.Arrays;
+import net.minecraft.core.BlockPos;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Lookup tables of one path search, leased by a NodeEvaluator from prepare() to done() so that searches reuse the
+ * same hot memory instead of every mob keeping its own maps.
+ * A cell holds what the search asks about a block position again and again: the path type of the mob standing there,
+ * the floor level and the node. Nodes stay keyed by Node.createHash, which several positions can share.
+ * A cell index is valid until the next call to cell().
+ */
+final class PathSearchScratch {
+    private static final int INITIAL_CAPACITY = 1024;
+    private static final int MAX_POOLED = 16;
+    private static final int MAX_RETAINED_CAPACITY = 65536;
+    private static final long HASH_MULTIPLIER = 0x9E3779B97F4A7C15L;
+    private static final ArrayDeque<PathSearchScratch> POOL = new ArrayDeque<>();
+
+    private long[] keys = new long[INITIAL_CAPACITY];
+    private int[] stamps = new int[INITIAL_CAPACITY];
+    @Nullable PathType[] types = new PathType[INITIAL_CAPACITY];
+    double[] floors = new double[INITIAL_CAPACITY];
+    private @Nullable Node[] nodes = new Node[INITIAL_CAPACITY];
+    private final Int2ObjectOpenHashMap<Node> nodesByHash = new Int2ObjectOpenHashMap<>();
+    private int shift = 64 - Integer.numberOfTrailingZeros(INITIAL_CAPACITY);
+    private int stamp;
+    private int size;
+
+    static PathSearchScratch acquire() {
+        PathSearchScratch scratch;
+        synchronized (POOL) {
+            scratch = POOL.pollFirst();
+        }
+
+        return scratch != null ? scratch : new PathSearchScratch();
+    }
+
+    void release() {
+        // Unused cells can otherwise retain entire cameFrom chains across searches.
+        Arrays.fill(this.nodes, null);
+        this.nodesByHash.clear();
+        synchronized (POOL) {
+            if (this.keys.length <= MAX_RETAINED_CAPACITY && POOL.size() < MAX_POOLED) {
+                POOL.addFirst(this);
+            }
+        }
+    }
+
+    void reset() {
+        if (++this.stamp == 0) {
+            Arrays.fill(this.stamps, 0);
+            this.stamp = 1;
+        }
+
+        this.size = 0;
+        this.nodesByHash.clear();
+    }
+
+    int cell(final int x, final int y, final int z) {
+        long key = BlockPos.asLong(x, y, z);
+        int mask = this.keys.length - 1;
+        int index = (int)(key * HASH_MULTIPLIER >>> this.shift);
+
+        while (this.stamps[index] == this.stamp) {
+            if (this.keys[index] == key) {
+                return index;
+            }
+
+            index = index + 1 & mask;
+        }
+
+        if (this.size * 2 >= this.keys.length) {
+            this.grow();
+            return this.cell(x, y, z);
+        }
+
+        this.size++;
+        this.stamps[index] = this.stamp;
+        this.keys[index] = key;
+        this.types[index] = null;
+        this.floors[index] = Double.NaN;
+        this.nodes[index] = null;
+        return index;
+    }
+
+    Node node(final int cell, final int x, final int y, final int z) {
+        Node node = this.nodes[cell];
+        if (node == null) {
+            int hash = Node.createHash(x, y, z);
+            node = this.nodesByHash.get(hash);
+            if (node == null) {
+                node = new Node(x, y, z);
+                this.nodesByHash.put(hash, node);
+            }
+
+            this.nodes[cell] = node;
+        }
+
+        return node;
+    }
+
+    private void grow() {
+        long[] oldKeys = this.keys;
+        int[] oldStamps = this.stamps;
+        PathType[] oldTypes = this.types;
+        double[] oldFloors = this.floors;
+        Node[] oldNodes = this.nodes;
+        int capacity = oldKeys.length << 1;
+        int mask = capacity - 1;
+        this.keys = new long[capacity];
+        this.stamps = new int[capacity];
+        this.types = new PathType[capacity];
+        this.floors = new double[capacity];
+        this.nodes = new Node[capacity];
+        this.shift--;
+
+        for (int old = 0; old < oldKeys.length; old++) {
+            if (oldStamps[old] == this.stamp) {
+                int index = (int)(oldKeys[old] * HASH_MULTIPLIER >>> this.shift);
+
+                while (this.stamps[index] == this.stamp) {
+                    index = index + 1 & mask;
+                }
+
+                this.stamps[index] = this.stamp;
+                this.keys[index] = oldKeys[old];
+                this.types[index] = oldTypes[old];
+                this.floors[index] = oldFloors[old];
+                this.nodes[index] = oldNodes[old];
+            }
+        }
+    }
+}
