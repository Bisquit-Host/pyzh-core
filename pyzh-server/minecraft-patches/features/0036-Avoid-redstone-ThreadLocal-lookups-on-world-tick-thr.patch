From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:43:17 +0300
Subject: [PATCH] Avoid redstone ThreadLocal lookups on world tick threads

Use the world tick thread's wire signal flag for suppression and all three readers. Retain the ThreadLocal fallback on other parallel-mode threads and the legacy serial flag. Restore prior state in finally for nested queries and exceptions.

diff --git a/net/minecraft/world/level/block/RedstoneWireBlock.java b/net/minecraft/world/level/block/RedstoneWireBlock.java
index a74fe8ec1c6e48d202eeabf420243ef4cc8b8956..dcc31c0b992492853e3c09928151dc7f28caad63 100644
--- a/net/minecraft/world/level/block/RedstoneWireBlock.java
+++ b/net/minecraft/world/level/block/RedstoneWireBlock.java
@@ -342,19 +342,44 @@ public class RedstoneWireBlock extends Block {
     public int getBlockSignal(final Level level, final BlockPos pos) {
         // Leaf start - SparklyPaper - parallel world ticking
         if (org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled) {
+            if (Thread.currentThread() instanceof ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread tickThread) {
+                final boolean previous = tickThread.redstoneWireShouldSignal;
+                tickThread.redstoneWireShouldSignal = false;
+                try {
+                    return level.getBestNeighborSignal(pos);
+                } finally {
+                    tickThread.redstoneWireShouldSignal = previous;
+                }
+            }
+            final boolean previous = this.shouldSignalTL.get();
             this.shouldSignalTL.set(false);
-            int blockSignal = level.getBestNeighborSignal(pos);
-            this.shouldSignalTL.set(true);
-            return blockSignal;
+            try {
+                return level.getBestNeighborSignal(pos);
+            } finally {
+                this.shouldSignalTL.set(previous);
+            }
         } else {
+            final boolean previous = this.shouldSignal;
             this.shouldSignal = false;
-            int blockSignal = level.getBestNeighborSignal(pos);
-            this.shouldSignal = true;
-            return blockSignal;
+            try {
+                return level.getBestNeighborSignal(pos);
+            } finally {
+                this.shouldSignal = previous;
+            }
         }
         // Leaf end - SparklyPaper - parallel world ticking
     }
 
+    private boolean shouldSignal() {
+        if (!org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled) {
+            return this.shouldSignal;
+        }
+        if (Thread.currentThread() instanceof ca.spottedleaf.moonrise.common.util.TickThread.ServerLevelTickThread tickThread) {
+            return tickThread.redstoneWireShouldSignal;
+        }
+        return this.shouldSignalTL.get();
+    }
+
     private void checkCornerChangeAt(final Level level, final BlockPos pos) {
         if (level.getBlockState(pos).is(this)) {
             level.updateNeighborsAt(pos, this);
@@ -446,7 +471,7 @@ public class RedstoneWireBlock extends Block {
     @Override
     protected int getDirectSignal(final BlockState state, final BlockGetter level, final BlockPos pos, final Direction direction) {
         // Leaf start - SparklyPaper - parallel world ticking
-        boolean signal = org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled ? this.shouldSignalTL.get() : this.shouldSignal;
+        boolean signal = this.shouldSignal();
         return !signal ? Redstone.SIGNAL_MIN : state.getSignal(level, pos, direction);
         // Leaf end - SparklyPaper - parallel world ticking
     }
@@ -454,7 +479,7 @@ public class RedstoneWireBlock extends Block {
     @Override
     protected int getSignal(final BlockState state, final BlockGetter level, final BlockPos pos, final Direction direction) {
         // Leaf start - SparklyPaper - parallel world ticking
-        final boolean signal = org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled ? this.shouldSignalTL.get() : this.shouldSignal;
+        final boolean signal = this.shouldSignal();
         if (signal && direction != Direction.DOWN) {
             // Leaf end - SparklyPaper - parallel world ticking
             int power = this.ownSignal(state, level, pos);
@@ -491,7 +516,7 @@ public class RedstoneWireBlock extends Block {
 
     @Override
     protected boolean isSignalSource(final BlockState state) {
-        return org.dreeam.leaf.config.modules.async.SparklyPaperParallelWorldTicking.enabled ? this.shouldSignalTL.get() : this.shouldSignal; // Leaf - SparklyPaper - parallel world ticking
+        return this.shouldSignal();
     }
 
     public static int getColorForPower(final int power) {
