From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Sun, 27 Sep 2026 11:55:17 +0300
Subject: [PATCH] Write player stats and advancements off the main thread

Saving a player (quit, autosave) wrote the stats and advancements JSON
on the main thread, about 8-16 ms per quit. The JSON tree is still built
on the main thread from current state, then handed to the player IO
queue, which writes files in submission order. Loading stats or
advancements reads a pending tree for that file first, so a quick rejoin
or offline stats lookup sees the newest data. Disabled together with
async player data saving.

diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index 129a39c82fe6a7b2429b32a4f85dbf42e140b49b..d80093d6f6edd65e62beb4449322d00b5d9c73c6 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -115,6 +115,17 @@ public class PlayerAdvancements {
     }
 
     private void load(final ServerAdvancementManager manager) {
+        // Pyzh start - Write player stats and advancements off the main thread
+        final java.util.Optional<JsonElement> pending = org.dreeam.leaf.async.AsyncPlayerDataSaving.getPendingJson(this.playerSavePath);
+        if (pending.isPresent()) {
+            try {
+                PlayerAdvancements.Data data = this.codec.parse(JsonOps.INSTANCE, pending.get()).getOrThrow(JsonParseException::new);
+                this.applyFrom(manager, data);
+            } catch (JsonParseException e) {
+                LOGGER.error("Couldn't parse player advancements in {}", this.playerSavePath, e);
+            }
+        } else
+        // Pyzh end - Write player stats and advancements off the main thread
         if (Files.isRegularFile(this.playerSavePath)) {
             try (Reader reader = Files.newBufferedReader(this.playerSavePath, StandardCharsets.UTF_8)) {
                 JsonElement json = StrictJsonParser.parse(reader);
@@ -135,15 +146,21 @@ public class PlayerAdvancements {
         if (org.spigotmc.SpigotConfig.disableAdvancementSaving) return; // Spigot
         if (org.dreeam.leaf.config.modules.misc.RegionFormatConfig.isReadOnlyMode()) return; // Leaf - Add read-only mode for Linear v2
         JsonElement json = this.codec.encodeStart(JsonOps.INSTANCE, this.asData()).getOrThrow();
+        // Pyzh start - Write player stats and advancements off the main thread
+        final Path path = this.playerSavePath;
+        org.dreeam.leaf.async.AsyncPlayerDataSaving.submitJson(path, json, tree -> writeJson(path, tree));
+    }
 
+    private static void writeJson(final Path path, final JsonElement json) {
+        // Pyzh end - Write player stats and advancements off the main thread
         try {
-            FileUtil.createDirectoriesSafe(this.playerSavePath.getParent());
+            FileUtil.createDirectoriesSafe(path.getParent());
 
-            try (Writer outputWriter = Files.newBufferedWriter(this.playerSavePath, StandardCharsets.UTF_8)) {
+            try (Writer outputWriter = Files.newBufferedWriter(path, StandardCharsets.UTF_8)) {
                 GSON.toJson(json, GSON.newJsonWriter(outputWriter));
             }
         } catch (IOException | JsonIOException e) {
-            LOGGER.error("Couldn't save player advancements to {}", this.playerSavePath, e);
+            LOGGER.error("Couldn't save player advancements to {}", path, e);
         }
     }
 
diff --git a/net/minecraft/stats/ServerStatsCounter.java b/net/minecraft/stats/ServerStatsCounter.java
index 1df6efebeda39097d75590c751ec635962b6e626..938f99e0809619a205d3f08369dc2544be309033 100644
--- a/net/minecraft/stats/ServerStatsCounter.java
+++ b/net/minecraft/stats/ServerStatsCounter.java
@@ -65,6 +65,16 @@ public class ServerStatsCounter extends StatsCounter {
 
     public ServerStatsCounter(final MinecraftServer server, final Path file) {
         this.file = file;
+        // Pyzh start - Write player stats and advancements off the main thread
+        final java.util.Optional<JsonElement> pending = org.dreeam.leaf.async.AsyncPlayerDataSaving.getPendingJson(file);
+        if (pending.isPresent()) {
+            try {
+                this.parse(server.getFixerUpper(), pending.get());
+            } catch (JsonParseException e) {
+                LOGGER.error("Couldn't parse statistics file {}", file, e);
+            }
+        } else
+        // Pyzh end - Write player stats and advancements off the main thread
         if (Files.isRegularFile(file)) {
             try (Reader reader = Files.newBufferedReader(file, StandardCharsets.UTF_8)) {
                 JsonElement element = StrictJsonParser.parse(reader);
@@ -91,14 +101,21 @@ public class ServerStatsCounter extends StatsCounter {
     public void save() {
         if (org.spigotmc.SpigotConfig.disableStatSaving) return; // Spigot
         if (org.dreeam.leaf.config.modules.misc.RegionFormatConfig.isReadOnlyMode()) return; // Leaf - Add read-only mode for Linear v2
+        // Pyzh start - Write player stats and advancements off the main thread
+        final Path file = this.file;
+        org.dreeam.leaf.async.AsyncPlayerDataSaving.submitJson(file, this.toJson(), json -> writeJson(file, json));
+    }
+
+    private static void writeJson(final Path file, final JsonElement json) {
+        // Pyzh end - Write player stats and advancements off the main thread
         try {
-            FileUtil.createDirectoriesSafe(this.file.getParent());
+            FileUtil.createDirectoriesSafe(file.getParent());
 
-            try (Writer writer = Files.newBufferedWriter(this.file, StandardCharsets.UTF_8)) {
-                GSON.toJson(this.toJson(), GSON.newJsonWriter(writer));
+            try (Writer writer = Files.newBufferedWriter(file, StandardCharsets.UTF_8)) {
+                GSON.toJson(json, GSON.newJsonWriter(writer));
             }
         } catch (IOException | JsonIOException e) {
-            LOGGER.error("Couldn't save stats to {}", this.file, e);
+            LOGGER.error("Couldn't save stats to {}", file, e);
         }
     }
 
