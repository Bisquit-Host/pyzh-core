+        for (var behaviorSet : this.orderedBehaviors()) {
+            final var behaviors = behaviorSet.raw();
+            for (int index = 0, count = behaviorSet.size(); index < count; index++) {
+                BehaviorControl<? super E> behavior = behaviors[index];
+                if (behavior.getStatus() == Behavior.Status.RUNNING) {
+                    behavior.doStop(level, body, timestamp);
+                    behaviorSet.dec();
                 }
             }
         }
         // Leaf end - Replace brain maps with optimized collection
     }
 
+    private org.dreeam.leaf.util.map.BehaviorControlArraySet<? super E>[] orderedBehaviors() {
+        if (this.orderedBehaviors == EMPTY_BEHAVIOR_ARRAY && !this.availableBehaviorsByPriority.isEmpty()) {
+            var ordered = new ObjectArrayList<org.dreeam.leaf.util.map.BehaviorControlArraySet<? super E>>();
+            var activities = new ObjectArrayList<Activity>();
+            for (Map<Activity, Set<BehaviorControl<? super E>>> byActivity : this.availableBehaviorsByPriority.values()) {
+                for (var entry : byActivity.entrySet()) {
+                    ordered.add((org.dreeam.leaf.util.map.BehaviorControlArraySet<? super E>) entry.getValue());
+                    activities.add(entry.getKey());
+                }
+            }
+            this.orderedBehaviors = ordered.toArray(EMPTY_BEHAVIOR_ARRAY);
+            this.orderedActivities = activities.toArray(new Activity[0]);
+        }
+        return this.orderedBehaviors;
+    }
+
