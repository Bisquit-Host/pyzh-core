From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Sun, 27 Sep 2026 11:55:17 +0300
Subject: [PATCH] Queue player JSON files on the player IO thread

Adds submitJson and getPendingJson next to the player data queue. JSON
files are written on the player IO thread in submission order per path,
the newest pending tree stays readable (as a copy) until it is written,
and shutdown waits for them. With async saving disabled or shutting
down, writes run synchronously as before.

diff --git a/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java b/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
index f969cdd81d3e4310e851f236180e7a0e5c3723ce..e6ddc286aaf79befb4ecae54ef8147b061a2245d 100644
--- a/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
+++ b/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
@@ -26,6 +26,7 @@ public final class AsyncPlayerDataSaving {
     private static final Logger LOGGER = LogManager.getLogger("Leaf");
     private static final Object LIFECYCLE_LOCK = new Object();
     private static final Map<UUID, PlayerSaveState> PLAYER_SAVES = new HashMap<>();
+    private static final Map<java.nio.file.Path, JsonFileState> JSON_SAVES = new HashMap<>(); // Pyzh - Write player stats and advancements off the main thread
     private static final AtomicInteger PLAYER_THREAD_COUNTER = new AtomicInteger();
     private static ExecutorService playerIoPool;
     private static ExecutorService levelIoPool;
@@ -110,6 +111,50 @@ public final class AsyncPlayerDataSaving {
         }
     }
 
+    // Pyzh start - Write player stats and advancements off the main thread
+    // Writes a player JSON file (stats, advancements) on the player IO thread, in submission order per path.
+    // The tree must be freshly built and not modified afterwards. Until its write finishes, getPendingJson returns a
+    // copy of the newest tree for that path, so loaders never read an older file. Runs synchronously when async saving
+    // is disabled or shutting down.
+    public static CompletableFuture<Void> submitJson(final java.nio.file.Path path, final com.google.gson.JsonElement json, final java.util.function.Consumer<com.google.gson.JsonElement> writer) {
+        final java.nio.file.Path key = path.toAbsolutePath().normalize();
+        final CompletableFuture<Void> next;
+        synchronized (LIFECYCLE_LOCK) {
+            if (!AsyncPlayerDataSave.enabled || !accepting || playerIoPool == null) {
+                next = null;
+            } else {
+                final JsonFileState state = JSON_SAVES.computeIfAbsent(key, ignored -> new JsonFileState());
+                final CompletableFuture<Void> previous = state.tail;
+                next = (previous == null ? CompletableFuture.<Void>completedFuture(null) : previous.handle((ignored, throwable) -> null))
+                    .thenRunAsync(() -> writer.accept(json), playerIoPool);
+                state.latest = json;
+                state.tail = next;
+            }
+        }
+        if (next == null) {
+            return runSynchronously(() -> writer.accept(json));
+        }
+
+        next.whenComplete((ignored, throwable) -> {
+            synchronized (LIFECYCLE_LOCK) {
+                final JsonFileState state = JSON_SAVES.get(key);
+                if (state != null && state.tail == next) {
+                    JSON_SAVES.remove(key);
+                }
+            }
+        });
+        return next;
+    }
+
+    public static Optional<com.google.gson.JsonElement> getPendingJson(final java.nio.file.Path path) {
+        final java.nio.file.Path key = path.toAbsolutePath().normalize();
+        synchronized (LIFECYCLE_LOCK) {
+            final JsonFileState state = JSON_SAVES.get(key);
+            return state == null ? Optional.empty() : Optional.of(state.latest.deepCopy());
+        }
+    }
+    // Pyzh end - Write player stats and advancements off the main thread
+
     public static Optional<byte[]> getPendingPlayerData(final UUID uniqueId) {
         synchronized (LIFECYCLE_LOCK) {
             final PlayerSaveState state = PLAYER_SAVES.get(uniqueId);
@@ -127,12 +172,19 @@ public final class AsyncPlayerDataSaving {
             }
 
             accepting = false;
-            final ArrayList<CompletableFuture<Void>> pending = new ArrayList<>(PLAYER_SAVES.size() + 1);
+            final ArrayList<CompletableFuture<Void>> pending = new ArrayList<>(PLAYER_SAVES.size() + JSON_SAVES.size() + 1);
             for (final PlayerSaveState state : PLAYER_SAVES.values()) {
                 if (state.tail != null) {
                     pending.add(state.tail);
                 }
             }
+            // Pyzh start - Write player stats and advancements off the main thread
+            for (final JsonFileState state : JSON_SAVES.values()) {
+                if (state.tail != null) {
+                    pending.add(state.tail);
+                }
+            }
+            // Pyzh end - Write player stats and advancements off the main thread
             pending.add(levelTail);
             barrier = CompletableFuture.allOf(pending.toArray(CompletableFuture[]::new));
             playerExecutor = playerIoPool;
@@ -199,4 +251,10 @@ public final class AsyncPlayerDataSaving {
         private CompletableFuture<Void> tail;
         private byte[] latestSnapshot;
     }
+
+    // Pyzh - Write player stats and advancements off the main thread
+    private static final class JsonFileState {
+        private CompletableFuture<Void> tail;
+        private com.google.gson.JsonElement latest;
+    }
 }
