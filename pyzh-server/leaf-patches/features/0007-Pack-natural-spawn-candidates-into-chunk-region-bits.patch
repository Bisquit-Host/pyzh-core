From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Sun, 27 Sep 2026 12:36:19 +0300
Subject: [PATCH] Pack natural spawn candidates into chunk-region bitsets

Store one 64-bit mask per 8x8 chunk region instead of hashing each eligible chunk. Accumulate consecutive writes to the same region and enumerate its set bits directly against the loaded-chunk cache.

Preserve circular spawn ranges, player filtering, entity-ticking checks, and the nearest-player tree. The existing experimental optimize-mob-spawning setting still controls this path. Leaf's direct candidate collection is kept instead of scanning all loaded chunks.

diff --git a/java/org/dreeam/leaf/world/NatureSpawnChunkMap.java b/java/org/dreeam/leaf/world/NatureSpawnChunkMap.java
index 363da73c221ea457001bce3a1569e3d4590df1c3..a89787783c3e3c6f06441600e864094c5cb61f72 100644
--- a/java/org/dreeam/leaf/world/NatureSpawnChunkMap.java
+++ b/java/org/dreeam/leaf/world/NatureSpawnChunkMap.java
@@ -3,7 +3,7 @@ package org.dreeam.leaf.world;
 import ca.spottedleaf.moonrise.common.util.CoordinateUtils;
 import com.destroystokyo.paper.event.entity.PlayerNaturallySpawnCreaturesEvent;
 import it.unimi.dsi.fastutil.longs.LongArrayList;
-import it.unimi.dsi.fastutil.longs.LongOpenHashSet;
+import it.unimi.dsi.fastutil.longs.Long2LongOpenHashMap; // Pyzh - Pack spawn eligibility into 8x8 chunk regions.
 import net.minecraft.server.level.FullChunkStatus;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.server.level.ServerPlayer;
@@ -36,30 +36,46 @@ public final class NatureSpawnChunkMap {
     private static final double MAX_DIST = 16384.0;
 
     private final LongArrayList[] centersByRadius;
-    private final LongSet set;
+    private final RegionMap regions; // Pyzh - Pack spawn eligibility into 8x8 chunk regions.
     private final KDTree3D tree;
     private boolean ready;
 
-    private static final class LongSet extends LongOpenHashSet {
-        private long[] key() {
-            return this.key;
-        }
-
-        private boolean containsNull() {
-            return this.containsNull;
+    // Pyzh start - One bit per chunk; enumerate candidates without scanning all loaded chunks.
+    private static final class RegionMap extends Long2LongOpenHashMap {
+        private void collectSpawningChunks(final ChunkCache<LevelChunk> chunks, final List<LevelChunk> out) {
+            if (this.containsNullKey) {
+                collectRegion(chunks, out, 0L, this.value[this.n]);
+            }
+            for (int i = this.n; i-- > 0;) {
+                if (this.key[i] != 0L) {
+                    collectRegion(chunks, out, this.key[i], this.value[i]);
+                }
+            }
         }
 
-        private int n() {
-            return this.n;
+        private static void collectRegion(final ChunkCache<LevelChunk> chunks, final List<LevelChunk> out,
+                                          final long region, long bits) {
+            final int baseX = CoordinateUtils.getChunkX(region) << 3;
+            final int baseZ = CoordinateUtils.getChunkZ(region) << 3;
+            while (bits != 0L) {
+                final int bit = Long.numberOfTrailingZeros(bits);
+                bits &= bits - 1;
+                final long key = CoordinateUtils.getChunkKey(baseX + (bit & 7), baseZ + (bit >>> 3));
+                LevelChunk chunk = chunks.getMiss(key);
+                if (chunk != null && chunk.moonrise$getChunkHolder().getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
+                    out.add(chunk);
+                }
+            }
         }
     }
+    // Pyzh end - One bit per chunk
 
     public NatureSpawnChunkMap() {
         this.centersByRadius = new LongArrayList[SIZE_RADIUS];
         for (int i = 0; i < SIZE_RADIUS; i++) {
             this.centersByRadius[i] = new LongArrayList();
         }
-        this.set = new LongSet();
+        this.regions = new RegionMap(); // Pyzh - Pack spawn eligibility into 8x8 chunk regions.
         this.tree = new KDTree3D();
         this.ready = false;
     }
@@ -71,7 +87,7 @@ public final class NatureSpawnChunkMap {
         for (final LongArrayList center : this.centersByRadius) {
             center.clear();
         }
-        this.set.clear();
+        this.regions.clear(); // Pyzh - Pack spawn eligibility into 8x8 chunk regions.
         this.ready = false;
     }
 
@@ -91,16 +107,21 @@ public final class NatureSpawnChunkMap {
             buildBfs(index);
         }
         buildKdTree(world.purpurConfig.mobSpawningIgnoreCreativePlayers, players);
-        collectSpawningChunks(world.getChunkSource().fullChunksNonSync, this.set, out);
+        this.regions.collectSpawningChunks(world.getChunkSource().fullChunksNonSync, out); // Pyzh - Enumerate packed spawn candidates.
         this.ready = true;
     }
 
     private void buildBfs(final int index) {
         LongArrayList list = this.centersByRadius[index];
-        LongSet set = this.set;
         int size = deduplicate(list);
+        // Pyzh start - Accumulate nearby chunk bits before writing each region back to the map.
+        if (size == 0) {
+            return;
+        }
         long[] raw = list.elements();
         long[] offsets = TABLE_BFS[index];
+        long cachedRegion = CoordinateUtils.getChunkKey(CoordinateUtils.getChunkX(raw[0]) >> 3, CoordinateUtils.getChunkZ(raw[0]) >> 3);
+        long cachedBits = this.regions.get(cachedRegion);
         for (int i = 0; i < size; i++) {
             long center = raw[i];
             int cx = CoordinateUtils.getChunkX(center);
@@ -108,9 +129,19 @@ public final class NatureSpawnChunkMap {
             for (final long offset : offsets) {
                 int dx = CoordinateUtils.getChunkX(offset);
                 int dz = CoordinateUtils.getChunkZ(offset);
-                set.add(CoordinateUtils.getChunkKey(cx + dx, cz + dz));
+                int x = cx + dx;
+                int z = cz + dz;
+                long region = CoordinateUtils.getChunkKey(x >> 3, z >> 3);
+                if (region != cachedRegion) {
+                    this.regions.put(cachedRegion, cachedBits);
+                    cachedRegion = region;
+                    cachedBits = this.regions.get(region);
+                }
+                cachedBits |= 1L << ((z & 7) << 3 | (x & 7));
             }
         }
+        this.regions.put(cachedRegion, cachedBits);
+        // Pyzh end - Accumulate chunk bits
     }
 
     private static int deduplicate(final LongArrayList list) {
@@ -164,25 +195,4 @@ public final class NatureSpawnChunkMap {
         this.tree.build();
         // Pyzh end - Reuse tree buffers across ticks.
     }
-
-    private static void collectSpawningChunks(final ChunkCache<LevelChunk> chunks,
-                                              final LongSet set,
-                                              final List<LevelChunk> out) {
-        long[] key = set.key();
-        int n = set.n();
-        if (set.containsNull()) {
-            LevelChunk chunk = chunks.getMiss(key[n]);
-            if (chunk != null && chunk.moonrise$getChunkHolder().getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
-                out.add(chunk);
-            }
-        }
-        for (int pos = n; pos-- != 0; ) {
-            if ((key[pos]) != 0L) {
-                LevelChunk chunk = chunks.getMiss(key[pos]);
-                if (chunk != null && chunk.moonrise$getChunkHolder().getChunkStatus().isOrAfter(FullChunkStatus.ENTITY_TICKING)) {
-                    out.add(chunk);
-                }
-            }
-        }
-    }
 }
