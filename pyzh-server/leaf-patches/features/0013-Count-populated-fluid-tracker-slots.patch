From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:44:22 +0300
Subject: [PATCH] Count populated fluid tracker slots

Report the actual number of water and lava trackers in the map and its entry view, including empty and partially populated maps.

diff --git a/java/org/dreeam/leaf/util/map/TrackerByFluidMap.java b/java/org/dreeam/leaf/util/map/TrackerByFluidMap.java
index 09ba548a7ca3dcd6ae3edd43ceabedc53fde5b27..60367b0949cc63ff890c2e15362bb7bb80ad7ac4 100644
--- a/java/org/dreeam/leaf/util/map/TrackerByFluidMap.java
+++ b/java/org/dreeam/leaf/util/map/TrackerByFluidMap.java
@@ -20,7 +20,7 @@ public final class TrackerByFluidMap extends AbstractReference2ObjectMap<TagKey<
 
     @Override
     public int size() {
-        return 2;
+        return (water == null ? 0 : 1) + (lava == null ? 0 : 1);
     }
 
     @Override
@@ -75,7 +75,7 @@ public final class TrackerByFluidMap extends AbstractReference2ObjectMap<TagKey<
 
         @Override
         public int size() {
-            return 2;
+            return TrackerByFluidMap.this.size();
         }
 
         @Override
