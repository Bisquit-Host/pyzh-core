From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:47:36 +0300
Subject: [PATCH] Correct attribute map and entry hash codes

Use the sum of holder-keyed entry hashes so equal ordinary maps and entries have equal hashes.

diff --git a/java/org/dreeam/leaf/util/map/AttributeInstanceArrayMap.java b/java/org/dreeam/leaf/util/map/AttributeInstanceArrayMap.java
index 2740cbad1f2002a0a84e230f4783f18d46515235..54daaf3cc133c5176fc27e9917fbb8de479ace63 100644
--- a/java/org/dreeam/leaf/util/map/AttributeInstanceArrayMap.java
+++ b/java/org/dreeam/leaf/util/map/AttributeInstanceArrayMap.java
@@ -147,7 +147,13 @@ public final class AttributeInstanceArrayMap implements Map<Holder<Attribute>, A
 
     @Override
     public int hashCode() {
-        return Arrays.hashCode(a);
+        int hash = 0;
+        for (int i = 0; i < a.length; i++) {
+            if (a[i] != null) {
+                hash += RegistryTypeManager.ATTRIBUTE[i].hashCode() ^ a[i].hashCode();
+            }
+        }
+        return hash;
     }
 
     @Override
@@ -334,7 +340,7 @@ public final class AttributeInstanceArrayMap implements Map<Holder<Attribute>, A
 
         @Override
         public int hashCode() {
-            return Objects.hashCode(key) ^ Objects.hashCode(value);
+            return getKey().hashCode() ^ Objects.hashCode(value);
         }
 
         @Override
