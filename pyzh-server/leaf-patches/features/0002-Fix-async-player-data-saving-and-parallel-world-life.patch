diff --git a/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java b/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
index 7b423a401263c8a61b19dbc5c13cb9952a7b09b9..f969cdd81d3e4310e851f236180e7a0e5c3723ce 100644
