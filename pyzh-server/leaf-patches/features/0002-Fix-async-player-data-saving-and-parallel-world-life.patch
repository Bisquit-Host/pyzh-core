@@ -1,48 +1,202 @@
 package org.dreeam.leaf.async;
 
 import net.minecraft.util.Util;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
 import org.dreeam.leaf.config.modules.async.AsyncPlayerDataSave;
 
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.Map;
 import java.util.Optional;
+import java.util.UUID;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ExecutionException;
 import java.util.concurrent.ExecutorService;
-import java.util.concurrent.Future;
 import java.util.concurrent.LinkedBlockingQueue;
+import java.util.concurrent.RejectedExecutionException;
 import java.util.concurrent.ThreadPoolExecutor;
 import java.util.concurrent.TimeUnit;
+import java.util.concurrent.TimeoutException;
+import java.util.concurrent.atomic.AtomicInteger;
 
-public class AsyncPlayerDataSaving {
+public final class AsyncPlayerDataSaving {
 
-    public static ExecutorService IO_POOL = null;
+    private static final Logger LOGGER = LogManager.getLogger("Leaf");
+    private static final Object LIFECYCLE_LOCK = new Object();
+    private static final Map<UUID, PlayerSaveState> PLAYER_SAVES = new HashMap<>();
+    private static final AtomicInteger PLAYER_THREAD_COUNTER = new AtomicInteger();
+    private static ExecutorService playerIoPool;
+    private static ExecutorService levelIoPool;
+    private static CompletableFuture<Void> levelTail = CompletableFuture.completedFuture(null);
+    private static boolean accepting;
 
     private AsyncPlayerDataSaving() {
     }
 
     public static void init() {
-        if (IO_POOL == null) {
-            IO_POOL = new ThreadPoolExecutor(
-                1,
-                1,
-                0L, TimeUnit.MILLISECONDS,
-                new LinkedBlockingQueue<>(),
-                new com.google.common.util.concurrent.ThreadFactoryBuilder()
-                    .setPriority(Thread.NORM_PRIORITY - 2)
-                    .setNameFormat("Leaf IO Thread")
-                    .setUncaughtExceptionHandler(Util::onThreadException)
-                    .build(),
-                new ThreadPoolExecutor.DiscardPolicy()
-            );
-        } else {
-            // Temp no-op
-            //throw new IllegalStateException();
-        }
-    }
-
-    public static Optional<Future<?>> submit(Runnable runnable) {
+        synchronized (LIFECYCLE_LOCK) {
+            if (playerIoPool != null) {
+                return;
+            }
+
+            playerIoPool = createPool(1, runnable -> new Thread(runnable, "Leaf Player IO Thread-" + PLAYER_THREAD_COUNTER.incrementAndGet()));
+            levelIoPool = createPool(1, runnable -> new Thread(runnable, "Leaf Level IO Thread"));
+            accepting = true;
+        }
+    }
+
+    private static ExecutorService createPool(final int threads, final java.util.function.Function<Runnable, Thread> threadFactory) {
+        return new ThreadPoolExecutor(
+            threads,
+            threads,
+            0L,
+            TimeUnit.MILLISECONDS,
+            new LinkedBlockingQueue<>(),
+            runnable -> {
+                final Thread thread = threadFactory.apply(runnable);
+                thread.setPriority(Thread.NORM_PRIORITY - 2);
+                thread.setUncaughtExceptionHandler(Util::onThreadException);
+                return thread;
+            },
+            new ThreadPoolExecutor.AbortPolicy()
+        );
+    }
+
+    public static CompletableFuture<Void> submitPlayer(final UUID uniqueId, final byte[] encodedData, final java.util.function.Consumer<byte[]> writer) {
+        final byte[] snapshot = Arrays.copyOf(encodedData, encodedData.length);
         if (!AsyncPlayerDataSave.enabled) {
-            runnable.run();
-            return Optional.empty();
-        } else {
-            return Optional.of(IO_POOL.submit(runnable));
+            return runSynchronously(() -> writer.accept(snapshot));
+        }
+
+        final CompletableFuture<Void> next;
+        synchronized (LIFECYCLE_LOCK) {
+            if (!accepting || playerIoPool == null) {
+                return CompletableFuture.failedFuture(new RejectedExecutionException("Player data saving is shutting down"));
+            }
+
+            final PlayerSaveState state = PLAYER_SAVES.computeIfAbsent(uniqueId, ignored -> new PlayerSaveState());
+            final CompletableFuture<Void> previous = state.tail;
+            next = (previous == null ? CompletableFuture.<Void>completedFuture(null) : previous.handle((ignored, throwable) -> null))
+                .thenRunAsync(() -> writer.accept(snapshot), playerIoPool);
+            state.latestSnapshot = snapshot;
+            state.tail = next;
+        }
+
+        next.whenComplete((ignored, throwable) -> {
+            synchronized (LIFECYCLE_LOCK) {
+                final PlayerSaveState state = PLAYER_SAVES.get(uniqueId);
+                if (state != null && state.tail == next) {
+                    PLAYER_SAVES.remove(uniqueId);
+                }
+            }
+        });
+        return next;
+    }
+
+    public static CompletableFuture<Void> submitLevel(final Runnable writer) {
+        if (!AsyncPlayerDataSave.enabled) {
+            return runSynchronously(writer);
+        }
+
+        synchronized (LIFECYCLE_LOCK) {
+            if (!accepting || levelIoPool == null) {
+                return CompletableFuture.failedFuture(new RejectedExecutionException("Level data saving is shutting down"));
+            }
+
+            levelTail = levelTail.handle((ignored, throwable) -> null).thenRunAsync(writer, levelIoPool);
+            return levelTail;
+        }
+    }
+
+    public static Optional<byte[]> getPendingPlayerData(final UUID uniqueId) {
+        synchronized (LIFECYCLE_LOCK) {
+            final PlayerSaveState state = PLAYER_SAVES.get(uniqueId);
+            return state == null ? Optional.empty() : Optional.of(Arrays.copyOf(state.latestSnapshot, state.latestSnapshot.length));
+        }
+    }
+
+    public static void shutdownAndAwait() {
+        final CompletableFuture<Void> barrier;
+        final ExecutorService playerExecutor;
+        final ExecutorService levelExecutor;
+        synchronized (LIFECYCLE_LOCK) {
+            if (playerIoPool == null) {
+                return;
+            }
+
+            accepting = false;
+            final ArrayList<CompletableFuture<Void>> pending = new ArrayList<>(PLAYER_SAVES.size() + 1);
+            for (final PlayerSaveState state : PLAYER_SAVES.values()) {
+                if (state.tail != null) {
+                    pending.add(state.tail);
+                }
+            }
+            pending.add(levelTail);
+            barrier = CompletableFuture.allOf(pending.toArray(CompletableFuture[]::new));
+            playerExecutor = playerIoPool;
+            levelExecutor = levelIoPool;
         }
+
+        awaitBarrier(barrier);
+        playerExecutor.shutdown();
+        levelExecutor.shutdown();
+        awaitTermination(playerExecutor, "player");
+        awaitTermination(levelExecutor, "level");
+    }
+
+    private static CompletableFuture<Void> runSynchronously(final Runnable writer) {
+        try {
+            writer.run();
+            return CompletableFuture.completedFuture(null);
+        } catch (Throwable throwable) {
+            return CompletableFuture.failedFuture(throwable);
+        }
+    }
+
+    private static void awaitBarrier(final CompletableFuture<Void> barrier) {
+        boolean interrupted = false;
+        while (true) {
+            try {
+                barrier.get(30L, TimeUnit.SECONDS);
+                break;
+            } catch (final InterruptedException ex) {
+                interrupted = true;
+            } catch (final TimeoutException ex) {
+                final int pendingPlayers;
+                synchronized (LIFECYCLE_LOCK) {
+                    pendingPlayers = PLAYER_SAVES.size();
+                }
+                LOGGER.warn("Still waiting for asynchronous persistence tasks to finish ({} player keys pending)", pendingPlayers);
+            } catch (final ExecutionException ex) {
+                LOGGER.error("An asynchronous persistence task failed during shutdown", ex.getCause() == null ? ex : ex.getCause());
+                break;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static void awaitTermination(final ExecutorService executor, final String type) {
+        boolean interrupted = false;
+        while (!executor.isTerminated()) {
+            try {
+                if (!executor.awaitTermination(30L, TimeUnit.SECONDS)) {
+                    LOGGER.warn("Still waiting for the {} data I/O executor to terminate", type);
+                }
+            } catch (final InterruptedException ex) {
+                interrupted = true;
+            }
+        }
+        if (interrupted) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static final class PlayerSaveState {
+        private CompletableFuture<Void> tail;
+        private byte[] latestSnapshot;
     }
 }
