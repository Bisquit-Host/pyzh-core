From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:44:22 +0300
Subject: [PATCH] Reload Leaf config between ticks with protocol snapshots

Queue reload work for the MinecraftServer tick-boundary hand-off, after previous world jobs finish. Publish immutable protocol lists through a volatile reference so encoders can finish reading an old registration snapshot safely.

diff --git a/java/org/dreeam/leaf/config/LeafConfig.java b/java/org/dreeam/leaf/config/LeafConfig.java
index f4e9cc0086ec604721d340329f1520adcfd2bc13..6c8a1171db61e7ff338f3f6725defb21495fd460 100644
--- a/java/org/dreeam/leaf/config/LeafConfig.java
+++ b/java/org/dreeam/leaf/config/LeafConfig.java
@@ -3,7 +3,6 @@ package org.dreeam.leaf.config;
 import io.papermc.paper.SparksFly;
 import net.kyori.adventure.text.Component;
 import net.kyori.adventure.text.format.NamedTextColor;
-import net.minecraft.util.Util;
 import org.apache.logging.log4j.LogManager;
 import org.apache.logging.log4j.Logger;
 import org.dreeam.leaf.config.modules.misc.SentryDSN;
@@ -31,8 +30,10 @@ import java.util.Enumeration;
 import java.util.LinkedHashSet;
 import java.util.List;
 import java.util.Locale;
+import java.util.Queue;
 import java.util.Set;
 import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.ConcurrentLinkedQueue;
 import java.util.jar.JarEntry;
 import java.util.jar.JarFile;
 
@@ -59,6 +60,7 @@ public class LeafConfig {
     private static final String SPARK_HIDDEN_PATHS_PROPERTY =  "spark.serverconfigs.hiddenpaths";
 
     private static LeafGlobalConfig globalConfig;
+    private static final Queue<Runnable> RELOAD_TASKS = new ConcurrentLinkedQueue<>();
 
     //private static int preMajorVer;
     private static int preMinorVer;
@@ -67,7 +69,7 @@ public class LeafConfig {
 
     /* Load & Reload */
 
-    // Reload config (async)
+    // Apply reloads between ticks, never through the executor that also runs mid-tick tasks.
     public static CompletableFuture<Void> reloadAsync(CommandSender sender) {
         return CompletableFuture.runAsync(() -> {
             try {
@@ -83,7 +85,14 @@ public class LeafConfig {
                 Command.broadcastCommandMessage(sender, Component.text("Failed to reload config. See error in console!", NamedTextColor.RED));
                 LOGGER.error("Failed to reload config!", e);
             }
-        }, Util.ioPool());
+        }, RELOAD_TASKS::add);
+    }
+
+    public static void runPendingReloads() {
+        Runnable task;
+        while ((task = RELOAD_TASKS.poll()) != null) {
+            task.run();
+        }
     }
 
     // Init config
diff --git a/java/org/dreeam/leaf/protocol/Protocols.java b/java/org/dreeam/leaf/protocol/Protocols.java
index b47e7c61d432f7520e4cc020f1b4fbd3971e9028..8a3a62a3c27b13ec1ff06a03c40bba3a8575acec 100644
--- a/java/org/dreeam/leaf/protocol/Protocols.java
+++ b/java/org/dreeam/leaf/protocol/Protocols.java
@@ -1,7 +1,6 @@
 package org.dreeam.leaf.protocol;
 
 import io.netty.buffer.Unpooled;
-import it.unimi.dsi.fastutil.objects.ObjectArrayList;
 import net.minecraft.network.FriendlyByteBuf;
 import net.minecraft.network.codec.StreamCodec;
 import net.minecraft.network.protocol.common.ClientboundCustomPayloadPacket;
@@ -11,19 +10,27 @@ import net.minecraft.server.level.ServerPlayer;
 import org.jetbrains.annotations.Contract;
 import org.jspecify.annotations.Nullable;
 
+import java.util.ArrayList;
+import java.util.List;
+
 public final class Protocols {
 
     private Protocols() {
     }
 
-    private static final ObjectArrayList<Protocol> PROTOCOLS = new ObjectArrayList<>();
+    private static volatile List<Protocol> PROTOCOLS = List.of();
 
-    static void register(Protocol protocol) {
-        PROTOCOLS.add(protocol);
+    static synchronized void register(Protocol protocol) {
+        List<Protocol> protocols = new ArrayList<>(PROTOCOLS);
+        protocols.add(protocol);
+        PROTOCOLS = List.copyOf(protocols);
     }
 
-    static void unregister(Protocol protocol) {
-        PROTOCOLS.remove(protocol);
+    static synchronized void unregister(Protocol protocol) {
+        List<Protocol> protocols = new ArrayList<>(PROTOCOLS);
+        if (protocols.remove(protocol)) {
+            PROTOCOLS = List.copyOf(protocols);
+        }
     }
 
     public record TypeAndCodec<B extends FriendlyByteBuf, T extends LeafCustomPayload>(LeafCustomPayload.Type<T> type,
