From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:44:22 +0300
Subject: [PATCH] Avoid copying NBT for synchronous player saves

Pass the caller's tag directly to the synchronous writer. Retain the owning-thread snapshot for asynchronous submissions so later caller mutations cannot change a queued save.

diff --git a/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java b/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
index f7ba51904b0dc9b408fc146deee0496905f937cd..72e12e62c3161006b591349f29b949f0a48d6f51 100644
--- a/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
+++ b/java/org/dreeam/leaf/async/AsyncPlayerDataSaving.java
@@ -66,13 +66,13 @@ public final class AsyncPlayerDataSaving {
         );
     }
 
-    // Pyzh - Snapshot NBT on its owning thread; compression and file replacement run in the writer.
+    // Pyzh - Snapshot NBT on its owning thread before handing it to an async writer.
     public static CompletableFuture<Void> submitPlayer(final UUID uniqueId, final CompoundTag data, final java.util.function.Consumer<CompoundTag> writer) {
-        final CompoundTag snapshot = data.copy();
         if (!AsyncPlayerDataSave.enabled) {
-            return runSynchronously(() -> writer.accept(snapshot));
+            return runSynchronously(() -> writer.accept(data));
         }
 
+        final CompoundTag snapshot = data.copy();
         synchronized (LIFECYCLE_LOCK) {
             if (!accepting || playerIoPool == null) {
                 return CompletableFuture.failedFuture(new RejectedExecutionException("Player data saving is shutting down"));
