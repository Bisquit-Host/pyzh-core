index 0000000000000000000000000000000000000000..118ab74937fc79cacdbf5e7223a915700beb1bea
--- /dev/null
+++ b/java/ru/turbovadim/pyzh/io/CoalescingSaveQueue.java
@@ -0,0 +1,123 @@
+package ru.turbovadim.pyzh.io;
+
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Optional;
+import java.util.concurrent.CompletableFuture;
+import java.util.concurrent.Executor;
+import java.util.function.Consumer;
+import org.jspecify.annotations.Nullable;
+
+/**
+ * Keeps one active write and the newest pending snapshot per key. Superseded submissions finish with
+ * the write that replaces them. Snapshots and writers must not mutate data exposed by {@link #latest}.
+ */
+public final class CoalescingSaveQueue<K, V> {
+    private final Executor executor;
+    private final Map<K, State<V>> states = new HashMap<>();
+
+    public CoalescingSaveQueue(final Executor executor) {
+        this.executor = executor;
+    }
+
+    public CompletableFuture<Void> submit(final K key, final V snapshot, final Consumer<V> writer) {
+        final State<V> state;
+        final CompletableFuture<Void> completion;
+        final boolean schedule;
+        synchronized (this) {
+            final State<V> existing = this.states.get(key);
+            schedule = existing == null;
+            if (schedule) {
+                completion = new CompletableFuture<>();
+                state = new State<>(new Save<>(snapshot, writer, completion));
+                this.states.put(key, state);
+            } else {
+                state = existing;
+                completion = state.pending == null ? new CompletableFuture<>() : state.pending.completion;
+                state.pending = new Save<>(snapshot, writer, completion);
+            }
+        }
+        if (schedule) {
+            this.schedule(key, state);
+        }
+        // A caller cancelling its own future must not cancel persistence or the shutdown barrier.
+        return completion.copy();
+    }
+
+    public synchronized Optional<V> latest(final K key) {
+        final State<V> state = this.states.get(key);
+        return state == null ? Optional.empty() : Optional.of((state.pending == null ? state.active : state.pending).snapshot);
+    }
+
+    public synchronized CompletableFuture<Void> drain() {
+        return CompletableFuture.allOf(this.states.values().stream().map(state -> state.drained).toArray(CompletableFuture[]::new));
+    }
+
+    public synchronized CompletableFuture<Void> drain(final K key) {
+        final State<V> state = this.states.get(key);
+        return state == null ? CompletableFuture.completedFuture(null) : state.drained.copy();
+    }
+
+    public synchronized int pendingKeys() {
+        return this.states.size();
+    }
+
+    private void schedule(final K key, final State<V> state) {
+        try {
+            this.executor.execute(() -> this.write(key, state));
+        } catch (final RuntimeException failure) {
+            final Save<V> pending;
+            synchronized (this) {
+                this.states.remove(key, state);
+                pending = state.pending;
+                state.pending = null;
+            }
+            state.active.completion.completeExceptionally(failure);
+            if (pending != null) pending.completion.completeExceptionally(failure);
+            state.drained.completeExceptionally(failure);
+        }
+    }
+
+    private void write(final K key, final State<V> state) {
+        final Save<V> save = state.active;
+        Throwable failure = null;
+        try {
+            save.writer.accept(save.snapshot);
+        } catch (final Throwable throwable) {
+            failure = throwable;
+        }
+
+        final boolean more;
+        synchronized (this) {
+            more = state.pending != null;
+            if (more) {
+                state.active = state.pending;
+                state.pending = null;
+            } else {
+                this.states.remove(key, state);
+            }
+        }
+        if (failure == null) save.completion.complete(null);
+        else save.completion.completeExceptionally(failure);
+
+        if (more) {
+            this.schedule(key, state); // Requeue behind other keys so a busy player cannot monopolize I/O.
+        } else if (failure == null) {
+            state.drained.complete(null);
+        } else {
+            state.drained.completeExceptionally(failure);
+        }
+    }
+
+    private record Save<V>(V snapshot, Consumer<V> writer, CompletableFuture<Void> completion) {}
+
+    private static final class State<V> {
+        private Save<V> active;
+        private @Nullable Save<V> pending;
+        private final CompletableFuture<Void> drained = new CompletableFuture<>();
+
+        private State(final Save<V> active) {
+            this.active = active;
+        }
+    }
+}
