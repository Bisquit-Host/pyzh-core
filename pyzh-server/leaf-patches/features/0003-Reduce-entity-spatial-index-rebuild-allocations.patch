     private static final boolean ENABLE_FMA = LeafConstants.ENABLE_FMA;
 
     private static final int INITIAL_CAPACITY = 8;
@@ -12,7 +11,6 @@ public final class KDTree2D {
     /// indicate empty on [#search]
     /// indicate leaf node on [#nrl]
     private static final int SENTINEL = -1;
-    private Node[] stack = EMPTY_NODES;
     private int[] search = EMPTY_INTS;
     /// [#SENTINEL] for leaf / right node index for internal
     private int[] nrl = EMPTY_INTS;
@@ -22,49 +20,70 @@ public final class KDTree2D {
     private double[] nyl = EMPTY_DOUBLES;
     // index for leaf
     private int[] nil = EMPTY_INTS;
+    // Pyzh - Reuse point and index buffers across rebuilds.
+    private final double[][] points = {EMPTY_DOUBLES, EMPTY_DOUBLES};
+    private int[] indices = EMPTY_INTS;
+    private int size;
 
     public void build(final double[][] coords, final int[] indices) {
-        if (indices.length == 0 || coords.length != 2) {
-            ensureSearch(0, 0);
+        this.clear();
+        for (int i = 0; i < indices.length; i++) {
+            this.add(coords[0][i], coords[1][i]);
+        }
+        this.build();
+    }
+
+    // Pyzh - Fill with add() between clear() and build() so rebuilds reuse buffers.
+    public void clear() {
+        this.size = 0;
+    }
+
+    /// [#nearestIdx] identifies points by the order they were added since [#clear].
+    public void add(final double x, final double y) {
+        if (size == indices.length) {
+            growPoints();
+        }
+        points[0][size] = x;
+        points[1][size] = y;
+        size++;
+    }
+
+    public void build() {
+        ensureSearch(0, 0); // Queries see an empty tree if construction fails.
+        if (size == 0) {
             return;
         }
-        for (int i = 0; i < indices.length; i++) {
+        for (int i = 0; i < size; i++) {
             indices[i] = i;
         }
 
-        int st = 0;
-        ensureConstruct(st);
-        stack[st++] = new Node(SENTINEL, false, 0, indices.length, 0);
-        int nodeLen = 0;
-        while (st != 0) {
-            ensureNode(nodeLen);
-            final Node n = stack[--st];
-            final int curr = nodeLen++;
-            if (n.len() <= 1) {
-                final int p = indices[n.offset()];
-                nrl[curr] = SENTINEL;
-                nxl[curr] = coords[0][p];
-                nyl[curr] = coords[1][p];
-                nil[curr] = p;
-            } else {
-                final int axis = (n.depth()) % 2;
-                final int med = (n.len() - 1) / 2;
-                final int k = n.offset() + med;
-                final double[] coord = coords[axis];
-                PartialSort.nthElement(indices, coord, n.offset(), n.offset() + n.len() - 1, k);
-
-                nxl[curr] = coord[indices[k]];
+        final int nodeCount = 2 * size - 1;
+        ensureNodeCapacity(nodeCount);
+        buildNode(0, size, 0, 0);
+        ensureSearch(size, nodeCount);
+    }
 
-                ensureConstruct(st);
-                stack[st++] = new Node(curr, false, n.offset() + med + 1, n.len() - med - 1, n.depth() + 1);
-                stack[st++] = new Node(curr, true, n.offset(), med + 1, n.depth() + 1);
-            }
-            if (n.parent() != SENTINEL) {
-                nrl[n.parent()] = n.left() ? SENTINEL : curr;
-            }
+    // Pyzh - Balanced recursion has logarithmic depth and avoids a temporary object per tree node.
+    private void buildNode(final int offset, final int count, final int axis, final int node) {
+        if (count == 1) {
+            final int point = indices[offset];
+            nrl[node] = SENTINEL;
+            nxl[node] = points[0][point];
+            nyl[node] = points[1][point];
+            nil[node] = point;
+            return;
         }
 
-        ensureSearch(indices.length, nodeLen);
+        final int leftCount = (count + 1) >>> 1;
+        final int median = offset + leftCount - 1;
+        PartialSort.nthElement(indices, points[axis], offset, offset + count - 1, median);
+        nxl[node] = points[axis][indices[median]];
+        // A subtree with n points occupies 2n - 1 nodes; the right subtree follows the left.
+        final int right = node + 2 * leftCount;
+        nrl[node] = right;
+        final int nextAxis = axis == 1 ? 0 : axis + 1;
+        buildNode(offset, leftCount, nextAxis, node + 1);
+        buildNode(offset + leftCount, count - leftCount, nextAxis, right);
     }
 
     private void ensureSearch(final int length, final int nodeLen) {
@@ -74,29 +93,23 @@ public final class KDTree2D {
         search[0] = length == 0 ? SENTINEL : 0;
     }
 
-    private void ensureConstruct(final int st) {
-        if (st != stack.length && st + 1 != stack.length) {
-            return;
+    private void growPoints() {
+        final int capacity = Math.max(INITIAL_CAPACITY, size + (size >> 1));
+        for (int axis = 0; axis < points.length; axis++) {
+            points[axis] = java.util.Arrays.copyOf(points[axis], capacity);
         }
-        final int newLen = stack.length + 2;
-        final Node[] b = new Node[Math.max(INITIAL_CAPACITY, newLen + (newLen >> 1))];
-        System.arraycopy(stack, 0, b, 0, st);
-        stack = b;
+        indices = new int[capacity];
     }
 
-    private void ensureNode(final int preserve) {
-        int length = preserve + 1;
-        if (length < nrl.length) {
+    private void ensureNodeCapacity(final int required) {
+        if (nrl.length >= required) {
             return;
         }
-        length += length >> 1;
-        if (length < INITIAL_CAPACITY) {
-            length = INITIAL_CAPACITY;
-        }
-        nrl = it.unimi.dsi.fastutil.ints.IntArrays.forceCapacity(nrl, length, preserve);
-        nxl = it.unimi.dsi.fastutil.doubles.DoubleArrays.forceCapacity(nxl, length, preserve);
-        nyl = it.unimi.dsi.fastutil.doubles.DoubleArrays.forceCapacity(nyl, length, preserve);
-        nil = it.unimi.dsi.fastutil.ints.IntArrays.forceCapacity(nil, length, preserve);
+        final int capacity = Math.max(INITIAL_CAPACITY, required + (required >> 1));
+        nrl = new int[capacity];
+        nxl = new double[capacity];
+        nyl = new double[capacity];
+        nil = new int[capacity];
     }
 
     private static double euclideanDistanceSquared(double dx, double dy) {
@@ -253,6 +266,4 @@ public final class KDTree2D {
         return nearest;
     }
 
-    private record Node(int parent, boolean left, int offset, int len, int depth) {
-    }
 }
