From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:40:49 +0300
Subject: [PATCH] Make five vanilla bug fixes optional by default

Expose separate default-off flags for MC-17876, MC-65198, MC-200418, MC-223153 and MC-299642 so the Minecraft patch can preserve Paper defaults.

diff --git a/java/org/dreeam/leaf/config/modules/fixes/MCBugFix.java b/java/org/dreeam/leaf/config/modules/fixes/MCBugFix.java
index acf24c52de9a56c77517f104922e65fe67c0202f..da031bcc88d4f667f09f2fb0beb93311cdf4187e 100644
--- a/java/org/dreeam/leaf/config/modules/fixes/MCBugFix.java
+++ b/java/org/dreeam/leaf/config/modules/fixes/MCBugFix.java
@@ -17,6 +17,11 @@ public class MCBugFix extends ConfigModule {
     public static boolean mc301114 = false;
     public static int mc301114maxCombatEntries = 10240;
     public static boolean mc152094 = false;
+    public static boolean mc17876 = false;
+    public static boolean mc65198 = false;
+    public static boolean mc200418 = false;
+    public static boolean mc223153 = false;
+    public static boolean mc299642 = false;
 
     @Override
     public void onLoaded() {
@@ -24,6 +29,16 @@ public class MCBugFix extends ConfigModule {
             "Fixes for vanilla Minecraft bugs.",
             "针对 Minecraft 原版的漏洞修复。"
         );
+        mc17876 = globalConfig.getBoolean(basePath() + ".mc-17876", mc17876,
+            "Preserve health above maximum health when loading entities.");
+        mc65198 = globalConfig.getBoolean(basePath() + ".mc-65198", mc65198,
+            "Count the full crafted stack in crafting statistics, including shift-click results.");
+        mc200418 = globalConfig.getBoolean(basePath() + ".mc-200418", mc200418,
+            "Dismount baby villagers from chickens after curing.");
+        mc223153 = globalConfig.getBoolean(basePath() + ".mc-223153", mc223153,
+            "Use copper sounds for raw copper blocks.");
+        mc299642 = globalConfig.getBoolean(basePath() + ".mc-299642", mc299642,
+            "Stop turtles with NoGravity from swimming vertically outside water.");
         mc270656 = globalConfig.getBoolean(basePath() + ".mc-270656", mc270656, globalConfig.pickStringRegionBased(
             """
                 Whether to fix incorrect granting of 'Who needs rockets?' advancement.
