From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 16 Nov 2026 23:44:52 +0300
Subject: [PATCH] Fall back to Paper despawning for cylinder ranges

The spatial despawn tree uses spherical distance. Decline non-ellipsoid shapes so the existing per-entity path applies the configured geometry.

diff --git a/java/org/dreeam/leaf/world/DespawnMap.java b/java/org/dreeam/leaf/world/DespawnMap.java
index 3e21ec2b8d68e486a8e52971f3080f260fb2b79f..ef061c9787fd92332add3dd5a0632ab6731990b2 100644
--- a/java/org/dreeam/leaf/world/DespawnMap.java
+++ b/java/org/dreeam/leaf/world/DespawnMap.java
@@ -1,6 +1,7 @@
 package org.dreeam.leaf.world;
 
 import io.papermc.paper.configuration.WorldConfiguration;
+import io.papermc.paper.configuration.type.DespawnRange;
 import net.minecraft.server.level.ServerLevel;
 import net.minecraft.server.level.ServerPlayer;
 import net.minecraft.world.Difficulty;
@@ -29,7 +30,8 @@ public final class DespawnMap implements Consumer<Entity> {
     private boolean difficultyIsPeaceful = true;
 
     public boolean tick(final ServerLevel world, final EntityTickList entityTickList) {
-        if (!org.dreeam.leaf.config.modules.opt.OptimizeDespawn.enabled) {
+        if (!org.dreeam.leaf.config.modules.opt.OptimizeDespawn.enabled
+            || world.paperConfig().entities.spawning.despawnRangeShape != DespawnRange.Shape.ELLIPSOID) {
             return false;
         }
         for (int i = 0; i < CATEGORIES.length; i++) {
