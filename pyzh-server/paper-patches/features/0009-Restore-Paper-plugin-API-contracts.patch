     @Override
     public void setContents(ItemStack[] items) {
-        // Preconditions.checkArgument(items.length <= this.getSize(), "Invalid inventory size (%s); expected %s or less", items.length, this.getSize()); // Purpur - Barrels and enderchests 6 rows
+        int capacity = this.getSize();
+        if (org.purpurmc.purpur.PurpurConfig.enderChestSixRows && this.getInventory() instanceof PlayerEnderChestContainer) {
+            capacity = Math.max(capacity, this.getInventory().getContents().size());
+        }
+        Preconditions.checkArgument(items.length <= capacity, "Invalid inventory size (%s); expected %s or less", items.length, capacity);
 
         for (int i = 0; i < this.getSize(); i++) {
             if (i >= items.length) {
