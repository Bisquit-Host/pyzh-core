From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Tue, 21 Jul 2026 04:35:00 +0300
Subject: [PATCH] Harden parallel world lifecycle boundaries

Serialize world unload with the server barrier, refuse unsafe cross-world worker teleports, defer plugin respawns, and keep global scheduler work on the main thread. Also finish migration, offline-flight, and buffered-read corrections.

diff --git a/src/main/java/io/papermc/paper/world/PaperWorldLoader.java b/src/main/java/io/papermc/paper/world/PaperWorldLoader.java
index 1bf392bac..3239938a2 100644
--- a/src/main/java/io/papermc/paper/world/PaperWorldLoader.java
+++ b/src/main/java/io/papermc/paper/world/PaperWorldLoader.java
@@ -58,7 +58,7 @@ public record PaperWorldLoader(MinecraftServer server, String levelId) {
         final String defaultName = defaultWorldName(this.levelId, info.stemKey());
 
         try {
-            WorldFolderMigration.migrateStartupWorld(this.server.storageSource, this.server.registryAccess(), defaultName, info.stemKey(), info.dimensionKey());
+            WorldFolderMigration.migrateStartupWorld(this.server.storageSource, this.server.registryAccess(), defaultName, info.stemKey(), info.dimensionKey(), () -> !this.server.isRunning());
         } catch (final IOException ex) {
             throw new RuntimeException("Failed to migrate world storage for " + defaultName, ex);
         }
diff --git a/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java b/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
index c7a1a3a6a..399527a08 100644
--- a/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
+++ b/src/main/java/io/papermc/paper/world/migration/WorldFolderMigration.java
@@ -6,6 +6,8 @@ import io.papermc.paper.world.saveddata.PaperWorldMetadata;
 import java.io.IOException;
 import java.nio.file.Files;
 import java.nio.file.Path;
+import java.util.concurrent.CancellationException;
+import java.util.function.BooleanSupplier;
 import net.minecraft.core.HolderLookup;
 import net.minecraft.resources.ResourceKey;
 import net.minecraft.world.level.Level;
@@ -38,11 +40,22 @@ public final class WorldFolderMigration {
         final String worldName,
         final ResourceKey<LevelStem> stemKey,
         final ResourceKey<Level> dimensionKey
+    ) throws IOException {
+        migrateStartupWorld(rootAccess, registryAccess, worldName, stemKey, dimensionKey, () -> false);
+    }
+
+    public static void migrateStartupWorld(
+        final LevelStorageSource.LevelStorageAccess rootAccess,
+        final HolderLookup.Provider registryAccess,
+        final String worldName,
+        final ResourceKey<LevelStem> stemKey,
+        final ResourceKey<Level> dimensionKey,
+        final BooleanSupplier shutdownRequested
     ) throws IOException {
         final WorldMigrationContext context = new WorldMigrationContext(rootAccess, registryAccess, worldName, stemKey, dimensionKey);
         final MigrationMode mode = classifyStartupMigration(context);
-        if (mode != MigrationMode.NO_OP) {
-            warnAndDelayStartupMigration();
+        if (mode != MigrationMode.NO_OP && !warnAndDelayStartupMigration(shutdownRequested)) {
+            throw new CancellationException("Startup world migration cancelled for " + worldName + " because server shutdown was requested");
         }
         switch (mode) {
             case LEGACY_CRAFTBUKKIT_MIGRATION -> LegacyCraftBukkitWorldMigration.migrate(context);
@@ -62,8 +75,12 @@ public final class WorldFolderMigration {
     }
 
     public static synchronized void warnAndDelayStartupMigration() {
+        warnAndDelayStartupMigration(() -> false);
+    }
+
+    private static synchronized boolean warnAndDelayStartupMigration(final BooleanSupplier shutdownRequested) {
         if (startupMigrationWarningShown) {
-            return;
+            return !shutdownRequested.getAsBoolean();
         }
         startupMigrationWarningShown = true;
         LOGGER.warn("===================== ! ALERT ! =====================");
@@ -75,14 +92,26 @@ public final class WorldFolderMigration {
         if (DISABLE_MIGRATION_DELAY) {
             LOGGER.warn("Migration delay disabled by system property.");
         } else {
-            try {
-                Thread.sleep(30_000L);
-            } catch (final InterruptedException ex) {
-                Thread.currentThread().interrupt();
-                throw new RuntimeException("Interrupted while waiting before startup world migration", ex);
+            final long deadline = System.nanoTime() + 30_000_000_000L;
+            while (!shutdownRequested.getAsBoolean()) {
+                final long remainingNanos = deadline - System.nanoTime();
+                if (remainingNanos <= 0L) {
+                    break;
+                }
+                try {
+                    Thread.sleep(Math.min(250L, Math.max(1L, remainingNanos / 1_000_000L)));
+                } catch (final InterruptedException ex) {
+                    Thread.currentThread().interrupt();
+                    throw new RuntimeException("Interrupted while waiting before startup world migration", ex);
+                }
             }
         }
+        if (shutdownRequested.getAsBoolean()) {
+            LOGGER.warn("Startup world migration cancelled because server shutdown was requested.");
+            return false;
+        }
         LOGGER.info("Continuing with startup world migration.");
+        return true;
     }
 
     private static MigrationMode classifyStartupMigration(final WorldMigrationContext context) {
