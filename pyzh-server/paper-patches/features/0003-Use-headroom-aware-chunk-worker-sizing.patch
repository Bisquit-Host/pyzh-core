From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: TurboVadim <yolkin.vadim@gmail.com>
Date: Mon, 20 Jul 2026 09:41:46 +0300
Subject: [PATCH] Use headroom-aware chunk worker sizing

Reserve half of the available processors for the tick thread, plugins, networking, and JVM services while retaining C2ME's heap-based concurrency guard. Lower worker priority so background chunk work yields to latency-sensitive server work.

Heap model adapted from C2ME-fabric commit 87988c515a9e1c80a487baaa39490dfc78189c2a, licensed under MIT.

diff --git a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
index ee857c23afb54763db452981e7ed1f0eb0d2d2a0..9482f80fbdd52a4ef39bb0741e991403a1b7231c 100644
--- a/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
+++ b/src/main/java/ca/spottedleaf/moonrise/common/util/MoonriseCommon.java
@@ -1,7 +1,6 @@
 package ca.spottedleaf.moonrise.common.util;
 
 import ca.spottedleaf.concurrentutil.executor.thread.BalancedPrioritisedThreadPool;
-import ca.spottedleaf.concurrentutil.numa.OSNuma;
 import ca.spottedleaf.moonrise.common.PlatformHooks;
 import com.mojang.logging.LogUtils;
 import org.slf4j.Logger;
@@ -29,6 +28,7 @@ public final class MoonriseCommon {
                 final Thread thread = new Thread(run, PlatformHooks.get().getBrand() + " Common Worker #" + this.idGenerator.getAndIncrement());
 
                 thread.setDaemon(true);
+                thread.setPriority(Thread.NORM_PRIORITY - 1); // Pyzh - preserve main-thread responsiveness during parallel chunk work
                 thread.setUncaughtExceptionHandler(new Thread.UncaughtExceptionHandler() {
                     @Override
                     public void uncaughtException(final Thread thread, final Throwable throwable) {
@@ -44,12 +44,9 @@ public final class MoonriseCommon {
     public static final BalancedPrioritisedThreadPool.OrderedStreamGroup SERVER_GROUP = MoonriseCommon.WORKER_POOL.createOrderedStreamGroup();
 
     public static void adjustWorkerThreads(final int configWorkerThreads, final int configIoThreads) {
-        int defaultWorkerThreads = OSNuma.getNativeInstance().getTotalCores()  / 2;
-        if (defaultWorkerThreads <= 4) {
-            defaultWorkerThreads = defaultWorkerThreads <= 3 ? 1 : 2;
-        } else {
-            defaultWorkerThreads = defaultWorkerThreads / 2;
-        }
+        // Pyzh start - resource-aware chunk worker sizing
+        int defaultWorkerThreads = ru.turbovadim.pyzh.chunk.ChunkSystemWorkerSizing.defaultWorkerThreads();
+        // Pyzh end - resource-aware chunk worker sizing
         defaultWorkerThreads = Integer.getInteger(PlatformHooks.get().getBrand() + ".WorkerThreadCount", Integer.valueOf(defaultWorkerThreads));
 
         int workerThreads = configWorkerThreads;
